            <div class="li-mini-notice @(hasAdsAccess ? "ready" : "")">
                <h4>@(hasAdsAccess ? "✅ Conversions access is ready" : "🔒 Conversions")</h4>
                <p>@(hasAdsAccess ? "Stream conversion events to LinkedIn Ads." : "The rw_conversions / r_ads permissions weren't granted.")</p>
