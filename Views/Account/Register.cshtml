@model SocialMediaPanel.Models.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register – Go2MarketSocialMediaPanel";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --green: #4BB543;
            --green-d: #3a9e34;
            --teal: #1DA1A1;
            --dark: #0f1923;
            --card: #1b2c3e;
            --border: rgba(255,255,255,0.08);
            --text: #e2eaf3;
            --muted: #7a95b0;
            --accent: #56cfb2;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--dark);
            color: var(--text);
            min-height: 100vh;
            display: flex;
        }

        .panel-left {
            flex: 1;
            background: linear-gradient(145deg, #0d2137 0%, #0f2a3f 50%, #0d1e2e 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 48px 56px;
            position: relative;
            overflow: hidden;
        }

            .panel-left::before {
                content: '';
                position: absolute;
                top: -120px;
                left: -120px;
                width: 480px;
                height: 480px;
                background: radial-gradient(circle, rgba(75,181,67,0.12) 0%, transparent 70%);
                pointer-events: none;
            }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1;
        }

        .logo-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, var(--green), var(--teal));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-icon svg {
                width: 22px;
                height: 22px;
                fill: white;
            }

        .logo-text {
            font-family: 'Sora', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .hero-content {
            z-index: 1;
        }

            .hero-content h1 {
                font-family: 'Sora', sans-serif;
                font-size: 38px;
                font-weight: 700;
                line-height: 1.15;
                color: #fff;
                margin-bottom: 20px;
            }

                .hero-content h1 span {
                    background: linear-gradient(90deg, var(--green), var(--accent));
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }

            .hero-content p {
                font-size: 15px;
                color: var(--muted);
                line-height: 1.7;
                max-width: 380px;
            }

        .steps {
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 1;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 18px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .step-num {
            width: 26px;
            height: 26px;
            background: linear-gradient(135deg, var(--green), var(--teal));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .step span {
            font-size: 13px;
            color: #a8c0d6;
        }

        /* RIGHT */
        .panel-right {
            width: 540px;
            background: var(--card);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 48px 48px;
            border-left: 1px solid var(--border);
            overflow-y: auto;
        }

        .form-header {
            margin-bottom: 28px;
        }

            .form-header h2 {
                font-family: 'Sora', sans-serif;
                font-size: 24px;
                font-weight: 700;
                color: #fff;
                margin-bottom: 6px;
            }

            .form-header p {
                font-size: 13px;
                color: var(--muted);
            }

                .form-header p a {
                    color: var(--accent);
                    text-decoration: none;
                    font-weight: 500;
                }

                    .form-header p a:hover {
                        text-decoration: underline;
                    }

        .section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            margin: 20px 0 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-title::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .optional-tag {
            font-size: 10px;
            background: rgba(86,207,178,0.15);
            color: var(--accent);
            border-radius: 4px;
            padding: 2px 6px;
            font-weight: 500;
            letter-spacing: 0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-group {
            margin-bottom: 16px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                font-size: 12px;
                font-weight: 500;
                color: #a8c0d6;
                margin-bottom: 6px;
                letter-spacing: 0.3px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap svg {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                width: 15px;
                height: 15px;
                stroke: var(--muted);
                pointer-events: none;
            }

        .form-control {
            width: 100%;
            padding: 11px 12px 11px 38px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--text);
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            transition: border-color 0.2s, background 0.2s;
            outline: none;
        }

            .form-control:focus {
                border-color: var(--green);
                background: rgba(75,181,67,0.05);
            }

            .form-control::placeholder {
                color: var(--muted);
            }

        select.form-control {
            cursor: pointer;
        }

            select.form-control option {
                background: var(--dark2, #172230);
            }

        textarea.form-control {
            resize: none;
            height: 80px;
            padding-top: 10px;
        }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, var(--green), var(--green-d));
            border: none;
            border-radius: 10px;
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            letter-spacing: 0.3px;
            margin-top: 20px;
            transition: opacity 0.2s, transform 0.15s;
            box-shadow: 0 4px 20px rgba(75,181,67,0.3);
        }

            .btn-submit:hover {
                opacity: 0.92;
                transform: translateY(-1px);
            }

        .validation-error {
            color: #ff6b6b;
            font-size: 11px;
            margin-top: 4px;
        }

        .alert-error {
            background: rgba(255,107,107,0.1);
            border: 1px solid rgba(255,107,107,0.3);
            border-radius: 8px;
            padding: 12px 16px;
            color: #ff8a8a;
            font-size: 13px;
            margin-bottom: 16px;
        }

        @@media (max-width: 900px) {
            .panel-left {
                display: none;
            }

            .panel-right {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- LEFT PANEL -->
    <div class="panel-left">
        <div class="logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" /></svg>
            </div>
            <span class="logo-text">sproutsocial</span>
        </div>

        <div class="hero-content">
            <h1>Start your<br /><span>30-day free</span><br />trial today.</h1>
            <p>Join thousands of teams who use SproutApp to manage, publish, and grow their social media presence.</p>
        </div>

        <div class="steps">
            <div class="step">
                <span class="step-num">1</span>
                <span>Create your free account in minutes</span>
            </div>
            <div class="step">
                <span class="step-num">2</span>
                <span>Connect your social media profiles</span>
            </div>
            <div class="step">
                <span class="step-num">3</span>
                <span>Start publishing, listening & growing</span>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="panel-right">
        <div class="form-header">
            <h2>Create your account ✨</h2>
            <p>Already have an account? <a asp-action="Login">Sign in</a></p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <!-- REQUIRED FIELDS -->
            <div class="section-title">Account Details</div>

            <div class="form-group">
                <label>Full Name *</label>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input asp-for="Name" class="form-control" placeholder="Sandeep Kumar" />
                </div>
                <span asp-validation-for="Name" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label>Email Address *</label>
                <div class="input-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2" />
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                    </svg>
                    <input asp-for="Email" class="form-control" placeholder="you@company.com" />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Password *</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="Password" class="form-control" placeholder="Min 6 chars" />
                    </div>
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label>Confirm Password *</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
                </div>
            </div>

            <!-- OPTIONAL COMPANY FIELDS -->
            <div class="section-title">
                Company Info
                <span class="optional-tag">Optional</span>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Company Name</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        <input asp-for="CompanyName" class="form-control" placeholder="Acme Corp" />
                    </div>
                    <span asp-validation-for="CompanyName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label>Company Size</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        <select asp-for="CompanySize" class="form-control">
                            <option value="">Select size</option>
                            <option value="1-10">1–10</option>
                            <option value="11-50">11–50</option>
                            <option value="51-200">51–200</option>
                            <option value="201-500">201–500</option>
                            <option value="500+">500+</option>
                        </select>
                    </div>
                    <span asp-validation-for="CompanySize" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label>Company Type</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                        </svg>
                        <select asp-for="CompanyType" class="form-control">
                            <option value="">Select type</option>
                            <option value="Agency">Agency</option>
                            <option value="Brand">Brand</option>
                            <option value="Startup">Startup</option>
                            <option value="Enterprise">Enterprise</option>
                            <option value="Freelancer">Freelancer</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <span asp-validation-for="CompanyType" class="validation-error"></span>
                </div>

                <div class="form-group full">
                    <label>Company Address</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="top:16px;transform:none">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                            <circle cx="12" cy="10" r="3" />
                        </svg>
                        <textarea asp-for="CompanyAddress" class="form-control" placeholder="123 Main St, City, State, Country"></textarea>
                    </div>
                    <span asp-validation-for="CompanyAddress" class="validation-error"></span>
                </div>
            </div>

            <button type="submit" class="btn-submit">Create Free Account →</button>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
