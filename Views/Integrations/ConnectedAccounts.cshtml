@using SocialMediaPanel.Controllers
@using SocialMediaPanel.Services
@{
    ViewData["Title"] = "Connected Accounts";
    var fbPages = ViewBag.FbPages as List<FacebookPageEntity> ?? new();
    var igAccounts = ViewBag.IgAccounts as List<InstagramAccount> ?? new();
    string? activeFbId = ViewBag.ActiveFbId;
    string? activeIgId = ViewBag.ActiveIgId;
}

<style>
    .ca-header { margin-bottom: 20px; }
    .ca-title { font-family:'Sora',sans-serif; font-size:18px; font-weight:700; color:var(--text); }
    .ca-subtitle { font-size:13px; color:var(--muted); margin-top:2px; }

    .ca-section { background:var(--surface, #fff); border:1px solid var(--border); border-radius:14px; padding:20px 22px; margin-bottom:18px; }
    .ca-sec-title { font-family:'Sora',sans-serif; font-size:14px; font-weight:700; color:var(--text); margin-bottom:14px; display:flex; align-items:center; gap:8px; }

    .ca-row { display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border:1px solid var(--border); border-radius:10px; margin-bottom:10px; gap:10px; }
    .ca-row:last-child { margin-bottom:0; }
    .ca-row-left { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .ca-name { font-size:13.5px; font-weight:600; color:var(--text); }
    .ca-meta { font-size:11.5px; color:var(--muted); }
    .ca-row-right { display:flex; align-items:center; gap:8px; flex-shrink:0; }
    .ca-badge { font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:20px; white-space:nowrap; }
    .ca-badge.active { background:rgba(75,181,67,.12); color:var(--accent, var(--green)); }
    .ca-disconnect-btn { font-size:10.5px; font-weight:700; padding:3px 9px; border-radius:20px; white-space:nowrap; border:1px solid #f5c2c2; background:#fff5f5; color:#d33; cursor:pointer; }
    .ca-disconnect-btn:hover { background:#ffe8e8; }
    .ca-empty { text-align:center; padding:24px 0; color:var(--muted); font-size:13px; }
</style>

<div class="ca-header">
    <div class="ca-title">Connected Accounts</div>
    <div class="ca-subtitle">These are all the Facebook Pages and Instagram accounts connected to your login. Whichever one is "Active" is used by default in Compose/Posts/Inbox.</div>
</div>

<div class="ca-section">
    <div class="ca-sec-title">📘 Facebook Pages (@fbPages.Count)</div>
    @if (fbPages.Count == 0)
    {
        <div class="ca-empty">No Facebook Page connected. Connect one from the <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>.</div>
    }
    else
    {
        foreach (var p in fbPages)
        {
            var isActive = p.page_id == activeFbId;
            <div class="ca-row">
                <div class="ca-row-left">
                    <div class="ca-name">@p.page_name</div>
                    <div class="ca-meta">Page ID: @p.page_id &middot; Connected: @p.created_at.ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
                <div class="ca-row-right">
                    @if (isActive)
                    {
                        <span class="ca-badge active">● Active</span>
                    }
                    else
                    {
                        <button class="ca-badge" style="border:1px solid var(--border);background:var(--surface, #fff);cursor:pointer" onclick="setActive('facebook','@p.page_id')">Make Active</button>
                    }
                    <button class="ca-disconnect-btn" onclick="disconnectAccount('facebook','@p.page_id','@p.page_name')">Disconnect</button>
                </div>
            </div>
        }
    }
</div>

<div class="ca-section">
    <div class="ca-sec-title">📸 Instagram Accounts (@igAccounts.Count)</div>
    @if (igAccounts.Count == 0)
    {
        <div class="ca-empty">No Instagram account connected. Connect one from the <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>.</div>
    }
    else
    {
        foreach (var a in igAccounts)
        {
            var isActive = a.InstagramUserId == activeIgId;
            <div class="ca-row">
                <div class="ca-row-left">
                    <div class="ca-name">@@@a.Username</div>
                    <div class="ca-meta">
                        Account ID: @a.InstagramUserId &middot; Connected: @a.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                        @if (!string.IsNullOrEmpty(a.NativeAccessToken))
                        {
                            <span>&middot; Direct (no Facebook Page)</span>
                        }
                    </div>
                </div>
                <div class="ca-row-right">
                    @if (isActive)
                    {
                        <span class="ca-badge active">● Active</span>
                    }
                    else
                    {
                        <button class="ca-badge" style="border:1px solid var(--border);background:var(--surface, #fff);cursor:pointer" onclick="setActive('instagram','@a.InstagramUserId')">Make Active</button>
                    }
                    <button class="ca-disconnect-btn" onclick="disconnectAccount('instagram','@a.InstagramUserId','@@@a.Username')">Disconnect</button>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function setActive(platform, pageId) {
            var fd = new FormData();
            fd.append('platform', platform);
            fd.append('pageId', pageId);
            fetch('/Integrations/SetActivePage', { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => { if (d.success) location.reload(); else alert(d.message || 'Failed'); });
        }

        function disconnectAccount(platform, pageId, label) {
            if (!confirm('Disconnect ' + label + '? This removes it from the panel — posts/comments/messages already synced stay in place, but new activity will stop until you reconnect.')) return;
            var fd = new FormData();
            fd.append('pageId', pageId);
            fetch('/Integrations/Disconnect/' + platform, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(r => r.json())
                .then(d => { if (d.success) location.reload(); else alert(d.message || 'Disconnect failed'); })
                .catch(() => alert('Disconnect failed — network error.'));
        }
    </script>
}
