@using SocialMediaPanel.Models
@{
    ViewData["Title"] = "Smart Inbox";
    ViewData["PageTitle"] = "Smart Inbox";
}

<style>
    .inbox-shell * {
        box-sizing: border-box;
    }

    .inbox-shell {
        display: flex;
        height: calc(100vh - 58px);
        margin: -28px;
        overflow: hidden;
        font-family: 'DM Sans', sans-serif;
    }

    /* ══ LEFT NAV ══ */
    .inbox-nav {
        width: 200px;
        min-width: 200px;
        background: #fff;
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        flex-shrink: 0;
    }

    .inbox-nav-header {
        padding: 14px 18px 10px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .06em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--border);
    }

    .inbox-nav-item {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 10px 18px !important;
        font-size: 13px !important;
        color: var(--muted) !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        text-decoration: none !important;
        border-left: 3px solid transparent !important;
        transition: background .12s, color .12s !important;
    }

        .inbox-nav-item:hover {
            background: #f4f5f7 !important;
            color: var(--text) !important;
        }

        .inbox-nav-item.active {
            background: rgba(75,181,67,.07) !important;
            border-left-color: var(--green) !important;
            color: var(--green) !important;
            font-weight: 600 !important;
        }

    .inbox-nav-group {
        padding: 14px 18px 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .05em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .inbox-nav-group svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    .inbox-nav-badge {
        font-size: 10px;
        font-weight: 700;
        background: var(--green);
        color: #fff;
        border-radius: 10px;
        padding: 1px 6px;
        min-width: 18px;
        text-align: center;
        line-height: 1.6;
    }

    /* ══ CENTER — inbox list ══ */
    .inbox-center {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f2f3f5;
        transition: width .25s ease, min-width .25s ease;
        flex: 1;
        min-width: 0;
    }
    /* when detail panel is open, list shrinks to 40%; otherwise it fills
       the full width instead of leaving dead space where the closed
       detail panel would be */
    .inbox-shell.detail-open .inbox-center {
        width: 40%;
        min-width: 320px;
        flex: none;
    }

    .inbox-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 16px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        gap: 8px;
        flex-wrap: wrap;
    }

        .inbox-topbar h2 {
            font-family: 'Sora', sans-serif;
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
            white-space: nowrap;
            margin: 0;
        }

    .inbox-topbar-right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .inbox-search {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        border-radius: 9px;
        width: 180px;
        transition: border-color .15s, width .25s;
    }

    .inbox-shell.detail-open .inbox-search {
        width: 130px;
    }

    .inbox-search:focus-within {
        border-color: var(--green);
        background: #fff;
    }

    .inbox-search svg {
        width: 12px;
        height: 12px;
        stroke: var(--muted);
        fill: none;
        flex-shrink: 0;
    }

    .inbox-search input {
        border: none;
        outline: none;
        background: none;
        font-size: 12px;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        width: 100%;
    }

        .inbox-search input::placeholder {
            color: var(--muted);
        }

    .tb-pill {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 11px;
        color: var(--text);
        font-weight: 500;
        white-space: nowrap;
    }

        .tb-pill svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    .tb-btn-filter-wrap {
        position: relative;
        display: inline-flex;
    }

    .tb-btn-filter {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s;
    }

        .tb-btn-filter:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .tb-btn-filter svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
        }

    .filter-active-dot {
        display: none;
        position: absolute;
        top: -5px;
        right: -5px;
        width: 16px;
        height: 16px;
        background: var(--green);
        color: #fff;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

        .filter-active-dot.show {
            display: flex;
        }

    .inbox-sortbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 16px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sort-dd {
        padding: 4px 8px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 11px;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        cursor: pointer;
        outline: none;
    }

    .reload-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s, color .15s;
    }

        .reload-btn:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .reload-btn svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
        }

        .reload-btn.spinning svg {
            animation: spin360 .7s linear infinite;
        }

    @@keyframes spin360 {
        to {
            transform: rotate(360deg);
        }
    }

    .inbox-feed {
        flex: 1;
        overflow-y: auto;
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* ══ MESSAGE CARD ══ */
    .msg-card {
        background: #fff;
        border: 1px solid #e2e4e9;
        border-radius: 10px;
        width: 100%;
        overflow: visible;
        cursor: pointer;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
        transition: box-shadow .15s, transform .1s, border-color .15s;
        flex-shrink: 0;
    }

        .msg-card:hover {
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            transform: translateY(-1px);
        }

        .msg-card.active-card {
            border-color: var(--green);
            box-shadow: 0 0 0 2px rgba(75,181,67,.15);
        }

    .msg-card-top {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 11px 14px 7px;
        background: #fff;
        border-radius: 10px 10px 0 0;
    }

    .msg-ava-wrap {
        position: relative;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
    }

    .msg-ava {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        line-height: 1;
        user-select: none;
    }

    .msg-plat-dot {
        position: absolute;
        bottom: -1px;
        right: -1px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        border: 1.5px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .msg-plat-dot svg {
            width: 9px;
            height: 9px;
            display: block;
        }

    .msg-meta {
        flex: 1;
        min-width: 0;
    }

    .msg-name-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
        line-height: 1.3;
        margin-bottom: 2px;
    }

    .msg-profile-link {
        font-size: 12px;
        font-weight: 700;
        color: #1a1a2e;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

        .msg-profile-link:hover {
            color: var(--green);
        }

        .msg-profile-link svg {
            width: 9px;
            height: 9px;
            stroke: #aaa;
            fill: none;
            flex-shrink: 0;
        }

    .msg-type-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        line-height: 1.4;
        white-space: nowrap;
    }

    .tbadge-comment {
        background: #edfbe9;
        color: #2e7d25;
    }

    .tbadge-message {
        background: #e3f8f8;
        color: #0e7a7a;
    }

    .tbadge-mention {
        background: #fde8f3;
        color: #c0166d;
    }

    .tbadge-live {
        background: #fff0e6;
        color: #c4511a;
    }

    .msg-replied-badge {
        font-size: 9px;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        background: #e3f8f8;
        color: #0e7a7a;
    }

    .msg-done-badge {
        font-size: 9px;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
        background: #edfbe9;
        color: #2e7d25;
    }

    .msg-ctx {
        font-size: 10px;
        color: #8a8fa8;
        line-height: 1.4;
        display: flex;
        align-items: center;
        gap: 3px;
        flex-wrap: wrap;
    }

        .msg-ctx svg {
            width: 10px;
            height: 10px;
            flex-shrink: 0;
        }

        .msg-ctx strong {
            color: #444;
            font-weight: 600;
        }

        .msg-ctx a {
            color: var(--green);
            text-decoration: none;
            font-weight: 600;
        }

            .msg-ctx a:hover {
                text-decoration: underline;
            }

    .msg-top-right {
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
        margin-left: auto;
        padding-left: 6px;
    }

    .msg-time {
        font-size: 10px;
        color: #aaa;
        white-space: nowrap;
    }

    .msg-checkbox {
        width: 14px;
        height: 14px;
        accent-color: var(--green);
        cursor: pointer;
    }

    .msg-body-text {
        padding: 2px 14px 11px 59px;
        font-size: 12px;
        color: #2a2a3a;
        line-height: 1.6;
        background: #fff;
        word-break: break-word;
        min-height: 24px;
    }

    .msg-body-empty {
        color: #aaa;
        font-style: italic;
        font-size: 11px;
    }

    .msg-actions-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 6px 12px;
        background: #fafbfc;
        border-top: 1px solid #f0f1f4;
        border-radius: 0 0 10px 10px;
    }

    .msg-act-l {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .msg-act-r {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .btn-thread {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        background: #fff;
        border: 1px solid #e2e4e9;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        color: #333;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s, color .15s;
        line-height: 1;
    }

        .btn-thread:hover, .btn-thread.active {
            border-color: var(--green);
            color: var(--green);
            background: rgba(75,181,67,.05);
        }

        .btn-thread svg {
            width: 11px;
            height: 11px;
            stroke: currentColor;
            fill: none;
        }

    .act-ico {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: none;
        border: 1px solid transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .12s, border-color .12s;
        padding: 0;
    }

        .act-ico:hover {
            background: #f0f1f3;
            border-color: #e2e4e9;
        }

        .act-ico svg {
            width: 13px;
            height: 13px;
            stroke: #aaa;
            fill: none;
        }

        .act-ico.liked svg {
            stroke: #e91e8c;
            fill: #e91e8c;
        }

        .act-ico.is-done svg {
            stroke: var(--green);
        }

        .act-ico.is-saved svg {
            stroke: #f39c12;
            fill: #f39c12;
        }

    .msg-in-response {
        padding: 5px 14px 5px 59px;
        font-size: 10px;
        color: #aaa;
        border-top: 1px solid #f0f1f4;
        background: #f8f9fb;
        border-radius: 0 0 10px 10px;
        font-style: italic;
    }

    .inbox-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        text-align: center;
    }

        .inbox-empty svg {
            width: 44px;
            height: 44px;
            stroke: #ccc;
            fill: none;
            margin-bottom: 12px;
        }

        .inbox-empty h4 {
            font-size: 14px;
            font-weight: 700;
            color: #333;
            margin: 0 0 5px;
        }

        .inbox-empty p {
            font-size: 12px;
            color: #aaa;
            line-height: 1.6;
            margin: 0;
        }

    /* ══ RIGHT DETAIL PANEL ══ */
    .inbox-detail {
        display: none;
        flex-direction: column;
        overflow: hidden;
        background: #fff;
        border-left: 1px solid var(--border);
        width: 47%;
        flex-shrink: 0;
        animation: slideIn .2s ease;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateX(16px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .inbox-shell.detail-open .inbox-detail {
        display: flex;
    }

    /* Detail header */
    .detail-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: #fff;
        flex-shrink: 0;
    }

    .detail-close-btn {
        width: 28px;
        height: 28px;
        background: #f4f5f7;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        color: #888;
        transition: background .12s;
        flex-shrink: 0;
    }

        .detail-close-btn:hover {
            background: #eee;
        }

    .detail-head-info {
        flex: 1;
        min-width: 0;
    }

    .detail-head-name {
        font-size: 14px;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .detail-head-sub {
        font-size: 11px;
        color: #aaa;
        margin-top: 1px;
    }

    .detail-head-right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .detail-platform-badge {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        color: #555;
        background: #fafbfc;
    }

    /* Detail body — two rows: post preview + replies */
    .detail-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* Post preview card */
    .detail-post-preview {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: #f8f9fb;
        flex-shrink: 0;
        max-height: 35%;
        overflow-y: auto;
    }

    .dpp-label {
        font-size: 10px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .dpp-card {
        background: #fff;
        border: 1px solid #e2e4e9;
        border-radius: 10px;
        overflow: hidden;
    }

    .dpp-img {
        width: 100%;
        max-height: 160px;
        object-fit: cover;
        display: block;
        background: #f0f1f4;
    }

    .dpp-img-placeholder {
        width: 100%;
        height: 100px;
        background: linear-gradient(135deg,#f0f1f4,#e2e4e9);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .dpp-img-placeholder svg {
            width: 32px;
            height: 32px;
            stroke: #ccc;
            fill: none;
        }

    .dpp-content {
        padding: 10px 14px;
    }

    .dpp-post-title {
        font-size: 13px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 4px;
    }

    .dpp-post-body {
        font-size: 12px;
        color: #555;
        line-height: 1.55;
    }

    .dpp-post-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
        font-size: 10px;
        color: #aaa;
        padding-top: 8px;
        border-top: 1px solid #f0f1f4;
    }

        .dpp-post-meta a {
            color: var(--green);
            text-decoration: none;
            font-weight: 600;
        }

            .dpp-post-meta a:hover {
                text-decoration: underline;
            }

    .dpp-loading {
        text-align: center;
        padding: 20px;
        font-size: 12px;
        color: #aaa;
        font-style: italic;
    }

    /* Original comment highlight */
    .detail-original-comment {
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
        background: #fffbf0;
        flex-shrink: 0;
    }

    .doc-label {
        font-size: 10px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

    .doc-row {
        display: flex;
        align-items: flex-start;
        gap: 9px;
    }

    .doc-ava {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
    }

    .doc-body {
        flex: 1;
        min-width: 0;
    }

    .doc-name {
        font-size: 12px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 2px;
    }

        .doc-name a {
            color: #1a1a2e;
            text-decoration: none;
        }

            .doc-name a:hover {
                color: var(--green);
                text-decoration: underline;
            }

    .doc-text {
        font-size: 13px;
        color: #2a2a3a;
        line-height: 1.6;
    }

    .doc-time {
        font-size: 10px;
        color: #aaa;
        margin-top: 3px;
    }

    /* Replies list */
    .detail-replies {
        flex: 1;
        overflow-y: auto;
        padding: 12px 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        background: #f9fafb;
    }

    .reply-row {
        display: flex;
        gap: 8px;
    }

        .reply-row.own {
            flex-direction: row-reverse;
        }

    .reply-ava {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 9px;
        font-weight: 700;
        color: #fff;
    }

    .reply-bubble {
        max-width: 72%;
        padding: 8px 11px;
        font-size: 12px;
        color: #2a2a3a;
        line-height: 1.5;
        background: #fff;
        border: 1px solid #e2e4e9;
        border-radius: 4px 10px 10px 10px;
    }

    .reply-row.own .reply-bubble {
        background: #edfbe9;
        border-color: #c8eebc;
        border-radius: 10px 4px 10px 10px;
    }

    .reply-bubble.failed {
        background: #fff5f5;
        border-color: #fcc;
    }

    .reply-name {
        font-size: 10px;
        font-weight: 700;
        color: #555;
        margin-bottom: 2px;
    }

    .reply-text {
        word-break: break-word;
    }

    .reply-time {
        font-size: 9px;
