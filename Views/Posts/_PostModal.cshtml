@model SocialMediaPanel.ViewModels.PostDetailViewModel

@{
    var displayDate = Model.CreatedTime.HasValue
        ? Model.CreatedTime.Value.ToLocalTime()
        : Model.UpdatedAt.ToLocalTime();

    // Click distribution percentages — ek hi @{} block mein
    int total = Model.TotalEngagement;
    int likePct = total > 0 ? (int)((double)Model.LikesCount / total * 100) : 0;
    int commentPct = total > 0 ? (int)((double)Model.CommentsCount / total * 100) : 0;
    int sharePct = total > 0 ? (int)((double)Model.SharesCount / total * 100) : 0;
}

<style>
    .pm-brand-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 14px;
    }

    .pm-brand-av {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg,var(--green),var(--teal));
        color: #fff;
        font-size: 18px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        position: relative;
    }

    .pm-plat-dot {
        position: absolute;
        bottom: -2px;
        right: -3px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pm-plat-dot.facebook {
            background: #1877F2;
        }

        .pm-plat-dot.twitter {
            background: #000;
        }

        .pm-plat-dot.linkedin {
            background: #0A66C2;
        }

        .pm-plat-dot.instagram {
            background: linear-gradient(135deg,#f09433,#bc1888);
        }

        .pm-plat-dot svg {
            width: 10px;
            height: 10px;
        }

    .pm-brand-name {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--text);
    }

    .pm-via {
        font-size: 12px;
        color: var(--muted);
        font-weight: 400;
        margin-left: 4px;
    }

    .pm-post-date {
        font-size: 11.5px;
        color: var(--muted);
        margin-top: 3px;
    }

    .pm-permalink {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        color: var(--green);
        text-decoration: none;
        margin-top: 2px;
    }

        .pm-permalink:hover {
            text-decoration: underline;
        }

        .pm-permalink svg {
            width: 10px;
            height: 10px;
            stroke: currentColor;
            fill: none;
        }

    .pm-content-text {
        font-size: 13.5px;
        line-height: 1.65;
        color: var(--text);
        margin-bottom: 14px;
        white-space: pre-line;
    }

    .pm-img {
        width: 100%;
        border-radius: 10px;
        display: block;
        margin-bottom: 12px;
    }

    .pm-no-img {
        height: 100px;
        border-radius: 10px;
        background: rgba(75,181,67,.05);
        border: 1px dashed rgba(75,181,67,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        color: var(--muted);
    }

        .pm-no-img svg {
            width: 28px;
            height: 28px;
            stroke: currentColor;
            fill: none;
            opacity: .4;
        }

    .pm-actions {
        display: flex;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        margin-bottom: 12px;
    }

    .pm-action-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px;
        background: none;
        border: none;
        font-family: 'DM Sans',sans-serif;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all .15s;
    }

        .pm-action-btn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
        }

        .pm-action-btn:hover {
            background: rgba(75,181,67,.06);
            color: var(--green-d);
        }

    .pm-comment-box {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 6px 12px;
    }

    .pm-comment-av {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg,var(--green),var(--teal));
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .pm-comment-input {
        flex: 1;
        border: none;
        background: transparent;
        font-family: 'DM Sans',sans-serif;
        font-size: 12.5px;
        color: var(--muted);
        outline: none;
    }

    .pm-comment-ic {
        background: none;
        border: none;
        color: var(--muted);
        cursor: pointer;
        padding: 2px;
        display: flex;
        align-items: center;
        transition: color .13s;
    }

        .pm-comment-ic:hover {
            color: var(--green);
        }

        .pm-comment-ic svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
        }

    .pm-comments-list {
        margin-top: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .pm-comment-item {
        display: flex;
        gap: 10px;
        padding: 10px 12px;
        background: var(--bg);
        border-radius: 10px;
    }

    .pm-cmt-av {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        flex-shrink: 0;
        background: linear-gradient(135deg,var(--green),var(--teal));
        color: #fff;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pm-cmt-name {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text);
    }

    .pm-cmt-msg {
        font-size: 12.5px;
        color: var(--text);
        margin-top: 2px;
        line-height: 1.5;
    }

    .pm-cmt-time {
        font-size: 11px;
        color: var(--muted);
        margin-top: 3px;
    }

    /* Stats */
    .pm-stats-section {
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
    }

        .pm-stats-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

    .pm-stats-title {
        font-size: 10px;
        font-weight: 800;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .09em;
        margin-bottom: 14px;
    }

    .pm-stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px 8px;
    }

    .pm-stats-grid-3 {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px 8px;
    }

    .pm-stat-lbl {
        font-size: 9px;
        font-weight: 800;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 5px;
        line-height: 1.3;
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .pm-stat-lbl svg {
            width: 10px;
            height: 10px;
            stroke: var(--muted);
            fill: none;
            flex-shrink: 0;
        }

    .pm-stat-val {
        font-size: 22px;
        font-weight: 800;
        color: var(--text);
        font-family: 'Sora',sans-serif;
        line-height: 1;
    }

        .pm-stat-val.zero {
            color: var(--muted);
        }

        .pm-stat-val.hi {
            color: var(--green);
        }

    .pm-rate-row {
        margin-top: 12px;
    }

    .pm-rate-val {
        font-size: 20px;
        font-weight: 800;
        font-family: 'Sora',sans-serif;
        margin-top: 4px;
    }

        .pm-rate-val.neg {
            color: #dc3545;
        }

        .pm-rate-val.pos {
            color: var(--green);
        }

    .pm-no-data {
        text-align: center;
        padding: 24px 0 8px;
        color: var(--muted);
        opacity: .5;
    }

        .pm-no-data svg {
            width: 36px;
            height: 36px;
            stroke: currentColor;
            fill: none;
            display: block;
            margin: 0 auto 8px;
        }

        .pm-no-data p {
            font-size: 12px;
        }

    .pm-dist-row {
        margin-bottom: 8px;
    }

    .pm-dist-label {
        display: flex;
        justify-content: space-between;
        font-size: 11px;
        color: var(--muted);
        margin-bottom: 3px;
    }

    .pm-dist-bar {
        height: 6px;
        background: var(--border);
        border-radius: 4px;
        overflow: hidden;
    }

    .pm-dist-fill {
        height: 100%;
        background: linear-gradient(90deg,var(--green),var(--teal));
        border-radius: 4px;
    }
</style>

<!-- ══ POST DETAILS TAB ══════════════════════════════════════════ -->
<div class="pm-pane active" id="pm-details">

    <div class="pm-brand-row">
        <div class="pm-brand-av">
            S
            <div class="pm-plat-dot @Model.Platform">
                @switch (Model.Platform)
                {
                    case "facebook":
                        <svg viewBox="0 0 24 24" fill="white" width="10" height="10">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                        </svg>
                        break;
                    case "twitter":
                        <svg viewBox="0 0 24 24" fill="white" width="9" height="9">
                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231z" />
                        </svg>
                        break;
                    case "linkedin":
                        <svg viewBox="0 0 24 24" fill="white" width="10" height="10">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7H10v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" />
                            <circle cx="4" cy="4" r="2" />
                        </svg>
                        break;
                    default:
                        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" width="10" height="10">
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                        </svg>
                        break;
                }
            </div>
        </div>
        <div>
            <div class="pm-brand-name">
                Shinestar Marketing
                <span class="pm-via">via SocialMediaPanel</span>
            </div>
            <div class="pm-post-date">@displayDate.ToString("dd MMM yyyy hh:mm tt")</div>
            @if (!string.IsNullOrEmpty(Model.PermalinkUrl))
            {
                <a class="pm-permalink" href="@Model.PermalinkUrl" target="_blank">
                    View on @Model.Platform
                    <svg viewBox="0 0 24 24" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                </a>
            }
        </div>
    </div>

    <div class="pm-content-text">
        @(string.IsNullOrEmpty(Model.Message) ? "(No text content)" : Model.Message)
    </div>

    @if (!string.IsNullOrEmpty(Model.FullPicture))
    {
        <img class="pm-img" src="@Model.FullPicture" alt="Post image" />
    }
    else
    {
        <div class="pm-no-img">
            <svg viewBox="0 0 24 24" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
            </svg>
        </div>
    }

    <div class="pm-actions">
        <button class="pm-action-btn">
            <svg viewBox="0 0 24 24" stroke-width="2">
                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z" />
                <path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
            </svg>
            Like
        </button>
        <button class="pm-action-btn">
            <svg viewBox="0 0 24 24" stroke-width="2">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            Comment
        </button>
    </div>

    <div class="pm-comment-box">
        <div class="pm-comment-av">S</div>
        <input class="pm-comment-input" type="text"
               placeholder="Typos are costly. Read before you comment!" />
        <button class="pm-comment-ic">
            <svg viewBox="0 0 24 24" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                <line x1="9" y1="9" x2="9.01" y2="9" />
                <line x1="15" y1="9" x2="15.01" y2="9" />
            </svg>
        </button>
        <button class="pm-comment-ic">
            <svg viewBox="0 0 24 24" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="8.5" cy="8.5" r="1.5" />
                <polyline points="21 15 16 10 5 21" />
            </svg>
        </button>
    </div>

    @if (Model.Comments != null && Model.Comments.Any())
    {
        <div class="pm-comments-list">
            @foreach (var c in Model.Comments)
            {
                <div class="pm-comment-item">
                    <div class="pm-cmt-av">
                        @(c.SenderName?.Length > 0 ? c.SenderName[0].ToString().ToUpper() : "?")
                    </div>
                    <div>
                        <div class="pm-cmt-name">@c.SenderName</div>
                        <div class="pm-cmt-msg">@c.Message</div>
                        <div class="pm-cmt-time">
                            @(c.CommentTime.HasValue
                                                ? c.CommentTime.Value.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                                                : "")
                </div>
            </div>
        </div>
                }
        </div>
    }
</div>

<!-- ══ POST STATS TAB ════════════════════════════════════════════ -->
<div class="pm-pane" id="pm-stats">

    <!-- REACTIONS -->
    <div class="pm-stats-section">
        <div class="pm-stats-title">REACTIONS</div>
        <div class="pm-stats-grid">
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">👍 LIKES</div>
                <div class="pm-stat-val @(Model.LikesCount == 0 ? "zero" : "")">@Model.LikesCount</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">❤️ LOVE</div>
                <div class="pm-stat-val zero">0</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">😲 WOW</div>
                <div class="pm-stat-val zero">0</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">😄 HAHA</div>
                <div class="pm-stat-val zero">0</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">😠 ANGRY</div>
                <div class="pm-stat-val zero">0</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">😢 SORRY</div>
                <div class="pm-stat-val zero">0</div>
            </div>
            <div class="pm-stat-cell" style="grid-column:span 2;padding-top:10px;border-top:1px solid var(--border);">
                <div class="pm-stat-lbl">TOTAL REACTIONS</div>
                <div class="pm-stat-val @(Model.LikesCount == 0 ? "zero" : "hi")">@Model.LikesCount</div>
            </div>
        </div>
    </div>

    <!-- ENGAGEMENTS -->
    <div class="pm-stats-section">
        <div class="pm-stats-title">ENGAGEMENTS</div>
        <div class="pm-stats-grid">
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    COMMENTS
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.CommentsCount == 0 ? "zero" : "")">@Model.CommentsCount</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    SHARES
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.SharesCount == 0 ? "zero" : "")">@Model.SharesCount</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    SAVES
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.SavesCount == 0 ? "zero" : "")">@Model.SavesCount</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    TOTAL ENGAGEMENT
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.TotalEngagement == 0 ? "zero" : "hi")">@Model.TotalEngagement</div>
            </div>
        </div>
        <div class="pm-rate-row">
            <div class="pm-stat-lbl">
                ENGAGEMENT RATE
                <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
            </div>
            <div class="pm-rate-val @(Model.EngagementRate == 0 ? "neg" : "pos")">
                @Model.EngagementRate.ToString("0.0")%
            </div>
        </div>
    </div>

    <!-- CLICK DISTRIBUTION -->
    <div class="pm-stats-section">
        <div class="pm-stats-title">
            CLICK DISTRIBUTION
            <svg viewBox="0 0 24 24" stroke-width="2" style="width:10px;height:10px;stroke:var(--muted);fill:none;vertical-align:middle;margin-left:2px">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
        </div>
        @if (Model.TotalEngagement == 0)
        {
            <div class="pm-no-data">
                <svg viewBox="0 0 24 24" stroke-width="1.2">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
                <p>There is no data available currently for this report.</p>
            </div>
        }
        else
        {
            <div class="pm-dist-row">
                <div class="pm-dist-label"><span>Likes</span><span>@Model.LikesCount</span></div>
                <div class="pm-dist-bar"><div class="pm-dist-fill" style="width:@(likePct)%"></div></div>
            </div>
            <div class="pm-dist-row">
                <div class="pm-dist-label"><span>Comments</span><span>@Model.CommentsCount</span></div>
                <div class="pm-dist-bar"><div class="pm-dist-fill" style="width:@(commentPct)%"></div></div>
            </div>
            <div class="pm-dist-row">
                <div class="pm-dist-label"><span>Shares</span><span>@Model.SharesCount</span></div>
                <div class="pm-dist-bar"><div class="pm-dist-fill" style="width:@(sharePct)%"></div></div>
            </div>
        }
    </div>

    <!-- IMPRESSIONS -->
    <div class="pm-stats-section">
        <div class="pm-stats-title">IMPRESSIONS</div>
        <div class="pm-stats-grid-3">
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    UNIQUE IMPRESSIONS
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.Impressions == 0 ? "zero" : "hi")">@Model.Impressions</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    REACH
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.Reach == 0 ? "zero" : "")">@Model.Reach</div>
            </div>
            <div class="pm-stat-cell">
                <div class="pm-stat-lbl">
                    SAVES
                    <svg viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <div class="pm-stat-val @(Model.SavesCount == 0 ? "zero" : "")">@Model.SavesCount</div>
            </div>
        </div>
    </div>

</div>
