@{
    var userName = ViewBag.UserName as string ?? "User";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var companyName = ViewBag.CompanyName as string ?? "Your Workspace";

    string FirstChar(string s) => s.Length > 0 ? s[0].ToString().ToUpper() : "?";

    // Highlight active nav item based on current controller/action
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string ctrl, string act = "") =>
        controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(act) || action.Equals(act, StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SocialMediaPanel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SocialMediaPanel.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>

    <!-- ═══════════════════════════════════════════════
         LEFT SIDEBAR
    ═══════════════════════════════════════════════ -->
    <aside class="sidebar-left">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" />
                </svg>
            </div>
            <span class="logo-text">SocialMediaPanel</span>
        </div>

        <div class="workspace-badge">
            <div class="ws-icon">@FirstChar(companyName)</div>
            <div>
                <div class="ws-name">@companyName</div>
                <div class="ws-sub">Workspace</div>
            </div>
        </div>

        <nav class="nav">
            <a asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(IsActive("Dashboard", "Index") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <a asp-controller="Inbox" asp-action="Index"
               class="nav-item @(IsActive("Inbox") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Smart Inbox
            </a>

            <a asp-controller="Cases" asp-action="Index"
               class="nav-item @(IsActive("Cases") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
                Cases
            </a>

            <a asp-controller="Publishing" asp-action="Index"
               class="nav-item @(IsActive("Publishing") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                Publishing
            </a>

            <a asp-controller="Listening" asp-action="Index"
               class="nav-item @(IsActive("Listening") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
                </svg>
                Listening
            </a>

            <a asp-controller="Reports" asp-action="Index"
               class="nav-item @(IsActive("Reports") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
                Reports
            </a>

            <a asp-controller="People" asp-action="Index"
               class="nav-item @(IsActive("People") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                People
            </a>

            <a asp-controller="Reviews" asp-action="Index"
               class="nav-item @(IsActive("Reviews") ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
                </svg>
                Reviews
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="user-info">
                <div class="user-avatar">@FirstChar(userName)</div>
                <div>
                    <div class="user-name">@userName</div>
                    <div class="user-email" title="@userEmail">@userEmail</div>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="logout-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                Logout
            </a>
        </div>
    </aside>

    <!-- ═══════════════════════════════════════════════
         MAIN WRAPPER  (topbar + page body)
    ═══════════════════════════════════════════════ -->
    <div class="main-wrapper">

        <!-- TOP BAR -->
        <header class="topbar">
            <h1>@(ViewData["PageTitle"] as string ?? ViewData["Title"] as string ?? "Dashboard")</h1>
            <div class="topbar-right">
                <span class="trial-badge"><span>30 days</span> remaining in trial</span>
                <button class="btn-trial">✨ Trial features</button>
                <button class="btn-subscribe">Start subscription</button>
                <button class="btn-compose" title="New post">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                    </svg>
                </button>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <!-- ═══════════════════════════════════════════════
         RIGHT ICON SIDEBAR
    ═══════════════════════════════════════════════ -->
    <aside class="sidebar-right" id="sidebarRight">

        <!-- CONNECT / Integrations (triggers popup) -->
        <button class="r-icon r-icon--connect" id="connectBtn"
                title="Connect Platforms" onclick="toggleConnectPopup()">
            <svg viewBox="0 0 24 24" fill="none" stroke="#4BB543" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            <span class="r-dot"></span>
        </button>

        <div class="r-sep"></div>

        <button class="r-icon" title="Notifications">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </button>

        <button class="r-icon" title="Analytics">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
        </button>

        <button class="r-icon" title="Calendar">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </button>

        <button class="r-icon" title="Messages">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
        </button>

        <div class="r-sep"></div>

        <button class="r-icon" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33
                         1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4
                         a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15
                         a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9
                         a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68
                         a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51
                         1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9
                         a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
        </button>

        <button class="r-icon" title="Help">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </button>
    </aside>

    <!-- ═══════════════════════════════════════════════
         CONNECT PLATFORMS POPUP
    ═══════════════════════════════════════════════ -->
    <div class="popup-backdrop" id="connectBackdrop" onclick="toggleConnectPopup()"></div>

    <div class="connect-popup" id="connectPopup" role="dialog"
         aria-labelledby="popupTitle" aria-modal="true">

        <div class="popup-header">
            <div>
                <h3 id="popupTitle">Connect Platforms</h3>
                <p>Link your social accounts to get started</p>
            </div>
            <button class="popup-close" onclick="toggleConnectPopup()" aria-label="Close">&#215;</button>
        </div>

        <div class="popup-body">

            <!-- LinkedIn -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#e8f0fe;">
                    <svg viewBox="0 0 24 24" fill="#0A66C2" width="20" height="20">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136
                                 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85
                                 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065
                                 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771
                                 C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227
                                 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>LinkedIn</strong>
                    <span>Pages, profiles &amp; ads</span>
                </div>
                <button class="connect-btn" data-platform="linkedin"
                        onclick="toggleConnect(this)">
                    Connect
                </button>
            </div>

            <!-- Facebook -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#e7f0ff;">
                    <svg viewBox="0 0 24 24" fill="#1877F2" width="20" height="20">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954
                                 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669
                                 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491
                                 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385
                                 C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>Facebook</strong>
                    <span>Pages &amp; groups</span>
                </div>
                <button class="connect-btn connected" data-platform="facebook"
                        onclick="toggleConnect(this)">
                    &#10003; Connected
                </button>
            </div>

            <!-- X / Twitter -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#f0f0f0;">
                    <svg viewBox="0 0 24 24" fill="#000" width="20" height="20">
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401
                                 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161
                                 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>X (Twitter)</strong>
                    <span>Tweets &amp; analytics</span>
                </div>
                <button class="connect-btn" data-platform="twitter"
                        onclick="toggleConnect(this)">
                    Connect
                </button>
            </div>

            <!-- Instagram -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#fef0f8;">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                        <defs>
                            <linearGradient id="igGrad" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#f09433" />
                                <stop offset=".25" stop-color="#e6683c" />
                                <stop offset=".5" stop-color="#dc2743" />
                                <stop offset=".75" stop-color="#cc2366" />
                                <stop offset="1" stop-color="#bc1888" />
                            </linearGradient>
                        </defs>
                        <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igGrad)" />
                        <circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8" />
                        <circle cx="17" cy="7" r="1.2" fill="#fff" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>Instagram</strong>
                    <span>Feed, Reels &amp; Stories</span>
                </div>
                <button class="connect-btn" data-platform="instagram"
                        onclick="toggleConnect(this)">
                    Connect
                </button>
            </div>

            <!-- WhatsApp -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#e8f8f0;">
                    <svg viewBox="0 0 24 24" fill="#25D366" width="20" height="20">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15
                                 -.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463
                                 -2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606
                                 .134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371
                                 -.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51
                                 -.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04
                                 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2
                                 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118
                                 .571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413
                                 -.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0
                                 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86
                                 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122
                                 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437
                                 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05
                                 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588
                                 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683
                                 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821
                                 0 0 0-3.48-8.413z" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>WhatsApp</strong>
                    <span>Business messaging</span>
                </div>
                <button class="connect-btn" data-platform="whatsapp"
                        onclick="toggleConnect(this)">
                    Connect
                </button>
            </div>

            <!-- Gmail -->
            <div class="platform-row">
                <div class="platform-logo" style="background:#fef2f2;">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20">
                        <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12
                                 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0
                                 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455
                                 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24
                                 3.434 24 5.457z" fill="#EA4335" />
                        <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12
                                 16.64V9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24
                                 5.457z" fill="#4285F4" />
                    </svg>
                </div>
                <div class="platform-info">
                    <strong>Gmail</strong>
                    <span>Email &amp; newsletter sync</span>
                </div>
                <button class="connect-btn" data-platform="gmail"
                        onclick="toggleConnect(this)">
                    Connect
                </button>
            </div>

          
           
        </div><!-- /.popup-body -->

        <div class="popup-footer">
            <button class="btn-done" onclick="toggleConnectPopup()">Done</button>
        </div>
    </div><!-- /.connect-popup -->
    @await Html.PartialAsync("_PlatformAuthModal")

    </div>

    <!-- Layout Scripts -->
    <script>
        /* ── Sidebar connect popup ─────────────────── */
        function toggleConnectPopup() {
            var popup    = document.getElementById('connectPopup');
            var backdrop = document.getElementById('connectBackdrop');
            var open     = popup.classList.contains('visible');
            if (open) {
                popup.classList.remove('visible');
                backdrop.classList.remove('visible');
            } else {
                popup.classList.add('visible');
                backdrop.classList.add('visible');
            }
        }

        /* ── Connect button — delegates to platform modal ── */
        function toggleConnect(btn) {
            var platform = btn.dataset.platform;
            if (btn.classList.contains('connected')) {
                /* Disconnect: update button directly, no modal needed */
                if (confirm('Disconnect ' + platform + '?')) {
                    btn.classList.remove('connected');
                    btn.textContent = 'Connect';
                }
            } else {
                /* Connect: open the platform auth modal */
                if (window.PlatformAuth) {
                    PlatformAuth.open(platform);
                }
            }
        }

        /* ── Escape key closes both popups ─────────── */
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if (window.PlatformAuth && PlatformAuth.isOpen()) { PlatformAuth.close(); return; }
            var popup = document.getElementById('connectPopup');
            if (popup && popup.classList.contains('visible')) {
                popup.classList.remove('visible');
                document.getElementById('connectBackdrop').classList.remove('visible');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
