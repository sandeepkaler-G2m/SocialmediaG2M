@using Microsoft.AspNetCore.Http

@{
    var userName = ViewBag.UserName as string ?? "User";
    var userEmail = ViewBag.UserEmail as string ?? "";
    var companyName = Context.Session.GetString("CompanyName") ?? "Your Workspace";

    string FirstChar(string s) => s.Length > 0 ? s[0].ToString().ToUpper() : "?";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool IsActive(string ctrl, string act = "") =>
        controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(act) || action.Equals(act, StringComparison.OrdinalIgnoreCase));

    bool IsCtrl(string ctrl) =>
        controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – SocialMediaPanel</title>
    <link rel="icon" type="image/x-icon" href="https://go2market.in/assets/images/favicon.jpg" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --green: #4BB543;
            --green-d: #3a9e34;
            --teal: #1DA1A1;
            --bg: #f4f5f7;
            --border: #e3e6ea;
            --text: #1a2332;
            --muted: #8a97a8;
            --topbar-h: 56px;
            --navbar-h: 48px;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            display: flex;
            flex-direction: column;
        }

        /* ══ TOP HEADER BAR (like Zoho's brand bar) ═════════════════ */
        .top-header {
            height: var(--topbar-h);
            background: #1a2332; /* dark brand bar */
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            flex-shrink: 0;
            z-index: 200;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        /* Brand / workspace selector */
        .th-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .th-logo {
            width: 32px;
            height: 32px;
            background: transparent; /* remove gradient since image has its own bg */
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: hidden;
        }

            .th-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        .th-app-name {
            font-family: 'Sora', sans-serif;
            font-size: 15px;
            font-weight: 700;
            color: #fff;
        }

        .th-sep {
            width: 1px;
            height: 22px;
            background: rgba(255,255,255,.15);
            margin: 0 8px;
        }

        .th-workspace {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 10px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            cursor: pointer;
            transition: background .15s;
        }

            .th-workspace:hover {
                background: rgba(255,255,255,.14);
            }

        .th-ws-icon {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            border-radius: 5px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .th-ws-name {
            font-size: 13px;
            font-weight: 600;
            color: #fff;
        }

        .th-ws-caret {
            width: 12px;
            height: 12px;
            stroke: rgba(255,255,255,.5);
            fill: none;
        }

        /* Right side of header */
        .th-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .th-icon-btn {
            width: 34px;
            height: 34px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background .15s;
            position: relative;
        }

            .th-icon-btn:hover {
                background: rgba(255,255,255,.16);
            }

            .th-icon-btn svg {
                width: 16px;
                height: 16px;
                stroke: rgba(255,255,255,.7);
                fill: none;
            }

        /* Connect button */
        .th-connect-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: rgba(75,181,67,.2);
            border: 1px solid rgba(75,181,67,.4);
            border-radius: 8px;
            color: #6ee36d;
            font-size: 12px;
            font-weight: 600;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            transition: background .15s;
        }

            .th-connect-btn:hover {
                background: rgba(75,181,67,.32);
            }

            .th-connect-btn svg {
                width: 14px;
                height: 14px;
                stroke: currentColor;
                fill: none;
            }

        .th-connect-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--green);
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(75,181,67,.3);
        }

        /* New Post button */
        .th-new-post {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: var(--green);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
            cursor: pointer;
            transition: background .15s;
        }

            .th-new-post:hover {
                background: var(--green-d);
            }

            .th-new-post svg {
                width: 14px;
                height: 14px;
                stroke: #fff;
                fill: none;
            }

        /* User avatar */
        .th-user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--green), var(--teal));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            flex-shrink: 0;
            border: 2px solid rgba(255,255,255,.2);
            position: relative;
        }

        /* User dropdown */
        .th-user-menu {
            position: relative;
        }

        .th-user-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            width: 200px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,.16);
            z-index: 500;
            overflow: hidden;
        }

        .th-user-menu.open .th-user-dropdown {
            display: block;
        }

        .th-ud-head {
            padding: 14px 16px 10px;
            border-bottom: 1px solid var(--border);
        }

        .th-ud-name {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .th-ud-email {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .th-ud-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px 16px;
            font-size: 13px;
            color: var(--text);
            text-decoration: none;
            cursor: pointer;
            transition: background .12s;
        }

            .th-ud-item svg {
                width: 14px;
                height: 14px;
                stroke: var(--muted);
                fill: none;
            }

            .th-ud-item:hover {
                background: #f4f5f7;
            }

            .th-ud-item.danger {
                color: #dc3545;
            }

                .th-ud-item.danger svg {
                    stroke: #dc3545;
                }

        .th-ud-sep {
            height: 1px;
            background: var(--border);
        }

        /* ══ NAV TAB BAR (Zoho-style horizontal nav) ════════════════ */
        .nav-tabbar {
            height: var(--navbar-h);
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: stretch;
            padding: 0 20px;
            flex-shrink: 0;
            z-index: 100;
            box-shadow: 0 1px 4px rgba(0,0,0,.04);
            overflow-x: auto;
            scrollbar-width: none;
        }

            .nav-tabbar::-webkit-scrollbar {
                display: none;
            }

        .nav-tab {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 0 16px;
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            white-space: nowrap;
            flex-shrink: 0;
            transition: color .15s, border-color .15s;
            position: relative;
        }

            .nav-tab svg {
                width: 15px;
                height: 15px;
                stroke: currentColor;
                fill: none;
                flex-shrink: 0;
            }

            .nav-tab:hover {
                color: var(--text);
            }

            .nav-tab.active {
                color: var(--green);
                border-bottom-color: var(--green);
                font-weight: 600;
            }

                .nav-tab.active svg {
                    stroke: var(--green);
                }

        /* Badge on nav tab */
        .nav-tab-badge {
            background: #EA4335;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            border-radius: 10px;
            padding: 1px 5px;
            min-width: 18px;
            text-align: center;
        }

        /* ══ PAGE CONTENT ════════════════════════════════════════════ */
        .page-shell {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .page-content {
            flex: 1;
            overflow-y: auto;
            padding: 28px;
        }

        .page-title {
            font-family: 'Sora', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 20px;
        }

        /* ══ CONNECT POPUP ════════════════════════════════════════════ */
        .popup-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.18);
            z-index: 399;
        }

            .popup-backdrop.visible {
                display: block;
            }

        .connect-popup {
            display: none;
            position: fixed;
            top: 70px;
            right: 16px;
            width: 310px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(0,0,0,.14);
            z-index: 400;
            overflow: hidden;
            flex-direction: column;
            max-height: calc(100vh - 90px);
        }

            .connect-popup.visible {
                display: flex;
            }

        .popup-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 18px 18px 14px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

            .popup-header h3 {
                font-family: 'Sora',sans-serif;
                font-size: 15px;
                font-weight: 700;
                color: var(--text);
                margin-bottom: 3px;
            }

            .popup-header p {
                font-size: 12px;
                color: var(--muted);
            }

        .popup-close {
            background: none;
            border: none;
            cursor: pointer;
            color: var(--muted);
            font-size: 20px;
            line-height: 1;
            padding: 2px 6px;
            border-radius: 5px;
            transition: background .15s;
            flex-shrink: 0;
            margin-left: 8px;
        }

            .popup-close:hover {
                background: #f4f5f7;
                color: var(--text);
            }

        .popup-body {
            overflow-y: auto;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
        }

        .platform-row {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 11px;
            background: #fafafa;
            transition: border-color .15s,background .15s;
        }

            .platform-row:hover {
                border-color: var(--green);
                background: rgba(75,181,67,.03);
            }

        .platform-logo {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .platform-info {
            flex: 1;
            min-width: 0;
        }

            .platform-info strong {
                font-size: 12px;
                font-weight: 600;
                color: var(--text);
                display: block;
            }

            .platform-info span {
                font-size: 11px;
                color: var(--muted);
            }

        .connect-btn {
            padding: 5px 11px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 600;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
            white-space: nowrap;
            border: 1px solid rgba(75,181,67,.4);
            background: rgba(75,181,67,.08);
            color: var(--green-d);
            transition: background .15s,border-color .15s;
            flex-shrink: 0;
        }

            .connect-btn:hover {
                background: rgba(75,181,67,.18);
            }

            .connect-btn.connected {
                background: rgba(75,181,67,.12);
                border-color: var(--green);
                color: var(--green);
            }

        .popup-footer {
            padding: 12px 16px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            flex-shrink: 0;
        }

        .btn-done {
            padding: 8px 18px;
            background: linear-gradient(135deg,var(--green),var(--green-d));
            border: none;
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
        }

        /* Auth modal styles */


    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ TOP HEADER ════════════════════════════════════════════════ -->
    <header class="top-header">

        <!-- Left: Logo + workspace -->
        <div class="th-brand">
            <div class="th-logo">
                <img src="~/images/g2m_logo.png" alt="Logo" />
            </div>
            <span class="th-app-name">Go2Market</span>
            <div class="th-sep"></div>
            <div class="th-workspace">
                <div class="th-ws-icon">@FirstChar(companyName)</div>
                <span class="th-ws-name">@companyName</span>
               @*  <svg class="th-ws-caret" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <polyline points="6 9 12 15 18 9" />
                </svg> *@
            </div>
        </div>

        <!-- Right: actions + user -->
        <div class="th-right">

            <!-- Connect platforms -->
         @*    <button class="th-connect-btn" onclick="toggleConnectPopup()" title="Connect Platforms">
                <div class="th-connect-dot"></div>
                Connect
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                </svg>
            </button> *@

            <!-- New Post -->
            <a href="/Dashboard/Compose" style="text-decoration:none">
                <button class="th-new-post">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                    New Post
                </button>
            </a>

            <!-- Notifications -->
            <div class="th-user-menu" id="notifMenu">
                <button class="th-icon-btn" title="Notifications" onclick="toggleNotifMenu()" style="position:relative">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <span id="notifBadge" class="nav-tab-badge" style="display:none;position:absolute;top:-4px;right:-4px;">0</span>
                </button>
                <div class="th-user-dropdown" id="notifDropdown" style="width:260px">
                    <div class="th-ud-head"><div class="th-ud-name">Notifications</div></div>
                    <div id="notifList" style="max-height:260px;overflow-y:auto;">
                        <div class="th-ud-item" style="color:var(--muted);cursor:default">Loading…</div>
                    </div>
                </div>
            </div>

            <!-- Settings -->
          @*   <button class="th-icon-btn" title="Settings">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </button> *@

            <!-- User avatar + dropdown -->
            <div class="th-user-menu" id="userMenu">
                <div class="th-user-avatar" onclick="toggleUserMenu()">@FirstChar(userName)</div>
                <div class="th-user-dropdown">
                    <div class="th-ud-head">
                        <div class="th-ud-name">@userName</div>
                        <div class="th-ud-email" title="@userEmail">@userEmail</div>
                    </div>
                    <a asp-controller="Account" asp-action="AuditLog" class="th-ud-item">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                            <line x1="16" y1="13" x2="8" y2="13" />
                            <line x1="16" y1="17" x2="8" y2="17" />
                        </svg>
                        Audit Log
                    </a>
                    <a asp-controller="Account" asp-action="Logout" class="th-ud-item danger">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                        Logout
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ══ NAV TAB BAR ═══════════════════════════════════════════════ -->
    <nav class="nav-tabbar">

        <a asp-controller="Dashboard" asp-action="Index"
           class="nav-tab @(IsActive("Dashboard", "Index") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
            </svg>
            Home
        </a>

        <a asp-controller="Inbox" asp-action="Index"
           class="nav-tab @(IsCtrl("Inbox") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            </svg>
            Inbox
        </a>

        <a asp-controller="Dashboard" asp-action="Leads"
           class="nav-tab @(IsCtrl("Leads") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
            Leads
        </a>

              <a asp-controller="Posts" asp-action="Index"
           class="nav-tab @(IsCtrl("Posts") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6" />
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" />
            </svg>
            Posts
        </a>
        <a asp-controller="Calendar" asp-action="Index"
           class="nav-tab @(IsCtrl("Calendar") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            Calendar
        </a>
        <a asp-controller="LinkedIn" asp-action="Index"
           class="nav-tab @(IsCtrl("LinkedIn") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
            </svg>
            LinkedIn
        </a>
        <a asp-controller="Gmail" asp-action="Inbox"
           class="nav-tab @(IsCtrl("Gmail") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                <polyline points="22,6 12,13 2,6" />
            </svg>
            Gmail
        </a>

        <a asp-controller="Twitter" asp-action="Index"
           class="nav-tab @(IsCtrl("Twitter") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" fill="none">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor" stroke="none" />
            </svg>
            Twitter
        </a>

  

        <a asp-controller="Ads" asp-action="Index"
           class="nav-tab @(IsCtrl("Ads") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <path d="M3 3v18h18" />
                <path d="M18.7 8l-5.1 5.2-4-4L3 15.9" />
            </svg>
            Ads
        </a>

        <a asp-controller="Reports" asp-action="Index"
           class="nav-tab @(IsCtrl("Reports") ? "active" : "")">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">
                <line x1="18" y1="20" x2="18" y2="10" />
                <line x1="12" y1="20" x2="12" y2="4" />
                <line x1="6" y1="20" x2="6" y2="14" />
            </svg>
            Reports
        </a>

    </nav>

    <!-- ══ PAGE SHELL ═════════════════════════════════════════════════ -->
    <div class="page-shell">
        <main class="page-content">
            @RenderBody()
        </main>
    </div>

    <!-- ══ CONNECT PLATFORMS POPUP ═══════════════════════════════════ -->
    <div class="popup-backdrop" id="connectBackdrop" onclick="toggleConnectPopup()"></div>
    <div class="connect-popup" id="connectPopup" role="dialog" aria-modal="true">
        <div class="popup-header">
            <div>
                <h3>Connect Platforms</h3>
                <p>Link your social accounts to get started</p>
            </div>
            <button class="popup-close" onclick="toggleConnectPopup()">&#215;</button>
        </div>
        <div class="popup-body">
            <div class="platform-row">
                <div class="platform-logo" style="background:#e8f0fe;">
                    <svg viewBox="0 0 24 24" fill="#0A66C2" width="20" height="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                </div>
                <div class="platform-info"><strong>LinkedIn</strong><span>Pages, profiles &amp; ads</span></div>
                <button class="connect-btn" data-platform="linkedin" onclick="toggleConnect(this)">Connect</button>
            </div>
            <div class="platform-row">
                <div class="platform-logo" style="background:#e7f0ff;">
                    <svg viewBox="0 0 24 24" fill="#1877F2" width="20" height="20"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
                </div>
                <div class="platform-info"><strong>Facebook</strong><span>Pages &amp; groups</span></div>
                <button class="connect-btn connected" data-platform="facebook" onclick="toggleConnect(this)">&#10003; Connected</button>
            </div>
            <div class="platform-row">
                <div class="platform-logo" style="background:#f0f0f0;">
                    <svg viewBox="0 0 24 24" fill="#000" width="20" height="20"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                </div>
                <div class="platform-info"><strong>X (Twitter)</strong><span>Tweets &amp; analytics</span></div>
                <button class="connect-btn" data-platform="twitter" onclick="toggleConnect(this)">Connect</button>
            </div>
            <div class="platform-row">
                <div class="platform-logo" style="background:#fef0f8;">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20"><defs><linearGradient id="igL" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433" /><stop offset=".5" stop-color="#dc2743" /><stop offset="1" stop-color="#bc1888" /></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igL)" /><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8" /><circle cx="17" cy="7" r="1.2" fill="#fff" /></svg>
                </div>
                <div class="platform-info"><strong>Instagram</strong><span>Feed, Reels &amp; Stories</span></div>
                <button class="connect-btn" data-platform="instagram" onclick="toggleConnect(this)">Connect</button>
            </div>
            <div class="platform-row">
                <div class="platform-logo" style="background:#e8f8f0;">
                    <svg viewBox="0 0 24 24" fill="#25D366" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" /></svg>
                </div>
                <div class="platform-info"><strong>WhatsApp</strong><span>Business messaging</span></div>
                <button class="connect-btn" data-platform="whatsapp" onclick="toggleConnect(this)">Connect</button>
            </div>
            <div class="platform-row">
                <div class="platform-logo" style="background:#fef2f2;">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.548l8.073-6.053C21.69 2.28 24 3.434 24 5.457z" fill="#EA4335" /></svg>
                </div>
                <div class="platform-info"><strong>Gmail</strong><span>Email &amp; newsletter sync</span></div>
                <button class="connect-btn" data-platform="gmail" onclick="toggleConnect(this)">Connect</button>
            </div>
        </div>
        <div class="popup-footer">
            <button class="btn-done" onclick="toggleConnectPopup()">Done</button>
        </div>
    </div>

    @await Html.PartialAsync("_PlatformAuthModal")

    <script>
        function toggleConnectPopup() {
            var popup    = document.getElementById('connectPopup');
            var backdrop = document.getElementById('connectBackdrop');
            var open     = popup.classList.contains('visible');
            popup.classList.toggle('visible', !open);
            backdrop.classList.toggle('visible', !open);
        }

        function toggleConnect(btn) {
            var platform = btn.dataset.platform;
            if (btn.classList.contains('connected')) {
                if (confirm('Disconnect ' + platform + '?')) {
                    btn.classList.remove('connected');
                    btn.textContent = 'Connect';
                }
            } else {
                if (window.PlatformAuth) PlatformAuth.open(platform);
            }
        }

        function toggleUserMenu() {
            document.getElementById('userMenu').classList.toggle('open');
        }

        // ── Notifications (Category A, phase 7) ─────────────────────────
        function loadNotifCount() {
            fetch('/api/notifications/count', { credentials: 'same-origin' })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.success) return;
                    var badge = document.getElementById('notifBadge');
                    if (d.count > 0) {
                        badge.textContent = d.count > 99 ? '99+' : d.count;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                    var list = document.getElementById('notifList');
                    if (list) {
                        var rows = [];
                        if (d.newLeads > 0) rows.push('<div class="th-ud-item" style="cursor:default">🎯 ' + d.newLeads + ' new lead(s) — check the Leads tab</div>');
                        if (d.newComments > 0) rows.push('<div class="th-ud-item" style="cursor:default">💬 ' + d.newComments + ' new comment(s)</div>');
                        if (d.newMessages > 0) rows.push('<div class="th-ud-item" style="cursor:default">✉️ ' + d.newMessages + ' new message(s) — check Inbox</div>');
                        list.innerHTML = rows.length ? rows.join('') : '<div class="th-ud-item" style="color:var(--muted);cursor:default">You\'re all caught up.</div>';
                    }
                })
                .catch(function () {});
        }

        function toggleNotifMenu() {
            var menu = document.getElementById('notifMenu');
            var opening = !menu.classList.contains('open');
            menu.classList.toggle('open');
            if (opening) {
                setTimeout(function () {
                    fetch('/api/notifications/mark-seen', { method: 'POST', credentials: 'same-origin' })
                        .then(function () { document.getElementById('notifBadge').style.display = 'none'; });
                }, 2500); // give the user a moment to actually see the list before clearing the badge
            }
        }

        loadNotifCount();
        setInterval(loadNotifCount, 30000);

        document.addEventListener('click', function(e) {
            var menu = document.getElementById('userMenu');
            if (menu && !menu.contains(e.target)) menu.classList.remove('open');
            var notifMenu = document.getElementById('notifMenu');
            if (notifMenu && !notifMenu.contains(e.target)) notifMenu.classList.remove('open');
        });

        document.addEventListener('keydown', function(e) {
            if (e.key !== 'Escape') return;
            if (window.PlatformAuth && PlatformAuth.isOpen()) { PlatformAuth.close(); return; }
            var popup = document.getElementById('connectPopup');
            if (popup && popup.classList.contains('visible')) {
                popup.classList.remove('visible');
                document.getElementById('connectBackdrop').classList.remove('visible');
            }
            document.getElementById('userMenu')?.classList.remove('open');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
