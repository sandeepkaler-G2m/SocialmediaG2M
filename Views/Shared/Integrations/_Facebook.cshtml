@{
    Layout = null;
    var oauthUrl  = ViewData["OAuthUrl"]          as string ?? "#";
    var oauthErr  = ViewData["OAuthError"]         as string;
    var isReconn  = (bool)(ViewData["IsReconnecting"]  ?? false);
    var reconName = ViewData["ConnectedPageName"]  as string;

    var perms = new[]
    {
        new { Icon = "📄", Label = "Manage Pages",      Scope = "pages_manage_posts",    Desc = "Post and schedule content on your Facebook Pages" },
        new { Icon = "📊", Label = "Read Insights",     Scope = "pages_read_engagement", Desc = "Access reach, impressions, and engagement data"   },
        new { Icon = "💬", Label = "Moderate Comments", Scope = "pages_manage_comments", Desc = "Reply to, hide, or delete page comments"           },
        new { Icon = "📣", Label = "Ads Management",    Scope = "ads_management",        Desc = "Optionally boost posts from the panel"             },
    };
}
<style>
    .fb-btn {
        display:flex;align-items:center;justify-content:center;gap:10px;
        width:100%;padding:12px 18px;
        background:#1877F2;border:none;border-radius:10px;
        color:#fff;font-size:14px;font-weight:700;
        font-family:'DM Sans',sans-serif;cursor:pointer;
        text-decoration:none;transition:background .15s;
    }
    .fb-btn:hover { background:#1464d2;color:#fff;text-decoration:none; }
    .fb-btn svg   { width:20px;height:20px;flex-shrink:0; }
    .fb-btn-outline {
        display:flex;align-items:center;justify-content:center;gap:8px;
        width:100%;padding:11px 18px;
        background:#fff;border:1.5px solid #1877F2;border-radius:10px;
        color:#1877F2;font-size:13px;font-weight:700;
        font-family:'DM Sans',sans-serif;cursor:pointer;
        transition:background .15s;
    }
    .fb-btn-outline:hover { background:#f0f5ff; }
    .fb-divider   { display:flex;align-items:center;gap:12px;margin:16px 0;font-size:12px;color:#aaa; }
    .fb-divider::before,.fb-divider::after { content:'';flex:1;height:1px;background:#e3e6ea; }
    .fb-lock {
        display:flex;align-items:center;gap:7px;font-size:11px;color:#8a97a8;
        background:#f8f9fb;border:1px solid #e3e6ea;border-radius:8px;
        padding:9px 12px;margin-top:12px;
    }
    .fb-lock svg { width:13px;height:13px;stroke:#8a97a8;fill:none;flex-shrink:0; }
    .fb-warn { background:#fff8e1;border:1px solid #ffe082;border-radius:9px;
        padding:10px 14px;font-size:12px;color:#7a6000;margin-bottom:16px; }
    .fb-err  { background:#fff0f0;border:1px solid #ffcdd2;border-radius:9px;
        padding:10px 14px;font-size:12px;color:#c62828;margin-bottom:16px; }

    /* Step 2 */
    .fb-perms { display:flex;flex-direction:column;gap:8px;margin-bottom:16px; }
    .fb-perm  { display:flex;align-items:center;gap:12px;padding:10px 14px;
        background:#f8f9fb;border:1px solid #e3e6ea;border-radius:10px; }
    .fb-perm-ico { width:32px;height:32px;border-radius:8px;background:rgba(24,119,242,.10);
        display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0; }
    .fb-perm strong { display:block;font-size:12px;font-weight:600;color:#1a2332; }
    .fb-perm span   { font-size:11px;color:#8a97a8; }
    .fb-scope { margin-left:auto;font-size:10px;font-family:monospace;color:#8a97a8;
        background:#f0f0f0;padding:2px 6px;border-radius:4px;white-space:nowrap;flex-shrink:0; }
    .fb-perms-note { font-size:11px;color:#8a97a8;text-align:center;margin-top:4px; }

    /* Step 3 */
    .fb-ok  { display:flex;flex-direction:column;align-items:center;text-align:center;padding:8px 0 12px; }
    .fb-ok-ico { width:70px;height:70px;border-radius:50%;background:rgba(24,119,242,.10);
        display:flex;align-items:center;justify-content:center;font-size:34px;margin-bottom:16px; }
    .fb-ok h3 { font-family:'Sora',sans-serif;font-size:18px;font-weight:700;color:#1a2332;margin-bottom:8px; }
    .fb-ok-page { display:inline-block;background:#e7f0ff;color:#1877F2;border-radius:6px;
        padding:3px 10px;font-size:13px;font-weight:600;margin-bottom:14px; }
    .fb-ok p  { font-size:13px;color:#8a97a8;line-height:1.6;margin-bottom:22px; }
    .fb-ok-btn { padding:11px 32px;background:#1877F2;border:none;border-radius:10px;
        color:#fff;font-size:13px;font-weight:700;font-family:'DM Sans',sans-serif;cursor:pointer; }
    .fb-ok-btn:hover { background:#1464d2; }
</style>

<div id="fb1">
    @if (isReconn && reconName != null)
    {
        <div class="fb-warn">⚠️ Reconnecting <strong>@reconName</strong> — replaces existing token.</div>
    }
    @if (oauthErr != null)
    {
        <div class="fb-err">❌ @oauthErr</div>
    }

    <p style="font-size:13px;color:#8a97a8;line-height:1.6;margin-bottom:20px;">
        Connect your Facebook Page to SocialMediaPanel to publish posts,
        track engagement, and manage comments — all in one place.
    </p>

    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:#1a2332;">
            <span style="font-size:18px;">📅</span> Schedule and publish posts to your Pages
        </div>
        <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:#1a2332;">
            <span style="font-size:18px;">📊</span> View reach, impressions and engagement
        </div>
        <div style="display:flex;align-items:center;gap:10px;font-size:13px;color:#1a2332;">
            <span style="font-size:18px;">💬</span> Monitor and reply to comments
        </div>
    </div>
</div>

<div id="fb2" style="display:none">
    <p style="font-size:13px;color:#8a97a8;line-height:1.6;margin-bottom:14px;">
        SocialMediaPanel will request these permissions from your Facebook account.
        You can remove any access later from <strong style="color:#1a2332">Facebook App Settings</strong>.
    </p>

    <div class="fb-perms">
        @foreach (var p in perms)
        {
            <div class="fb-perm">
                <div class="fb-perm-ico">@p.Icon</div>
                <div>
                    <strong>@p.Label</strong>
                    <span>@p.Desc</span>
                </div>
                <span class="fb-scope">@p.Scope</span>
            </div>
        }
    </div>

    <a class="fb-btn" href="@oauthUrl" id="fbOauthBtn">
        <svg viewBox="0 0 24 24" fill="white">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388
                     10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007
                     1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83
                     c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796
                     v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Authorise with Facebook
    </a>

    <div class="fb-divider">secure OAuth 2.0</div>

    <div class="fb-lock">
        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Your credentials are never stored. You authorise directly on Facebook's servers.
    </div>
</div>

<div id="fb3" style="display:none">
    <div class="fb-ok">
        <div class="fb-ok-ico">🎉</div>
        <h3>Facebook Connected!</h3>
        <div class="fb-ok-page" id="fbPageNameBadge"></div>
        <p>
            Your Facebook Page is now linked to SocialMediaPanel.<br>
            Posts, comments and insights will sync automatically.
        </p>
        <button class="fb-ok-btn" onclick="PlatformAuth.close()">Back to Dashboard</button>
    </div>
</div>

<script>
(function () {

    window._fbShowSuccess = function (pageName) {
        var badge = document.getElementById('fbPageNameBadge');
        if (badge) badge.textContent = pageName || 'your page';
        _show(3);
    };

    function _show(n) {
        document.getElementById('fb1').style.display = n === 1 ? '' : 'none';
        document.getElementById('fb2').style.display = n === 2 ? '' : 'none';
        document.getElementById('fb3').style.display = n === 3 ? '' : 'none';

        if (window.PlatformAuth) PlatformAuth._setStep(n);

        var footer  = document.getElementById('pamFooter');
        var nextBtn = document.getElementById('pamNextBtn');
        var label   = document.getElementById('pamNextLabel');
        if (!footer) return;

        if (n === 1) {
            footer.style.display = '';
            if (label)   label.textContent = 'Review Permissions';
            if (nextBtn) nextBtn.onclick   = function () { _show(2); };
        } else if (n === 2) {
            footer.style.display = 'none';
            _wireOAuthBtn();
        } else {
            footer.style.display = 'none';
        }
    }

    function _wireOAuthBtn() {
        var btn  = document.getElementById('fbOauthBtn');
        if (!btn) return;
        var href = btn.getAttribute('href') || '';

        if (href.indexOf('facebook.com') === -1) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var sideBtn = document.querySelector('.connect-btn[data-platform="facebook"]');
                if (sideBtn) { sideBtn.classList.add('connected'); sideBtn.textContent = '\u2713 Connected'; }
                window._fbShowSuccess('Your Facebook Page');
            });
        } else {
            btn.addEventListener('click', function () {
                btn.style.opacity      = '0.7';
                btn.style.pointerEvents = 'none';
                btn.innerHTML          = '<span>Redirecting to Facebook\u2026</span>';
            });
        }
    }

    _show(1);
})();
</script>
