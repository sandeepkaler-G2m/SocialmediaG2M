@*
    _PlatformAuthModal.cshtml  –  Modal Shell  (Partial View)
    ----------------------------------------------------------
    Rendered ONCE in _Layout.cshtml:
        @await Html.PartialAsync("_PlatformAuthModal")

    This file owns:
      • Backdrop overlay
      • Modal card frame (banner, step dots, content area, footer)

    Platform-specific content is loaded via AJAX into #pamModalContent:
        GET /Integrations/Modal/facebook  → _Facebook.cshtml
        GET /Integrations/Modal/linkedin  → _LinkedIn.cshtml  (when built)
        ... etc.

    Public JS API:  window.PlatformAuth
        .open("facebook")   open + load content
        .close()            close + reset
        .isOpen()           boolean
        ._setStep(n)        called by platform partial to sync step dots
*@
<style>
    .pam-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.50);
        z-index: 500;
        align-items: center;
        justify-content: center;
    }

        .pam-backdrop.open {
            display: flex;
        }

    .pam-modal {
        background: #fff;
        border-radius: 20px;
        width: 460px;
        max-width: calc(100vw - 24px);
        max-height: calc(100vh - 40px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 28px 72px rgba(0,0,0,.24);
        animation: pamIn .18s ease;
    }

    @@keyframes pamIn {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .pam-banner {
        height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        flex-shrink: 0;
        background: #e3e6ea;
        transition: background .2s;
    }

    .pam-banner-logo {
        width: 56px;
        height: 56px;
        background: #fff;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 18px rgba(0,0,0,.16);
    }

        .pam-banner-logo svg {
            width: 30px;
            height: 30px;
        }

    .pam-close-btn {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 30px;
        height: 30px;
        background: rgba(255,255,255,.22);
        border: none;
        border-radius: 50%;
        color: #fff;
        font-size: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s;
    }

        .pam-close-btn:hover {
            background: rgba(255,255,255,.40);
        }

    .pam-steps {
        display: flex;
        align-items: center;
        padding: 16px 28px 0;
        flex-shrink: 0;
    }

    .pam-step {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .pam-dot {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #e3e6ea;
        background: #f4f5f7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: #8a97a8;
        transition: all .2s;
        z-index: 1;
    }

        .pam-dot.active {
            background: #fff;
            border-color: var(--pam-accent,#4BB543);
            color: var(--pam-accent,#4BB543);
        }

        .pam-dot.done {
            background: var(--pam-accent,#4BB543);
            border-color: var(--pam-accent,#4BB543);
            color: #fff;
        }

    .pam-step-label {
        font-size: 10px;
        color: #8a97a8;
    }

    .pam-line {
        flex: 1;
        height: 2px;
        background: #e3e6ea;
        margin-top: -14px;
        transition: background .2s;
    }

        .pam-line.done {
            background: var(--pam-accent,#4BB543);
        }

    .pam-content {
        flex: 1;
        overflow-y: auto;
        padding: 16px 28px 8px;
        min-height: 120px;
    }

    .pam-loading {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 8px 0;
    }

    .pam-skel {
        background: #f0f2f4;
        border-radius: 8px;
        height: 16px;
        animation: pamSkel 1.2s ease-in-out infinite;
    }

        .pam-skel.tall {
            height: 48px;
        }

        .pam-skel.short {
            width: 60%;
        }

    @@keyframes pamSkel {
        0%, 100% {
            opacity: 1
        }

        50% {
            opacity: .45
        }
    }

    .pam-load-error {
        text-align: center;
        padding: 20px 0;
        font-size: 13px;
        color: #c62828;
    }

        .pam-load-error button {
            margin-top: 10px;
            padding: 7px 16px;
            background: none;
            border: 1px solid #e3e6ea;
            border-radius: 7px;
            font-size: 12px;
            cursor: pointer;
            color: #8a97a8;
        }

    .pam-footer {
        padding: 14px 28px 22px;
        display: flex;
        gap: 10px;
        flex-shrink: 0;
        border-top: 1px solid #e3e6ea;
    }

    .pam-btn-cancel {
        flex: 1;
        padding: 10px;
        background: #f4f5f7;
        border: 1px solid #e3e6ea;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        font-family: 'DM Sans',sans-serif;
        color: #8a97a8;
        cursor: pointer;
        transition: background .15s;
    }

        .pam-btn-cancel:hover {
            background: #eaecef;
        }

    .pam-btn-next {
        flex: 2;
        padding: 10px;
        border: none;
        border-radius: 9px;
        background: var(--pam-accent,#4BB543);
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: opacity .15s;
    }

        .pam-btn-next:hover {
            opacity: .88;
        }

        .pam-btn-next:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    #pamSpinner {
        display: none;
        width: 16px;
        height: 16px;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: pamSpin .7s linear infinite;
    }

    @@keyframes pamSpin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="pam-backdrop" id="pamBackdrop">
    <div class="pam-modal" id="pamModal">

        <div class="pam-banner" id="pamBanner">
            <div class="pam-banner-logo" id="pamBannerLogo"></div>
            <button class="pam-close-btn" onclick="PlatformAuth.close()">&#215;</button>
        </div>

        <div class="pam-steps">
            <div class="pam-step">
                <div class="pam-dot active" id="pamDot1">1</div>
                <div class="pam-step-label">Authorise</div>
            </div>
            <div class="pam-line" id="pamLine1"></div>
            <div class="pam-step">
                <div class="pam-dot" id="pamDot2">2</div>
                <div class="pam-step-label">Permissions</div>
            </div>
            <div class="pam-line" id="pamLine2"></div>
            <div class="pam-step">
                <div class="pam-dot" id="pamDot3">3</div>
                <div class="pam-step-label">Done</div>
            </div>
        </div>

        <!-- Platform partial HTML injected here via AJAX -->
        <div class="pam-content" id="pamModalContent">
            <div class="pam-loading">
                <div class="pam-skel short"></div>
                <div class="pam-skel"></div>
                <div class="pam-skel tall"></div>
                <div class="pam-skel"></div>
                <div class="pam-skel short"></div>
            </div>
        </div>

        <div class="pam-footer" id="pamFooter" style="display:none">
            <button class="pam-btn-cancel" onclick="PlatformAuth.close()">Cancel</button>
            <button class="pam-btn-next" id="pamNextBtn">
                <span id="pamNextLabel">Continue</span>
                <span id="pamSpinner"></span>
            </button>
        </div>

    </div>
</div>

<script>
    (function () {
        'use strict';

        /* Banner visuals only — no business logic */
        var BANNERS = {
            facebook:  { color: '#1877F2', logoBg: '#e7f0ff', svg: '<svg viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>' },
            linkedin:  { color: '#0A66C2', logoBg: '#e8f0fe', svg: '<svg viewBox="0 0 24 24" fill="#0A66C2"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>' },
            twitter:   { color: '#000000', logoBg: '#f0f0f0', svg: '<svg viewBox="0 0 24 24" fill="#000000"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>' },
            instagram: { color: '#E1306C', logoBg: '#fef0f8', svg: '<svg viewBox="0 0 24 24" fill="none"><defs><linearGradient id="igSH" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433"/><stop offset=".5" stop-color="#dc2743"/><stop offset="1" stop-color="#bc1888"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igSH)"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8"/><circle cx="17" cy="7" r="1.2" fill="#fff"/></svg>' },
            whatsapp:  { color: '#25D366', logoBg: '#e8f8f0', svg: '<svg viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>' },
            gmail:     { color: '#EA4335', logoBg: '#fef2f2', svg: '<svg viewBox="0 0 24 24" fill="none"><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L12 9.548l8.073-6.053C21.69 2.28 24 3.434 24 5.457z" fill="#EA4335"/><path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64V9.548l8.073-6.053C21.69 2.28 24 3.434 24 5.457z" fill="#4285F4"/></svg>' },
            youtube:   { color: '#FF0000', logoBg: '#fff0f0', svg: '<svg viewBox="0 0 24 24" fill="#FF0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12z"/></svg>' },
            tiktok:    { color: '#010101', logoBg: '#f0f0f0', svg: '<svg viewBox="0 0 24 24" fill="#010101"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>' }
        };

        /* ════════════════════════════════════════════════════
           PUBLIC API
        ════════════════════════════════════════════════════ */
        window.PlatformAuth = {

            open: function (platform) {
                var b = BANNERS[platform] || { color: '#8a97a8', logoBg: '#f4f5f7', svg: '' };
                document.getElementById('pamBanner').style.background         = b.color;
                document.getElementById('pamBannerLogo').style.background     = b.logoBg || '#fff';
                document.getElementById('pamBannerLogo').innerHTML            = b.svg;
                document.getElementById('pamModal').style.setProperty('--pam-accent', b.color);
                document.getElementById('pamFooter').style.display            = 'none';
                this._setStep(1);
                document.getElementById('pamBackdrop').classList.add('open');
                _loadContent(platform);
            },

            openSuccess: function (platform, pageName) {
                var b = BANNERS[platform] || { color: '#4BB543', logoBg: '#f4f5f7', svg: '' };
                document.getElementById('pamBanner').style.background         = b.color;
                document.getElementById('pamBannerLogo').style.background     = b.logoBg || '#fff';
                document.getElementById('pamBannerLogo').innerHTML            = b.svg;
                document.getElementById('pamModal').style.setProperty('--pam-accent', b.color);
                document.getElementById('pamFooter').style.display            = 'none';
                this._setStep(3);
                document.getElementById('pamBackdrop').classList.add('open');
                _loadContent(platform, function () {
                    if (typeof window._fbShowSuccess === 'function') {
                        window._fbShowSuccess(pageName);
                    }
                    var sideBtn = document.querySelector('.connect-btn[data-platform="' + platform + '"]');
                    if (sideBtn) {
                        sideBtn.classList.add('connected');
                        sideBtn.textContent = '\u2713 Connected';
                    }
                });
            },

            close: function () {
                document.getElementById('pamBackdrop').classList.remove('open');
                setTimeout(function () {
                    document.getElementById('pamModalContent').innerHTML = _skeleton();
                    document.getElementById('pamFooter').style.display  = 'none';
                    window.PlatformAuth._setStep(1);
                }, 200);
            },

            isOpen: function () {
                return document.getElementById('pamBackdrop').classList.contains('open');
            },

            _setStep: function (n) {
                for (var i = 1; i <= 3; i++) {
                    var d = document.getElementById('pamDot' + i);
                    if (i < n)        { d.className = 'pam-dot done';   d.textContent = '\u2713'; }
                    else if (i === n) { d.className = 'pam-dot active'; d.textContent = '' + i; }
                    else              { d.className = 'pam-dot';        d.textContent = '' + i; }
                }
                for (var j = 1; j <= 2; j++) {
                    document.getElementById('pamLine' + j).className = 'pam-line' + (j < n ? ' done' : '');
                }
            },

            /* Called by layout.js toggleConnect to sync the sidebar button state */
            setConnected: function (platform, isConnected) {
                var btn = document.querySelector('.connect-btn[data-platform="' + platform + '"]');
                if (!btn) return;
                if (isConnected) {
                    btn.classList.add('connected');
                    btn.textContent = '\u2713 Connected';
                } else {
                    btn.classList.remove('connected');
                    btn.textContent = 'Connect';
                }
            }
        };

        /* ── AJAX content loader ───────────────────────────── */
        function _loadContent(platform, onLoaded) {
            var el = document.getElementById('pamModalContent');
            el.innerHTML = _skeleton();

            fetch('/Integrations/Modal/' + platform, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function (html) {
                el.innerHTML = html;
                /* Re-execute any <script> blocks in the returned partial */
                el.querySelectorAll('script').forEach(function (old) {
                    var s  = document.createElement('script');
                    s.text = old.textContent;
                    old.parentNode.replaceChild(s, old);
                });
                /* Fire callback after scripts have run */
                if (typeof onLoaded === 'function') {
                    setTimeout(onLoaded, 50);
                }
            })
            .catch(function (err) {
                el.innerHTML =
                    '<div class="pam-load-error">&#9888; Could not load the ' + platform + ' integration.<br>' +
                    '<small>' + err.message + '</small><br>' +
                    '<button onclick="PlatformAuth.open(\'' + platform + '\')">Retry</button></div>';
            });
        }

        function _skeleton() {
            return '<div class="pam-loading">' +
                '<div class="pam-skel short"></div><div class="pam-skel"></div>' +
                '<div class="pam-skel tall"></div><div class="pam-skel"></div>' +
                '<div class="pam-skel short"></div></div>';
        }

        document.getElementById('pamBackdrop').addEventListener('click', function (e) {
            if (e.target === this) PlatformAuth.close();
        });
    })();
</script>
