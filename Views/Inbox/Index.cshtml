<script>
    var ALL_ITEMS     = @Html.Raw(ViewBag.InboxJson ?? "[]");
    var COMPLETED     = new Set();
    var SAVED         = new Set();
    var currentTab    = 'all';
    var currentSearch = '';
    var currentSort   = 'newest';
    var activeFilters = { platforms:[], dateFrom:'', dateTo:'', types:[] };
    var activeItemId  = null;   // currently open detail
    var tReplies      = {};     // id → [{sender,text,time,own,saved,failed,error}]

    /* ── Init ── */
    document.addEventListener('DOMContentLoaded', function(){
        updateBadges();
        renderFeed();
        initResizer();
    });

    function updateBadges(){
        var t=ALL_ITEMS.length;
        var m=ALL_ITEMS.filter(function(x){ return x.itemType==='message'; }).length;
        var ab=document.getElementById('nav-badge-all'), mb=document.getElementById('nav-badge-message');
        ab.textContent=t; ab.style.display=t>0?'':'none';
        mb.textContent=m; mb.style.display=m>0?'':'none';
        document.getElementById('msgCount').textContent=t;
    }

    /* ── Tab / search / sort ── */
    function setTab(tab,el){
        currentTab=tab;
        document.querySelectorAll('.inbox-nav-item').forEach(function(a){ a.classList.remove('active'); });
        if(el) el.classList.add('active');
        var titles={all:'All Messages',message:'Private Messages',completed:'Completed',saved:'Saved Messages',approvals:'Reply Approvals'};
        document.getElementById('inboxTitle').textContent=titles[tab]||'All Messages';
        closeDetail();
        renderFeed();
    }
    function applySearch(){ currentSearch=document.getElementById('searchInput').value.toLowerCase(); renderFeed(); }
    function applySort(v){ currentSort=v; renderFeed(); }

    /* ── Filter ── */
    function getFiltered(){
        var items=ALL_ITEMS.slice();
        if(currentTab==='message')        items=items.filter(function(x){ return x.itemType==='message'; });
        else if(currentTab==='completed') items=items.filter(function(x){ return COMPLETED.has(x.id); });
        else if(currentTab==='saved')     items=items.filter(function(x){ return SAVED.has(x.id); });
        if(currentSearch)
            items=items.filter(function(x){ return (x.senderName+' '+x.message).toLowerCase().indexOf(currentSearch)!==-1; });
        if(activeFilters.platforms.length>0)
            items=items.filter(function(x){ return activeFilters.platforms.indexOf((x.platform||'').toLowerCase())!==-1; });
        if(activeFilters.dateFrom){
            var fd=new Date(activeFilters.dateFrom); fd.setHours(0,0,0,0);
            items=items.filter(function(x){ return new Date(x.time)>=fd; });
        }
        if(activeFilters.dateTo){
            var td=new Date(activeFilters.dateTo); td.setHours(23,59,59,999);
            items=items.filter(function(x){ return new Date(x.time)<=td; });
        }
        if(activeFilters.types.length>0){
            items=items.filter(function(x){
                if(activeFilters.types.indexOf('message')!==-1&&x.itemType==='message') return true;
                if(activeFilters.types.indexOf('mention')!==-1&&x.commentType==='mention') return true;
                if(activeFilters.types.indexOf('live_comment')!==-1&&x.commentType==='live_comment') return true;
                if(activeFilters.types.indexOf('comment')!==-1&&x.itemType!=='message'&&x.commentType!=='mention'&&x.commentType!=='live_comment') return true;
                return false;
            });
        }
        items.sort(function(a,b){
            if(currentSort==='name')   return (a.senderName||'').localeCompare(b.senderName||'');
            if(currentSort==='oldest') return new Date(a.time)-new Date(b.time);
            return new Date(b.time)-new Date(a.time);
        });
        return items;
    }

    /* ── Render feed ── */
    function renderFeed(){
        var items=getFiltered();
        var feed=document.getElementById('inboxFeed');
        if(items.length===0){
            feed.innerHTML='<div class="inbox-empty"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><h4>No messages here</h4><p>New comments and messages will appear here.</p></div>';
            return;
        }
        feed.innerHTML=items.map(buildCard).join('');
    }

    /* ── Build card ── */
    function buildCard(item){
        var name=(item.senderName&&item.senderName!=='Unknown'&&item.senderName.trim())
            ?item.senderName:(item.senderId?'User '+item.senderId.slice(-6):'Unknown User');
        var initials=name.split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2)||'?';
        var bg=avatarColor(name);
        var ago=fmtTime(item.time);
        var isDone=COMPLETED.has(item.id);
        var isSaved=SAVED.has(item.id);
        var isActive=activeItemId===item.id;

        var platSvg='';
        if(item.platform==='facebook'||item.platform==='messenger'){
            platSvg='<svg viewBox="0 0 24 24" fill="#1877F2" width="9" height="9"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>';
        } else if(item.platform==='instagram'||item.platform==='instagram_dm'){
            platSvg='<svg viewBox="0 0 24 24" fill="none" width="9" height="9"><defs><linearGradient id="igc'+item.id+'" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433"/><stop offset=".5" stop-color="#dc2743"/><stop offset="1" stop-color="#bc1888"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igc'+item.id+')"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8"/><circle cx="17" cy="7" r="1.2" fill="#fff"/></svg>';
        }

        var tLabel='Comment',tCls='tbadge-comment';
        if(item.itemType==='message')              {tLabel='Message';      tCls='tbadge-message';}
        else if(item.commentType==='mention')      {tLabel='Mention';      tCls='tbadge-mention';}
        else if(item.commentType==='live_comment') {tLabel='Live Comment'; tCls='tbadge-live';}

        var profileUrl=buildProfileUrl(item);
        var ctx='';
        // if(item.platform==='facebook'||item.platform==='messenger'){
        //     ctx='<svg viewBox="0 0 24 24" fill="#1877F2" width="10" height="10"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>';
        // } else if(item.platform==='instagram'||item.platform==='instagram_dm'){
        //     ctx='<svg viewBox="0 0 24 24" fill="none" width="10" height="10"><defs><linearGradient id="igctx'+item.id+'" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433"/><stop offset=".5" stop-color="#dc2743"/><stop offset="1" stop-color="#bc1888"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igctx'+item.id+')"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8"/><circle cx="17" cy="7" r="1.2" fill="#fff"/></svg>';
        // }
        if(item.itemType==='message'){
            ctx+=' Direct message via <strong>'+capFirst(item.platform||'')+'</strong>';
        } else if(item.postName&&item.postName.trim()){
            ctx+=' On post: <a href="'+esc(buildPostUrl(item))+'" target="_blank">'+esc(item.postName.slice(0,40))+'</a>';
        } else if(item.postId&&item.postId.length>0){
            ctx+=' On post <a href="'+esc(buildPostUrl(item))+'" target="_blank">…'+esc(item.postId.slice(-10))+'</a>';
        } else if(item.pageId&&item.pageId.length>0){
            ctx+=' Wall of <strong>'+esc(item.pageId)+'</strong>';
        }

        var extra='';
        if(item.isReplied) extra+='<span class="msg-replied-badge">↩ Replied</span>';
        if(isDone)         extra+='<span class="msg-done-badge">✓ Done</span>';

        var bodyTxt=(item.message||'').trim();
        var bodyHtml=bodyTxt?esc(bodyTxt):'<span class="msg-body-empty">(no message text)</span>';

        var footer=item.commentType==='mention'?'<div class="msg-in-response">In response to a mention</div>':'';

        return '<div class="msg-card'+(isActive?' active-card':'')+'" id="card-'+item.id+'">'
            +'<div class="msg-card-top">'
                +'<div class="msg-ava-wrap">'
                    +'<div class="msg-ava" style="background:'+bg+'">'+initials+'</div>'
                    +(platSvg?'<div class="msg-plat-dot">'+platSvg+'</div>':'')
                +'</div>'
                +'<div class="msg-meta">'
                    +'<div class="msg-name-row">'
                            +esc(name)
                        +'<span class="msg-type-badge '+tCls+'">'+tLabel+'</span>'
                        +extra
                    +'</div>'
                    +'<div class="msg-ctx">'+ctx+'</div>'
                +'</div>'
                +'<div class="msg-top-right">'
                    +'<span class="msg-time">'+ago+'</span>'
                +'</div>'
            +'</div>'
            +'<div class="msg-body-text">'+bodyHtml+'</div>'
            +'<div class="msg-actions-bar">'
                +'<div class="msg-act-l">'
                    +'<button class="btn-thread'+(isActive?' active':'')+'" onclick="event.stopPropagation();openDetail('+item.id+')">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>'
                        +'View Thread & Reply'
                    +'</button>'
                +'</div>'
                +'<div class="msg-act-r">'
                    +'<div class="act-ico" title="Like" onclick="event.stopPropagation();this.classList.toggle(\'liked\')">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>'
                    +'</div>'
                    +'<div class="act-ico" title="Label" onclick="event.stopPropagation()">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>'
                    +'</div>'
                    +'<div class="act-ico'+(isDone?' is-done':'')+'" title="Mark done" onclick="event.stopPropagation();markDone('+item.id+',this)">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>'
                    +'</div>'
                    +'<div class="act-ico'+(isSaved?' is-saved':'')+'" title="Save" onclick="event.stopPropagation();toggleSave('+item.id+',this)">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>'
                    +'</div>'
                    +'<div class="act-ico" title="Assign" onclick="event.stopPropagation()">'
                        +'<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'
                    +'</div>'
                +'</div>'
            +'</div>'
            +footer
        +'</div>';
    }

    /* ══ DETAIL PANEL ══════════════════════════════════════════════ */
    function openDetail(id){
        var item=ALL_ITEMS.find(function(x){ return x.id===id; });
        if(!item) return;

        /* Highlight active card */
        activeItemId=id;
        document.querySelectorAll('.msg-card').forEach(function(c){ c.classList.remove('active-card'); });
        var card=document.getElementById('card-'+id);
        if(card) card.classList.add('active-card');
        document.querySelectorAll('.btn-thread').forEach(function(b){ b.classList.remove('active'); });
        var cardBtn=card?card.querySelector('.btn-thread'):null;
        if(cardBtn) cardBtn.classList.add('active');

        /* Open panel */
        document.getElementById('inboxShell').classList.add('detail-open');

        /* Header */
        var name=(item.senderName&&item.senderName!=='Unknown'&&item.senderName.trim())
            ?item.senderName:(item.senderId?'User '+item.senderId.slice(-6):'Unknown User');
        document.getElementById('detailHeadName').textContent=
            (item.itemType==='message'?'Direct Message':'Comment Thread')+' — '+name;
        document.getElementById('detailHeadSub').textContent=fmtTime(item.time);

        /* Platform badge */
        var platIcon='';
        if(item.platform==='facebook'||item.platform==='messenger'){
            platIcon='<svg viewBox="0 0 24 24" fill="#1877F2" width="11" height="11"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>';
        } else if(item.platform==='instagram'||item.platform==='instagram_dm'){
            platIcon='<svg viewBox="0 0 24 24" fill="none" width="11" height="11"><defs><linearGradient id="ighdr" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433"/><stop offset=".5" stop-color="#dc2743"/><stop offset="1" stop-color="#bc1888"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#ighdr)"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8"/><circle cx="17" cy="7" r="1.2" fill="#fff"/></svg>';
        }
        document.getElementById('detailPlatBadge').innerHTML=platIcon+'&nbsp;'+capFirst(item.platform||'');

        /* Post preview — only for comments with a postId */
        var postPreview=document.getElementById('detailPostPreview');
        if(item.itemType==='comment'&&item.postId&&item.postId.length>0){
            postPreview.style.display='block';
            loadPostPreview(item);
        } else {
            postPreview.style.display='none';
        }

        /* Original comment/message */
        var ini=name.split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2)||'?';
        var profileUrl=buildProfileUrl(item);
        document.getElementById('detailOrigComment').innerHTML=
            '<div class="doc-label">'+(item.itemType==='message'?'Message':'Comment')+'</div>'
            +'<div class="doc-row">'
                +'<div class="doc-ava" style="background:'+avatarColor(name)+'">'+ini+'</div>'
                +'<div class="doc-body">'
                    +'<div class="doc-name"><a href="'+esc(profileUrl)+'" target="_blank">'+esc(name)+'</a></div>'
                    +'<div class="doc-text">'+esc(item.message||'(no message text)')+'</div>'
                    +'<div class="doc-time">'+fmtTime(item.time)+'</div>'
                +'</div>'
            +'</div>';

        /* Reset composer */
        document.getElementById('dReplyTxt').value='';
        document.getElementById('dSendBtn').disabled=true;

        /* Load replies */
        loadDetailReplies(id, item.itemType);

        /* Scroll active card into view */
        if(card) card.scrollIntoView({behavior:'smooth',block:'nearest'});

        setTimeout(function(){ document.getElementById('dReplyTxt').focus(); },200);
    }

    /* ── Load post preview from Facebook Graph API ── */
    function loadPostPreview(item){
        var card=document.getElementById('dppCard');
        card.innerHTML='<div class="dpp-loading">Loading post…</div>';

        /* Fetch post details via your controller */
        fetch('/Inbox/GetPostPreview?postId='+encodeURIComponent(item.postId)+'&pageId='+encodeURIComponent(item.pageId||'')+'&platform='+encodeURIComponent(item.platform||''))
            .then(function(r){ return r.json(); })
            .then(function(data){
                if(data.error){
                    card.innerHTML='<div class="dpp-content"><div class="dpp-post-body" style="color:#aaa;font-style:italic;">Post preview unavailable.</div></div>';
                    return;
                }
                var imgHtml='';
                if(data.fullPicture||data.picture){
                    imgHtml='<img class="dpp-img" src="'+esc(data.fullPicture||data.picture)+'" alt="Post image" onerror="this.style.display=\'none\'">';
                } else {
                    imgHtml='<div class="dpp-img-placeholder"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
                }
                var postUrl=buildPostUrl(item);
                card.innerHTML=imgHtml
                    +'<div class="dpp-content">'
                        +(data.name?'<div class="dpp-post-title">'+esc(data.name)+'</div>':'')
                        +'<div class="dpp-post-body">'+esc((data.message||data.story||data.description||'').slice(0,200))+(((data.message||data.story||'').length>200)?'…':'')+'</div>'
                        +'<div class="dpp-post-meta">'
                            +(data.createdTime?fmtTime(data.createdTime):'')
                            +'&nbsp;·&nbsp;<a href="'+esc(postUrl)+'" target="_blank">View on '+capFirst(item.platform)+'</a>'
                        +'</div>'
                    +'</div>';
            })
            .catch(function(){
                card.innerHTML='<div class="dpp-content"><div class="dpp-post-body" style="color:#aaa;font-style:italic;">Could not load post preview.</div></div>';
            });
    }

    /* ── Load replies ── */
    function loadDetailReplies(id, itemType){
        var c=document.getElementById('detailReplies');
        c.innerHTML='<div class="no-replies-msg">Loading replies…</div>';

        fetch('/Inbox/GetReplies?itemId='+id+'&itemType='+(itemType||'comment'))
            .then(function(r){ return r.json(); })
            .then(function(data){
                var local=tReplies[id]||[];
                var server=data.map(function(r){
                    return {sender:'You (Page)',text:r.replyText,time:fmtTime(r.createdAt),own:true,saved:true,failed:!r.isSuccess,error:r.errorMessage};
                });
                tReplies[id]=server.concat(local.filter(function(l){ return !l.saved; }));
                renderDetailReplies(id);
            })
            .catch(function(){ renderDetailReplies(id); });
    }

    function renderDetailReplies(id){
        var replies=tReplies[id]||[];
        var c=document.getElementById('detailReplies');
        if(replies.length===0){ c.innerHTML='<div class="no-replies-msg">No replies yet. Be the first!</div>'; return; }
        c.innerHTML=replies.map(function(r){
            var ri=(r.sender||'Me').split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2);
            var failTag=r.failed?'<div class="reply-fail-tag">⚠ '+esc(r.error||'Failed')+'</div>':'';
            return '<div class="reply-row'+(r.own?' own':'')+'">'
                +'<div class="reply-ava" style="background:'+(r.own?(r.failed?'#e74c3c':'var(--green)'):'#6c5ce7')+'">'+ri+'</div>'
                +'<div class="reply-bubble'+(r.failed?' failed':'')+'">'
                    +'<div class="reply-name">'+esc(r.sender)+'</div>'
                    +'<div class="reply-text">'+esc(r.text)+'</div>'
                    +failTag
                    +'<div class="reply-time">'+r.time+'</div>'
                +'</div>'
            +'</div>';
        }).join('');
        c.scrollTop=c.scrollHeight;
    }

    /* ── Send reply ── */
    function sendDetailReply(){
        var txt=document.getElementById('dReplyTxt').value.trim();
        var item=ALL_ITEMS.find(function(x){ return x.id===activeItemId; });
        if(!txt||!item) return;

        var btn=document.getElementById('dSendBtn');
        var ta=document.getElementById('dReplyTxt');

        if(!tReplies[item.id]) tReplies[item.id]=[];
        var optimistic={sender:'You (Page)',text:txt,time:'Sending…',own:true,saved:false,failed:false};
        tReplies[item.id].push(optimistic);
        renderDetailReplies(item.id);

        btn.disabled=true; btn.innerHTML='<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Sending…';
        ta.disabled=true; ta.value='';

        fetch('/Inbox/Reply',{
            method:'POST',
            headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
            body:JSON.stringify({
                itemId   :item.id,
                itemType :item.itemType,
                platform :item.platform,
                commentId:item.commentId||'',
                message  :txt
            })
        })
        .then(function(r){ return r.json(); })
        .then(function(data){
            var idx=tReplies[item.id].indexOf(optimistic);
            if(idx!==-1){
                tReplies[item.id][idx]={sender:'You (Page)',text:txt,time:'Just now',own:true,saved:true,failed:!data.success,error:data.success?null:(data.error||'Failed')};
            }
            if(data.success){
                var ai=ALL_ITEMS.findIndex(function(x){ return x.id===item.id; });
                if(ai!==-1) ALL_ITEMS[ai].isReplied=true;
                renderFeed();
            }
        })
        .catch(function(){
            var idx=tReplies[item.id].indexOf(optimistic);
            if(idx!==-1){ tReplies[item.id][idx].failed=true; tReplies[item.id][idx].error='Network error'; tReplies[item.id][idx].time='Failed'; }
        })
        .finally(function(){
            renderDetailReplies(item.id);
            btn.innerHTML='<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Send';
            btn.disabled=false; ta.disabled=false; ta.focus();
        });
    }

    function closeDetail(){
        document.getElementById('inboxShell').classList.remove('detail-open');
        activeItemId=null;
        document.querySelectorAll('.msg-card').forEach(function(c){ c.classList.remove('active-card'); });
        document.querySelectorAll('.btn-thread').forEach(function(b){ b.classList.remove('active'); });
    }

    /* ── Resizer (drag to adjust split) ── */
    function initResizer(){
        var resizer=document.getElementById('inboxResizer');
        var shell=document.getElementById('inboxShell');
        var center=document.getElementById('inboxCenter');
        var isDown=false, startX=0, startW=0;

        resizer.addEventListener('mousedown',function(e){
            isDown=true; startX=e.clientX; startW=center.offsetWidth;
            document.body.style.cursor='col-resize'; document.body.style.userSelect='none';
        });
        document.addEventListener('mousemove',function(e){
            if(!isDown) return;
            var diff=e.clientX-startX;
            var newW=Math.max(300,Math.min(startW+diff, shell.offsetWidth-400));
            center.style.width=newW+'px';
        });
        document.addEventListener('mouseup',function(){ isDown=false; document.body.style.cursor=''; document.body.style.userSelect=''; });
    }

    /* ── URL helpers ── */
    function buildProfileUrl(item){
        if(!item.senderId) return '#';
        if(item.platform==='facebook'||item.platform==='messenger') return 'https://www.facebook.com/'+item.senderId;
        if(item.platform==='instagram'||item.platform==='instagram_dm') return 'https://www.instagram.com/'+item.senderId;
        return '#';
    }
    function buildPostUrl(item) {
        if (item.platform === 'facebook' || item.platform === 'messenger') {
            var postId = item.postId || '';
            if (!postId) return '#';

            // Graph API returns postId as "pageId_postId" e.g. "123456_987654"
            var parts = postId.split('_');
            if (parts.length === 2) {
                return 'https://www.facebook.com/' + parts[0] + '/posts/' + parts[1];
            }

            // Fallback if postId is not in expected format
            return 'https://www.facebook.com/' + postId;
        }

        if (item.platform === 'instagram') {
            var mediaId = item.postId || '';
            if (!mediaId) return '#';

            // Instagram Graph API postId is "igUserId_mediaId"
            var igParts = mediaId.split('_');
            var shortId = igParts.length === 2 ? igParts[1] : igParts[0];
            return 'https://www.instagram.com/p/' + shortId;
        }

        return '#';
    }

    /* ── Card actions ── */
    function markDone(id,el){
        if(COMPLETED.has(id)){ COMPLETED.delete(id); el.classList.remove('is-done'); }
        else                 { COMPLETED.add(id);    el.classList.add('is-done'); }
        renderFeed();
    }
    function toggleSave(id,el){
        if(SAVED.has(id)){ SAVED.delete(id); el.classList.remove('is-saved'); }
        else             { SAVED.add(id);    el.classList.add('is-saved'); }
    }

    /* ── Reload ── */
    function reloadInbox(){
        var btn=document.getElementById('reloadBtn');
        btn.classList.add('spinning'); btn.disabled=true;
        fetch('/Inbox/GetAll',{headers:{'X-Requested-With':'XMLHttpRequest'}})
            .then(function(r){ return r.json(); })
            .then(function(data){ ALL_ITEMS=data; updateBadges(); renderFeed(); })
            .catch(function(){ alert('Reload failed.'); })
            .finally(function(){ btn.classList.remove('spinning'); btn.disabled=false; });
    }

    /* ── Filter popup ── */
    function toggleFP(){
        var p=document.getElementById('fpPopup'),b=document.getElementById('fpBackdrop');
        if(p.style.display==='block'){ closeFP(); return; }
        var btn=document.getElementById('filterBtn'),r=btn.getBoundingClientRect();
        p.style.top=(r.bottom+8)+'px'; p.style.right=(window.innerWidth-r.right)+'px'; p.style.left='auto';
        p.style.display='block'; b.classList.add('open');
    }
    function closeFP(){ document.getElementById('fpPopup').style.display='none'; document.getElementById('fpBackdrop').classList.remove('open'); }
    function applyFP(){
        activeFilters.platforms=[];
        document.querySelectorAll('#fpPopup .fp-chk-item input[type=checkbox]').forEach(function(cb){ if(cb.checked) activeFilters.platforms.push(cb.value); });
        activeFilters.dateFrom=document.getElementById('fpDateFrom').value;
        activeFilters.dateTo=document.getElementById('fpDateTo').value;
        activeFilters.types=[];
        document.querySelectorAll('#fpPopup .fp-type-pill.sel').forEach(function(p){ activeFilters.types.push(p.dataset.type); });
        updateFPBadge(); closeFP(); renderFeed();
    }
    function clearFP(){
        document.querySelectorAll('#fpPopup .fp-chk-item input[type=checkbox]').forEach(function(cb){ cb.checked=false; });
        document.getElementById('fpDateFrom').value=''; document.getElementById('fpDateTo').value='';
        document.querySelectorAll('#fpPopup .fp-type-pill').forEach(function(p){ p.classList.remove('sel'); });
        activeFilters={platforms:[],dateFrom:'',dateTo:'',types:[]};
        updateFPBadge(); closeFP(); renderFeed();
    }
    function updateFPBadge(){
        var n=activeFilters.platforms.length+(activeFilters.dateFrom||activeFilters.dateTo?1:0)+activeFilters.types.length;
        var d=document.getElementById('filterDot'); d.textContent=n;
        if(n>0) d.classList.add('show'); else d.classList.remove('show');
    }

    /* ── Helpers ── */
    var AC=['#6c5ce7','#e17055','#00b894','#0984e3','#e84393','#fdcb6e','#d63031','#00cec9','#a29bfe'];
    function avatarColor(n){ var h=0; for(var i=0;i<(n||'').length;i++) h=(h*31+(n||'').charCodeAt(i))&0xffffffff; return AC[Math.abs(h)%AC.length]; }
    function fmtTime(t){
        if(!t) return '';
        var d=new Date(t),now=new Date(),diff=Math.floor((now-d)/1000);
        if(diff<60) return diff+'s ago';
        if(diff<3600) return Math.floor(diff/60)+'m ago';
        if(diff<86400) return Math.floor(diff/3600)+'h ago';
        if(diff<604800) return Math.floor(diff/86400)+'d ago';
        return d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
    }
    function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function capFirst(s){ return s?s.charAt(0).toUpperCase()+s.slice(1):''; }
    function autoGrow(el){ el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,100)+'px'; }
</script>