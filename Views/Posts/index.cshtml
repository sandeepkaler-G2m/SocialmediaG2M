@model SocialMediaPanel.ViewModels.PostListViewModel
@{
    ViewData["Title"] = "Posts";
    ViewData["ActiveNav"] = "Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ══ WRAPPER ══ */
    .posts-shell {
        display: flex;
        height: calc(100vh - 58px);
        margin: -28px;
        overflow: hidden;
        font-family: 'DM Sans', sans-serif;
    }

    /* ══ LEFT NAV (same as Inbox) ══ */
    .posts-nav {
        width: 200px;
        min-width: 200px;
        background: #fff;
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        flex-shrink: 0;
    }

    .posts-nav-header {
        padding: 14px 18px 10px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .06em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--border);
    }

    .posts-nav-item {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 10px 18px !important;
        font-size: 13px !important;
        color: var(--muted) !important;
        font-weight: 500 !important;
        cursor: pointer !important;
        text-decoration: none !important;
        border-left: 3px solid transparent !important;
        transition: background .12s, color .12s !important;
    }

        .posts-nav-item:hover {
            background: #f4f5f7 !important;
            color: var(--text) !important;
        }

        .posts-nav-item.active {
            background: rgba(75,181,67,.07) !important;
            border-left-color: var(--green) !important;
            color: var(--green) !important;
            font-weight: 600 !important;
        }

    .posts-nav-badge {
        font-size: 10px;
        font-weight: 700;
        background: var(--green);
        color: #fff;
        border-radius: 10px;
        padding: 1px 6px;
        min-width: 18px;
        text-align: center;
        line-height: 1.6;
    }

    /* ══ RIGHT CONTENT ══ */
    .posts-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .posts-page {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--bg);
    }

    /* ── Top bar ── */
    .posts-top-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .plat-icon-tabs {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .plat-icon-tab {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 2px solid transparent;
        transition: all .15s;
    }

        .plat-icon-tab svg {
            width: 18px;
            height: 18px;
        }

        .plat-icon-tab.active-fb {
            border-color: #1877F2;
        }

        .plat-icon-tab.active-tw {
            border-color: #000;
        }

        .plat-icon-tab.active-li {
            border-color: #0A66C2;
        }

        .plat-icon-tab.active-ig {
            border-color: #E1306C;
        }

        .plat-icon-tab:not([class*="active"]):hover {
            background: var(--bg);
        }

    .posts-bar-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .view-icon-btn {
        width: 30px;
        height: 30px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--muted);
        transition: all .15s;
    }

        .view-icon-btn:hover, .view-icon-btn.active {
            border-color: var(--green);
            color: var(--green);
        }

        .view-icon-btn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
        }

    .sort-label {
        font-size: 12.5px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        white-space: nowrap;
    }

        .sort-label strong {
            color: var(--text);
        }

        .sort-label svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    /* ── Sub nav ── */
    .posts-subnav {
        display: flex;
        align-items: center;
        padding: 0 20px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        overflow-x: auto;
    }

        .posts-subnav a {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 12px 14px;
            font-size: 13px;
            font-weight: 600;
            color: var(--muted);
            text-decoration: none;
            border-bottom: 3px solid transparent;
            transition: color .15s, border-color .15s;
            white-space: nowrap;
        }

            .posts-subnav a svg {
                width: 13px;
                height: 13px;
                stroke: currentColor;
                fill: none;
                flex-shrink: 0;
            }

            .posts-subnav a:hover {
                color: var(--text);
            }

            .posts-subnav a.active {
                color: var(--green);
                border-bottom-color: var(--green);
            }

                .posts-subnav a.active svg {
                    stroke: var(--green);
                }

    .subnav-sep {
        color: var(--muted);
        opacity: .4;
        font-size: 11px;
        padding: 0 4px;
        align-self: center;
    }

    /* ── Table ── */
    .posts-table-wrap {
        flex: 1;
        overflow-y: auto;
        background: #fff;
    }

    .posts-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .posts-tbl thead th {
            padding: 10px 18px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .07em;
            border-bottom: 1px solid var(--border);
            background: #fafbfc;
            text-align: left;
            white-space: nowrap;
        }

    .post-tr {
        cursor: pointer;
        border-bottom: 1px solid var(--border);
        transition: background .13s;
    }

        .post-tr:hover {
            background: rgba(75,181,67,.04);
        }

        .post-tr td {
            padding: 13px 18px;
            vertical-align: middle;
        }

    .p-date {
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        white-space: nowrap;
    }

    .p-time {
        font-size: 11.5px;
        color: var(--muted);
        margin-top: 2px;
    }

    .p-content-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .p-thumb {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        background: rgba(75,181,67,.08);
        border: 1px solid rgba(75,181,67,.15);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
        color: var(--green);
        position: relative;
    }

        .p-thumb svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
        }

        .p-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .p-thumb-icon {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 14px;
        height: 14px;
        background: rgba(0,0,0,.3);
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .p-thumb-icon svg {
            width: 9px;
            height: 9px;
            stroke: #fff;
            fill: none;
        }

    .p-text-preview {
        font-size: 13px;
        color: var(--text);
        font-weight: 500;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .p-engage-num {
        font-size: 16px;
        font-weight: 800;
        color: var(--green);
        font-family: 'Sora',sans-serif;
    }

    .p-engage-dash {
        color: var(--muted);
        font-size: 20px;
        font-weight: 300;
    }

    .p-via {
        font-size: 12.5px;
        color: var(--muted);
    }

    /* Empty state */
    .posts-empty {
        text-align: center;
        padding: 70px 24px;
        color: var(--muted);
    }

    .posts-empty-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(75,181,67,.07);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        color: var(--green);
    }

        .posts-empty-icon svg {
            width: 28px;
            height: 28px;
            stroke: currentColor;
            fill: none;
        }

    .posts-empty p {
        font-size: 13.5px;
        font-weight: 500;
    }

    /* ══ MODAL ══════════════════════════════════════════════════════ */
    .pm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 800;
        background: rgba(26,35,52,.38);
    }

        .pm-overlay.open {
            display: block;
        }

    .pm-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 40%;
        height: 100vh;
        background: #fff;
        box-shadow: -4px 0 28px rgba(0,0,0,.14);
        display: none;
        flex-direction: column;
        z-index: 801;
        overflow: hidden;
        animation: pmSlide .22s ease;
    }

        .pm-panel.open {
            display: flex;
        }

    @@keyframes pmSlide {
        from {
            transform: translateX(100%);
        }

        to {
            transform: translateX(0);
        }
    }

    .pm-close {
        position: absolute;
        top: 12px;
        right: 14px;
        width: 28px;
        height: 28px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        color: var(--muted);
        transition: all .15s;
    }

        .pm-close:hover {
            background: #e3e6ea;
            color: var(--text);
        }

        .pm-close svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
        }

    .pm-tab-bar {
        display: flex;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding: 0 16px;
        flex-shrink: 0;
    }

    .pm-tab {
        padding: 14px 12px 12px;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        font-family: 'DM Sans',sans-serif;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        margin-bottom: -1px;
        transition: color .15s, border-color .15s;
    }

        .pm-tab:hover {
            color: var(--text);
        }

        .pm-tab.active {
            color: var(--green);
            border-bottom-color: var(--green);
        }

    .pm-export {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        background: none;
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        font-family: 'DM Sans',sans-serif;
        color: var(--muted);
        cursor: pointer;
        transition: all .15s;
    }

        .pm-export svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
        }

        .pm-export:hover {
            border-color: var(--green);
            color: var(--green-d);
        }

    .pm-body {
        flex: 1;
        overflow-y: auto;
    }

    .pm-pane {
        display: none;
        padding: 18px;
    }

        .pm-pane.active {
            display: block;
        }

    .pm-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        height: 200px;
        color: var(--muted);
        font-size: 13px;
    }

    .pm-spinner {
        width: 26px;
        height: 26px;
        border: 3px solid var(--border);
        border-top-color: var(--green);
        border-radius: 50%;
        animation: spin .65s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="posts-shell">

    <!-- LEFT NAV -->
    <nav class="posts-nav">
        <div class="posts-nav-header">Publishing</div>
        <a class="posts-nav-item active" href="/Posts?platform=@Model.ActivePlatform&tab=published">
            Published
            <span class="posts-nav-badge">@Model.Posts.Count()</span>
        </a>
      @*   <a class="posts-nav-item" href="/Posts?platform=@Model.ActivePlatform&tab=scheduled">Scheduled</a>
        <a class="posts-nav-item" href="/Posts?platform=@Model.ActivePlatform&tab=approvals">Approvals</a>
        <a class="posts-nav-item" href="/Posts?platform=@Model.ActivePlatform&tab=unpublished">Unpublished</a>
        <a class="posts-nav-item" href="/Posts?platform=@Model.ActivePlatform&tab=draft">Drafts</a> *@
        <a class="posts-nav-item @(Model.ActiveTab == "draft" ? "active" : "")"
           href="/Posts?platform=@Model.ActivePlatform&tab=draft">
            Drafts
        </a>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="posts-main">
        <div class="posts-page">

            <!-- Platform icon tabs -->
            <div class="posts-top-bar">
                <div class="plat-icon-tabs">
                    <a href="/Posts/Index?platform=facebook&tab=@Model.ActiveTab"
                       class="plat-icon-tab @(Model.ActivePlatform == "facebook" ? "active-fb" : "")">
                        <svg viewBox="0 0 24 24" fill="@(Model.ActivePlatform == "facebook" ? "#1877F2" : "#9CA3AF")">
                            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                        </svg>
                    </a>
                    <a href="/Posts/Index?platform=instagram&tab=@Model.ActiveTab"
                       class="plat-icon-tab @(Model.ActivePlatform == "instagram" ? "active-ig" : "")">
                        <svg viewBox="0 0 24 24" fill="none"
                             stroke="@(Model.ActivePlatform == "instagram" ? "#E1306C" : "#9CA3AF")" stroke-width="2">
                            <rect x="2" y="2" width="20" height="20" rx="5" />
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                        </svg>
                    </a>
                </div>

                <div class="posts-bar-right">
                    
                    <button class="view-icon-btn" title="Refresh" onclick="location.reload()">
                        <svg viewBox="0 0 24 24" stroke-width="2">
                            <polyline points="1 4 1 10 7 10" />
                            <path d="M3.51 15a9 9 0 1 0 .49-3.5" />
                        </svg>
                    </button>
                    @* <span class="sort-label">
                        Sort by: <strong>Recent Posts</strong>
                        <svg viewBox="0 0 24 24" stroke-width="2"><polyline points="6 9 12 15 18 9" /></svg>
                    </span> *@
                </div>
            </div>

            <!-- Table -->
            <div class="posts-table-wrap">
                <table class="posts-tbl">
                    <thead>
                        <tr>
                            <th style="width:155px">PUBLISHED ON</th>
                            <th>POST CONTENT</th>
                            <th style="width:130px;text-align:center">
                                INTERACTION
                                <svg viewBox="0 0 24 24" width="11" height="11"
                                     style="stroke:var(--muted);fill:none;stroke-width:2;vertical-align:middle;margin-left:2px">
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                    <line x1="12" y1="16" x2="12.01" y2="16" />
                                </svg>
                            </th>
                            <th style="width:160px">PUBLISHED BY</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Posts.Any())
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="posts-empty">
                                        <div class="posts-empty-icon">
                                            <svg viewBox="0 0 24 24" stroke-width="1.5">
                                                <rect x="2" y="3" width="20" height="14" rx="2" />
                                                <line x1="8" y1="21" x2="16" y2="21" />
                                                <line x1="12" y1="17" x2="12" y2="21" />
                                            </svg>
                                        </div>
                                        <p>No posts found for @Model.ActivePlatform.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var post in Model.Posts)
                            {
                                var postDate = post.CreatedTime.HasValue
                                ? post.CreatedTime.Value.ToLocalTime()
                                : post.UpdatedAt.ToLocalTime();

                                <tr class="post-tr"
                                    onclick="handlePostClick('@post.PostId','@post.Platform','@Model.ActiveTab')">
                                    <td>
                                        <div class="p-date">@postDate.ToString("dd MMM yyyy")</div>
                                        <div class="p-time">@postDate.ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <div class="p-content-cell">
                                            @if (!string.IsNullOrEmpty(post.FullPicture))
                                            {
                                                <div class="p-thumb">
                                                    <div class="p-thumb-icon">
                                                        <svg viewBox="0 0 24 24" stroke-width="2">
                                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                                            <polyline points="21 15 16 10 5 21" />
                                                        </svg>
                                                    </div>
                                                    <img src="@post.FullPicture" alt="post" />
                                                </div>
                                            }
                                            <span class="p-text-preview">
                                                @(string.IsNullOrEmpty(post.Message) ? "(No text)" : post.Message)
                                            </span>
                                        </div>
                                    </td>
                                    <td style="text-align:center">
                                        @if (post.TotalEngagement > 0)
                                        {
                                            <span class="p-engage-num">@post.TotalEngagement</span>
                                        }
                                        else
                                        {
                                            <span class="p-engage-dash">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="p-via">via @Model.ActivePlatform</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- Modal -->
<div class="pm-overlay" id="pmOverlay" onclick="if(event.target===this)closePM()"></div>
<div class="pm-panel" id="pmPanel">
    <button class="pm-close" onclick="closePM()">
        <svg viewBox="0 0 24 24" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
    </button>
    <div class="pm-tab-bar">
        <button class="pm-tab active" data-tab="pm-details">Post Details</button>
        <button class="pm-tab" data-tab="pm-stats">Post Stats</button>
        <button class="pm-export">
            <svg viewBox="0 0 24 24" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
            </svg>
            Export
        </button>
    </div>
    <div class="pm-body" id="pmBody">
        <div class="pm-loading">
            <div class="pm-spinner"></div>
            <span>Loading...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPM(postId,platform) {
             window._currentPlatform = platform || 'facebook';
            document.getElementById('pmOverlay').classList.add('open');
            document.getElementById('pmPanel').classList.add('open');
            document.getElementById('pmBody').innerHTML =
                '<div class="pm-loading"><div class="pm-spinner"></div><span>Loading...</span></div>';

            document.querySelectorAll('.pm-tab').forEach(t => t.classList.remove('active'));
            document.querySelector('.pm-tab[data-tab="pm-details"]').classList.add('active');

        fetch('/Posts/Details?postId=' + encodeURIComponent(postId) + '&platform=' + encodeURIComponent(platform || 'facebook'), {
                        credentials: 'same-origin'
            })
            .then(r => {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(html => {
                document.getElementById('pmBody').innerHTML = html;
                initPMTabs();
            })
            .catch(err => {
                document.getElementById('pmBody').innerHTML =
                    '<p style="padding:30px;color:#dc3545;text-align:center">Failed to load. (' + err.message + ')</p>';
            });
        }

        function closePM() {
            document.getElementById('pmOverlay').classList.remove('open');
            document.getElementById('pmPanel').classList.remove('open');
        }

        function initPMTabs() {
            document.querySelectorAll('.pm-tab').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.pm-tab').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.pm-pane').forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    const t = document.getElementById(this.dataset.tab);
                    if (t) t.classList.add('active');
                });
            });
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closePM(); });

        function likePost(postId) {
            var btn = document.getElementById('likeBtn');
            if (btn) btn.disabled = true;
            fetch('/Posts/Like?postId=' + encodeURIComponent(postId), {
                method: 'POST', credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(d => {
                showPMToast(d.message, d.success ? 'ok' : 'err');
                if (btn) { btn.disabled = false; if (d.success) btn.classList.add('active-like'); }
            })
            .catch(() => { showPMToast('Network error','err'); if(btn) btn.disabled=false; });
        }

        function submitComment(postId) {
            var input = document.getElementById('mainCommentInput');
            var msg = input ? input.value.trim() : '';
            if (!msg) return;
        fetch('/Posts/Comment?postId=' + encodeURIComponent(postId) + '&message=' + encodeURIComponent(msg) + '&platform=' + encodeURIComponent(window._currentPlatform || 'facebook'), {
                        method: 'POST', credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) { input.value=''; showPMToast(d.message,'ok'); appendComment('commentsList','You',msg); }
                else showPMToast(d.message,'err');
            })
            .catch(() => showPMToast('Network error','err'));
        }

        function toggleReply(commentId) {
            var box = document.getElementById('reply-' + commentId);
            if (!box) return;
            box.classList.toggle('open');
            if (box.classList.contains('open')) {
                var inp = document.getElementById('replyInput-' + commentId);
                if (inp) inp.focus();
            }
        }

        function submitReply(commentId) {
            var input = document.getElementById('replyInput-' + commentId);
            var msg = input ? input.value.trim() : '';
            if (!msg) return;
        fetch('/Posts/Reply?commentId=' + encodeURIComponent(commentId) + '&message=' + encodeURIComponent(msg) + '&platform=' + encodeURIComponent(window._currentPlatform || 'facebook'), {
                        method: 'POST', credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    input.value = '';
                    var box = document.getElementById('reply-' + commentId);
                    if (box) box.classList.remove('open');
                    showPMToast(d.message, 'ok');
                    var cmtItem = document.getElementById('cmt-' + commentId);
                    if (cmtItem) {
                        var rd = cmtItem.querySelector('.pm-replies');
                        if (!rd) { rd = document.createElement('div'); rd.className='pm-replies'; var h=cmtItem.querySelector('.pm-cmt-header'); if(h) h.after(rd); }
                        rd.insertAdjacentHTML('beforeend','<div class="pm-reply-item"><div class="pm-cmt-header"><div class="pm-cmt-av" style="width:24px;height:24px;font-size:9px;flex-shrink:0">Y</div><div class="pm-cmt-body"><div class="pm-cmt-name" style="font-size:12px">You</div><div class="pm-cmt-msg" style="font-size:12px">'+escHtml(msg)+'</div><div class="pm-cmt-time">Just now</div></div></div></div>');
                    }
                } else showPMToast(d.message,'err');
            })
            .catch(() => showPMToast('Network error','err'));
        }

        function focusMainComment() {
            var inp = document.getElementById('mainCommentInput');
            if (inp) { inp.focus(); inp.scrollIntoView({behavior:'smooth'}); }
        }

        function appendComment(listId, name, msg) {
            var list = document.getElementById(listId);
            if (!list) return;
            list.insertAdjacentHTML('beforeend','<div class="pm-comment-item"><div class="pm-cmt-header"><div class="pm-cmt-av">'+name[0].toUpperCase()+'</div><div class="pm-cmt-body"><div class="pm-cmt-name">'+escHtml(name)+'</div><div class="pm-cmt-msg">'+escHtml(msg)+'</div><div class="pm-cmt-footer"><span class="pm-cmt-time">Just now</span></div></div></div></div>');
        }

        function showPMToast(msg, type) {
            var t = document.getElementById('pmToast');
            if (!t) return;
            t.textContent = msg; t.className = 'pm-toast ' + type; t.style.display = 'block';
            setTimeout(() => t.style.display = 'none', 3000);
        }

        function escHtml(s) {
            return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        }
    </script>
}