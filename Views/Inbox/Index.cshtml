@using SocialMediaPanel.Models
@{
    ViewData["Title"] = "Smart Inbox";
    ViewData["PageTitle"] = "Smart Inbox";
}

<style>
    /* ── Full-height shell ───────────────────────── */
    .inbox-shell {
        display: flex;
        height: calc(100vh - 58px);
        margin: -28px;
        overflow: hidden;
    }

    /* ══ LEFT SUB-NAV ════════════════════════════ */
    .inbox-nav {
        width: 210px;
        min-width: 210px;
        background: #fff;
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        flex-shrink: 0;
    }

    .inbox-nav-header {
        padding: 14px 18px 10px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .06em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--border);
    }

    .inbox-nav-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 18px;
        font-size: 13px;
        color: var(--muted);
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        border-left: 3px solid transparent;
        transition: background .12s, color .12s;
    }

        .inbox-nav-item:hover {
            background: #f4f5f7;
            color: var(--text);
        }

        .inbox-nav-item.active {
            background: rgba(75,181,67,.07);
            border-left-color: var(--green);
            color: var(--green);
            font-weight: 600;
        }

    .inbox-nav-group {
        padding: 14px 18px 4px;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .05em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .inbox-nav-group svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    .inbox-nav-badge {
        font-size: 10px;
        font-weight: 700;
        background: var(--green);
        color: #fff;
        border-radius: 10px;
        padding: 1px 6px;
        min-width: 18px;
        text-align: center;
    }

    /* ══ MAIN AREA ═══════════════════════════════ */
    .inbox-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-width: 0;
        background: #f4f5f7;
    }

    .inbox-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
        gap: 10px;
        flex-wrap: wrap;
    }

        .inbox-topbar h2 {
            font-family: 'Sora', sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: var(--text);
            white-space: nowrap;
        }

    .inbox-topbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .inbox-search {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 9px;
        width: 230px;
        transition: border-color .15s;
    }

        .inbox-search:focus-within {
            border-color: var(--green);
        }

        .inbox-search svg {
            width: 14px;
            height: 14px;
            stroke: var(--muted);
            fill: none;
            flex-shrink: 0;
        }

        .inbox-search input {
            border: none;
            outline: none;
            background: none;
            font-size: 13px;
            font-family: 'DM Sans', sans-serif;
            color: var(--text);
            width: 100%;
        }

            .inbox-search input::placeholder {
                color: var(--muted);
            }

    .tb-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 12px;
        color: var(--text);
        font-weight: 500;
        white-space: nowrap;
    }

        .tb-pill svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
        }

    /* Filter button wrapper */
    .tb-btn-filter-wrap {
        position: relative;
        display: inline-flex;
    }

    .tb-btn-filter {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s;
    }

        .tb-btn-filter:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .tb-btn-filter svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
        }

    .filter-active-dot {
        display: none;
        position: absolute;
        top: -5px;
        right: -5px;
        width: 17px;
        height: 17px;
        background: var(--green);
        color: #fff;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

        .filter-active-dot.show {
            display: flex;
        }

    /* Sort bar */
    .inbox-sortbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 20px;
        background: #fafbfc;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

    .sort-dd {
        padding: 5px 10px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 12px;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        cursor: pointer;
    }

    .reload-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s, color .15s;
    }

        .reload-btn:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .reload-btn svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
        }

        .reload-btn.spinning svg {
            animation: spin360 .7s linear infinite;
        }



    /* Feed */
    .inbox-feed {
        flex: 1 !important;
        overflow-y: auto !important;
        padding: 16px 20px !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 10px !important;
        background: #f4f5f7 !important;
    }

    /* Message card */
    .msg-card {
        background: #fff !important;
        border: 1px solid var(--border) !important;
        border-radius: 14px !important;
        overflow: visible !important;
        transition: box-shadow .15s;
        display: block !important;
        width: 100% !important;
    }

        .msg-card:hover {
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

    .msg-card-header {
        display: flex !important;
        align-items: center !important;
        gap: 12px;
        padding: 14px 18px 10px !important;
        background: #fff;
    }

    .msg-avatar {
        width: 40px !important;
        height: 40px !important;
        border-radius: 50% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 14px !important;
        font-weight: 700 !important;
        color: #fff !important;
        flex-shrink: 0 !important;
        position: relative !important;
        line-height: 1 !important;
    }

    .msg-platform-badge {
        position: absolute !important;
        bottom: -2px !important;
        right: -2px !important;
        width: 16px !important;
        height: 16px !important;
        border-radius: 50% !important;
        background: #fff !important;
        border: 1.5px solid #fff !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

        .msg-platform-badge svg {
            width: 11px !important;
            height: 11px !important;
        }

    .msg-avatar-info {
        flex: 1 !important;
        min-width: 0 !important;
    }

    .msg-sender-name {
        font-size: 13px !important;
        font-weight: 700 !important;
        color: var(--text) !important;
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        margin: 0 !important;
    }

    .msg-sender-sub {
        font-size: 11px !important;
        color: var(--muted) !important;
        margin-top: 2px !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    .msg-header-right {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        flex-shrink: 0 !important;
    }

    .msg-time {
        font-size: 11px !important;
        color: var(--muted) !important;
        white-space: nowrap !important;
    }

    .msg-type-badge {
        font-size: 10px !important;
        font-weight: 600 !important;
        padding: 2px 8px !important;
        border-radius: 4px !important;
        display: inline-block !important;
        line-height: 1.4 !important;
    }

    .type-comment {
        background: rgba(75,181,67,.1) !important;
        color: #3a9e34 !important;
    }

    .type-message {
        background: rgba(29,161,161,.1) !important;
        color: #1DA1A1 !important;
    }

    .type-mention {
        background: rgba(255,107,157,.1) !important;
        color: #e91e8c !important;
    }

    .msg-body {
        display: block !important;
        padding: 6px 18px 14px 70px !important;
        font-size: 13px !important;
        color: var(--text) !important;
        line-height: 1.6 !important;
        min-height: 36px !important;
        background: #fff !important;
    }

    .msg-actions {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        padding: 8px 18px !important;
        border-top: 1px solid var(--border) !important;
        background: #fafbfc !important;
    }

    .msg-action-left {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
    }

    .msg-action-right {
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
    }

    .ma-btn {
        display: flex !important;
        align-items: center !important;
        gap: 5px !important;
        padding: 5px 12px !important;
        background: #fff !important;
        border: 1px solid var(--border) !important;
        border-radius: 7px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        color: var(--text) !important;
        font-family: 'DM Sans', sans-serif !important;
        cursor: pointer !important;
        text-decoration: none !important;
        transition: border-color .15s;
    }

        .ma-btn:hover {
            border-color: var(--green) !important;
            color: var(--green) !important;
        }

    .ma-icon {
        width: 30px !important;
        height: 30px !important;
        border-radius: 7px !important;
        background: none !important;
        border: 1px solid transparent !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        transition: background .12s, border-color .12s;
    }

        .ma-icon:hover {
            background: #f4f5f7 !important;
            border-color: var(--border) !important;
        }

        .ma-icon svg {
            width: 15px !important;
            height: 15px !important;
            stroke: var(--muted);
            fill: none;
        }

        .ma-icon.liked svg {
            stroke: #e91e8c !important;
            fill: #e91e8c !important;
        }

        .ma-icon.done svg {
            stroke: var(--green) !important;
        }

    /* Empty state */
    .inbox-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        text-align: center;
        padding: 48px;
    }

        .inbox-empty svg {
            width: 64px;
            height: 64px;
            stroke: var(--muted);
            fill: none;
            margin-bottom: 16px;
            opacity: .4;
        }

        .inbox-empty h4 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 8px;
        }

        .inbox-empty p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.6;
        }

    /* Reply modal */
    .reply-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.4);
        z-index: 500;
        align-items: flex-end;
        justify-content: center;
    }

        .reply-modal-backdrop.open {
            display: flex;
        }

    .reply-modal {
        background: #fff;
        border-radius: 16px 16px 0 0;
        width: 640px;
        max-width: 100%;
        box-shadow: 0 -8px 32px rgba(0,0,0,.18);
    }

    .reply-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
    }

        .reply-modal-head h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
        }

    .reply-close {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 18px;
        color: var(--muted);
    }

    .reply-to {
        padding: 10px 20px;
        font-size: 12px;
        color: var(--muted);
        background: #fafbfc;
        border-bottom: 1px solid var(--border);
    }

        .reply-to strong {
            color: var(--text);
        }

    .reply-original {
        padding: 8px 20px;
        font-size: 12px;
        color: var(--muted);
        font-style: italic;
        border-bottom: 1px solid var(--border);
    }

    .reply-textarea {
        width: 100%;
        padding: 14px 20px;
        border: none;
        outline: none;
        resize: none;
        font-size: 13px;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        min-height: 90px;
    }

    .reply-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        padding: 10px 20px;
        border-top: 1px solid var(--border);
    }

    .reply-cancel {
        padding: 7px 14px;
        background: #f4f5f7;
        border: none;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
    }

    .reply-send {
        padding: 7px 18px;
        background: var(--green);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .reply-send svg {
            width: 13px;
            height: 13px;
            stroke: #fff;
            fill: none;
        }

        .reply-send:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    /* ══ FILTER POPUP ════════════════════════════ */
    .filter-popup-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 400;
    }

        .filter-popup-backdrop.open {
            display: block;
        }

    .filter-popup {
        position: fixed;
        width: 300px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,.14);
        z-index: 401;
        overflow: hidden;
        display: none;
    }

    .fp-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
    }

        .fp-head h4 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

    .fp-close {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 16px;
        color: var(--muted);
        line-height: 1;
        padding: 0;
    }

    .fp-section {
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
    }

    .fp-section-label {
        font-size: 10px;
        font-weight: 700;
        color: var(--muted);
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .fp-check-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .fp-check-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        color: var(--text);
        cursor: pointer;
        user-select: none;
    }

        .fp-check-item input[type=checkbox] {
            width: 14px;
            height: 14px;
            accent-color: var(--green);
            cursor: pointer;
            flex-shrink: 0;
        }

    .fp-plat-icon {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .fp-date-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .fp-date-row label {
            font-size: 11px;
            color: var(--muted);
            min-width: 28px;
        }

    .fp-date-input {
        flex: 1;
        padding: 6px 8px;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 12px;
        font-family: 'DM Sans', sans-serif;
        color: var(--text);
        background: #fff;
        outline: none;
    }

        .fp-date-input:focus {
            border-color: var(--green);
        }

    .fp-type-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .fp-type-pill {
        padding: 5px 12px;
        border: 1.5px solid var(--border);
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all .15s;
        user-select: none;
    }

        .fp-type-pill.selected {
            border-color: var(--green);
            color: var(--green);
            background: rgba(75,181,67,.08);
        }

    .fp-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
    }

    .fp-clear {
        background: none;
        border: none;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        padding: 0;
    }

        .fp-clear:hover {
            color: var(--text);
        }

    .fp-apply {
        padding: 7px 18px;
        background: var(--green);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
    }
</style>

<div class="inbox-shell">

    <!-- ══ LEFT SUB-NAV ══ -->
    <nav class="inbox-nav">
        <div class="inbox-nav-header">Smart Inbox</div>
        <a class="inbox-nav-item active" href="#" onclick="setTab('all',this);return false">
            All Messages
            <span class="inbox-nav-badge" id="nav-badge-all" style="display:none"></span>
        </a>
        <a class="inbox-nav-item" href="#" onclick="setTab('message',this);return false">
            Private
            <span class="inbox-nav-badge" id="nav-badge-message" style="display:none"></span>
        </a>
        <a class="inbox-nav-item" href="#" onclick="setTab('completed',this);return false">Completed</a>
        <a class="inbox-nav-item" href="#" onclick="setTab('saved',this);return false">Saved Messages</a>
        <a class="inbox-nav-item" href="#" onclick="setTab('approvals',this);return false">Reply Approvals</a>
        <div class="inbox-nav-group">
            Custom Views
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
        </div>
    </nav>

    <!-- ══ MAIN ══ -->
    <div class="inbox-main">

        <!-- Top bar -->
        <div class="inbox-topbar">
            <h2 id="inboxTitle">All Messages</h2>
            <div class="inbox-topbar-right">
                <div class="inbox-search">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    <input type="text" id="searchInput" placeholder="Search messages..." oninput="applySearch()">
                </div>
                <div class="tb-pill">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span id="msgCount">0</span> messages
                </div>
                <div class="tb-btn-filter-wrap">
                    <button class="tb-btn-filter" id="filterBtn" onclick="toggleFilterPopup()">
                        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="10" y1="18" x2="14" y2="18" /></svg>
                        Filters
                    </button>
                    <span class="filter-active-dot" id="filterDot">0</span>
                </div>
            </div>
        </div>

        <!-- Sort + Reload bar -->
        <div class="inbox-sortbar">
            <select class="sort-dd" onchange="applySort(this.value)">
                <option value="newest">Newest to Oldest</option>
                <option value="oldest">Oldest to Newest</option>
                <option value="name">Sender A–Z</option>
            </select>
            <button class="reload-btn" id="reloadBtn" onclick="reloadInbox()">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg>
                Reload
            </button>
        </div>

        <!-- Feed -->
        <div class="inbox-feed" id="inboxFeed"></div>

    </div>
</div>

<!-- ══ REPLY MODAL ══ -->
<div class="reply-modal-backdrop" id="replyBackdrop" onclick="if(event.target===this)closeReply()">
    <div class="reply-modal">
        <div class="reply-modal-head">
            <h4 id="replyTitle">Reply</h4>
            <button class="reply-close" onclick="closeReply()">✕</button>
        </div>
        <div class="reply-to">Replying to <strong id="replyToName"></strong></div>
        <div class="reply-original" id="replyOriginal"></div>
        <textarea class="reply-textarea" id="replyText" placeholder="Type your reply…"
                  oninput="document.getElementById('replySendBtn').disabled=!this.value.trim()"></textarea>
        <div class="reply-footer">
            <button class="reply-cancel" onclick="closeReply()">Cancel</button>
            <button class="reply-send" id="replySendBtn" disabled onclick="sendReply()">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                Send Reply
            </button>
        </div>
    </div>
</div>

<!-- ══ FILTER POPUP ══ -->
<div class="filter-popup-backdrop" id="filterBackdrop" onclick="closeFilterPopup()"></div>
<div class="filter-popup" id="filterPopup">
    <div class="fp-head">
        <h4>Filter Messages</h4>
        <button class="fp-close" onclick="closeFilterPopup()">✕</button>
    </div>

    <div class="fp-section">
        <div class="fp-section-label">Platform</div>
        <div class="fp-check-group">
            <label class="fp-check-item">
                <input type="checkbox" id="fp-facebook" value="facebook">
                <div class="fp-plat-icon" style="background:#e7f0fd">
                    <svg viewBox="0 0 24 24" fill="#1877F2" width="11" height="11"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
                </div>
                Facebook
            </label>
            <label class="fp-check-item">
                <input type="checkbox" id="fp-messenger" value="messenger">
                <div class="fp-plat-icon" style="background:#e7f0fd">
                    <svg viewBox="0 0 24 24" fill="#0084FF" width="11" height="11"><path d="M12 0C5.373 0 0 4.974 0 11.111c0 3.498 1.744 6.614 4.469 8.652V24l4.088-2.242c1.092.301 2.246.464 3.443.464 6.627 0 12-4.974 12-11.111S18.627 0 12 0zm1.191 14.963l-3.055-3.26-5.963 3.26L10.732 8.1l3.131 3.26L19.752 8.1l-6.561 6.863z" /></svg>
                </div>
                Messenger
            </label>
            <label class="fp-check-item">
                <input type="checkbox" id="fp-instagram" value="instagram">
                <div class="fp-plat-icon" style="background:#fce4ec">
                    <svg viewBox="0 0 24 24" fill="none" width="11" height="11">
                        <defs><linearGradient id="igfp" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433" /><stop offset=".5" stop-color="#dc2743" /><stop offset="1" stop-color="#bc1888" /></linearGradient></defs>
                        <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igfp)" />
                        <circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8" />
                        <circle cx="17" cy="7" r="1.2" fill="#fff" />
                    </svg>
                </div>
                Instagram
            </label>
            <label class="fp-check-item">
                <input type="checkbox" id="fp-instagramdm" value="instagram_dm">
                <div class="fp-plat-icon" style="background:#fce4ec">
                    <svg viewBox="0 0 24 24" fill="none" width="11" height="11">
                        <defs><linearGradient id="igdmfp" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433" /><stop offset=".5" stop-color="#dc2743" /><stop offset="1" stop-color="#bc1888" /></linearGradient></defs>
                        <rect x="2" y="2" width="20" height="20" rx="5" fill="url(#igdmfp)" />
                        <circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8" />
                        <circle cx="17" cy="7" r="1.2" fill="#fff" />
                    </svg>
                </div>
                Instagram DM
            </label>
        </div>
    </div>

    <div class="fp-section">
        <div class="fp-section-label">Date Range</div>
        <div style="display:flex;flex-direction:column;gap:8px">
            <div class="fp-date-row">
                <label>From</label>
                <input type="date" class="fp-date-input" id="fp-date-from">
            </div>
            <div class="fp-date-row">
                <label>To</label>
                <input type="date" class="fp-date-input" id="fp-date-to">
            </div>
        </div>
    </div>

    <div class="fp-section" style="border-bottom:none">
        <div class="fp-section-label">Message Type</div>
        <div class="fp-type-group">
            <div class="fp-type-pill" data-type="comment" onclick="toggleTypePill(this)">Comment</div>
            <div class="fp-type-pill" data-type="message" onclick="toggleTypePill(this)">Message</div>
            <div class="fp-type-pill" data-type="mention" onclick="toggleTypePill(this)">Mention</div>
            <div class="fp-type-pill" data-type="live_comment" onclick="toggleTypePill(this)">Live Comment</div>
        </div>
    </div>

    <div class="fp-footer">
        <button class="fp-clear" onclick="clearFilters()">Clear all</button>
        <button class="fp-apply" onclick="applyFilters()">Apply Filters</button>
    </div>
</div>

@* ── ONE single script block — everything in correct order ── *@
<script>
    /* ── Data from server ─────────────────────── */
    var ALL_ITEMS = @Html.Raw(ViewBag.InboxJson ?? "[]");
    var COMPLETED = new Set();
    var SAVED     = new Set();

    /* ── State ────────────────────────────────── */
    var currentTab    = 'all';
    var currentSearch = '';
    var currentSort   = 'newest';
    var replyItem     = null;

    /* Active filter state */
    var activeFilters = {
        platforms : [],   // e.g. ['facebook','instagram']
        dateFrom  : '',   // 'YYYY-MM-DD' or ''
        dateTo    : '',
        types     : []    // e.g. ['comment','message']
    };

    /* ── Init ─────────────────────────────────── */
    document.addEventListener('DOMContentLoaded', function () {
        updateNavBadges();
        renderFeed();
    });

    /* ── Nav badges ───────────────────────────── */
    function updateNavBadges() {
        var total = ALL_ITEMS.length;
        var msgs  = ALL_ITEMS.filter(function(x){ return x.itemType === 'message'; }).length;

        var ab = document.getElementById('nav-badge-all');
        var mb = document.getElementById('nav-badge-message');
        ab.textContent = total; ab.style.display = total > 0 ? '' : 'none';
        mb.textContent = msgs;  mb.style.display = msgs  > 0 ? '' : 'none';
        document.getElementById('msgCount').textContent = total;
    }

    /* ── Tab ──────────────────────────────────── */
    function setTab(tab, el) {
        currentTab = tab;
        document.querySelectorAll('.inbox-nav-item').forEach(function(a){ a.classList.remove('active'); });
        if (el) el.classList.add('active');
        var titles = { all:'All Messages', message:'Private Messages', completed:'Completed', saved:'Saved Messages', approvals:'Reply Approvals' };
        document.getElementById('inboxTitle').textContent = titles[tab] || 'All Messages';
        renderFeed();
    }

    function applySearch() { currentSearch = document.getElementById('searchInput').value.toLowerCase(); renderFeed(); }
    function applySort(v)  { currentSort = v; renderFeed(); }

    /* ══ CORE FILTER FUNCTION ══════════════════
       All filtering lives here — tab, search, sort
       AND the popup filters (platform / date / type).
       No patching, no overriding.
    ════════════════════════════════════════════ */
    function getFiltered() {
        var items = ALL_ITEMS.slice();

        /* 1. Tab filter */
        if (currentTab === 'message')        items = items.filter(function(x){ return x.itemType === 'message'; });
        else if (currentTab === 'completed') items = items.filter(function(x){ return COMPLETED.has(x.id); });
        else if (currentTab === 'saved')     items = items.filter(function(x){ return SAVED.has(x.id); });

        /* 2. Search filter */
        if (currentSearch) {
            items = items.filter(function(x){
                return (x.senderName + ' ' + x.message).toLowerCase().indexOf(currentSearch) !== -1;
            });
        }

        /* 3. Platform filter (from popup) */
        if (activeFilters.platforms.length > 0) {
            items = items.filter(function(x){
                return activeFilters.platforms.indexOf((x.platform || '').toLowerCase()) !== -1;
            });
        }

        /* 4. Date range filter (from popup) */
        if (activeFilters.dateFrom) {
            var fromDate = new Date(activeFilters.dateFrom);
            fromDate.setHours(0, 0, 0, 0);
            items = items.filter(function(x){ return new Date(x.time) >= fromDate; });
        }
        if (activeFilters.dateTo) {
            var toDate = new Date(activeFilters.dateTo);
            toDate.setHours(23, 59, 59, 999);
            items = items.filter(function(x){ return new Date(x.time) <= toDate; });
        }

        /* 5. Message type filter (from popup) */
        if (activeFilters.types.length > 0) {
            items = items.filter(function(x){
                /* "message" type pill → itemType === 'message' */
                if (activeFilters.types.indexOf('message') !== -1 && x.itemType === 'message') return true;
                /* "mention" pill → commentType === 'mention' */
                if (activeFilters.types.indexOf('mention') !== -1 && x.commentType === 'mention') return true;
                /* "live_comment" pill → commentType === 'live_comment' */
                if (activeFilters.types.indexOf('live_comment') !== -1 && x.commentType === 'live_comment') return true;
                /* "comment" pill → everything else (regular comment) */
                if (activeFilters.types.indexOf('comment') !== -1
                    && x.itemType !== 'message'
                    && x.commentType !== 'mention'
                    && x.commentType !== 'live_comment') return true;
                return false;
            });
        }

        /* 6. Sort */
        items.sort(function(a, b){
            if (currentSort === 'name')   return (a.senderName || '').localeCompare(b.senderName || '');
            if (currentSort === 'oldest') return new Date(a.time) - new Date(b.time);
            return new Date(b.time) - new Date(a.time);
        });

        return items;
    }

    /* ── Render ───────────────────────────────── */
    function renderFeed() {
        var items = getFiltered();
        var feed  = document.getElementById('inboxFeed');

        if (items.length === 0) {
            feed.innerHTML =
                '<div class="inbox-empty">' +
                '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>' +
                '<h4>No messages here</h4>' +
                '<p>New comments and messages from your connected<br>social platforms will appear here.</p>' +
                '</div>';
            return;
        }

        feed.innerHTML = items.map(buildCard).join('');
    }

    function buildCard(item) {
        var displayName = (item.senderName && item.senderName !== 'Unknown' && item.senderName.trim())
            ? item.senderName
            : (item.senderId ? 'User ' + item.senderId.slice(-6) : 'Unknown User');

        var initials = displayName.split(' ').map(function(w){ return w[0]; }).join('').toUpperCase().slice(0, 2) || '?';
        var timeAgo  = formatTime(item.time);
        var isDone   = COMPLETED.has(item.id);
        var isSaved  = SAVED.has(item.id);

        var platSvg = '';
        if (item.platform === 'facebook' || item.platform === 'messenger') {
            platSvg = '<svg viewBox="0 0 24 24" fill="#1877F2" width="11" height="11"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>';
        } else if (item.platform === 'instagram' || item.platform === 'instagram_dm') {
            platSvg = '<svg viewBox="0 0 24 24" fill="none" width="11" height="11"><defs><linearGradient id="ig' + item.id + '" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse"><stop stop-color="#f09433"/><stop offset=".5" stop-color="#dc2743"/><stop offset="1" stop-color="#bc1888"/></linearGradient></defs><rect x="2" y="2" width="20" height="20" rx="5" fill="url(#ig' + item.id + ')"/><circle cx="12" cy="12" r="4.5" stroke="#fff" stroke-width="1.8"/><circle cx="17" cy="7" r="1.2" fill="#fff"/></svg>';
        }

        var typeLabel = 'Comment', typeCls = 'type-comment';
        if (item.itemType === 'message')             { typeLabel = 'Message';      typeCls = 'type-message'; }
        else if (item.commentType === 'mention')     { typeLabel = 'Mention';      typeCls = 'type-mention'; }
        else if (item.commentType === 'live_comment'){ typeLabel = 'Live Comment'; typeCls = 'type-comment'; }

        var subLine = '';
        if (item.itemType === 'message') {
            subLine = 'Direct message via <strong>' + escHtml(item.platform) + '</strong>';
        } else if (item.postId && item.postId.length > 0) {
            var shortPost = item.postId.length > 20 ? '…' + item.postId.slice(-12) : item.postId;
            subLine = 'Commented on post <strong>' + escHtml(shortPost) + '</strong>';
        } else {
            subLine = 'Page comment · <strong>' + escHtml(item.platform) + '</strong>';
        }

        var bodyHtml = (item.message || '').trim()
            ? escHtml(item.message)
            : '<em style="color:var(--muted);font-size:12px;">(no message text)</em>';

        var repliedTag = item.isReplied
            ? '<span style="font-size:10px;background:rgba(29,161,161,.1);color:#1DA1A1;padding:2px 7px;border-radius:4px;font-weight:600;margin-left:4px;">↩ Replied</span>'
            : '';

        var doneTag = isDone
            ? '<span style="font-size:10px;background:rgba(75,181,67,.1);color:var(--green);padding:2px 7px;border-radius:4px;font-weight:600;margin-left:4px;">✓ Done</span>'
            : '';

        return '<div class="msg-card" id="card-' + item.id + '">' +
            '<div class="msg-card-header">' +
                '<div class="msg-avatar" style="background:' + avatarColor(displayName) + '">' +
                    initials +
                    (platSvg ? '<div class="msg-platform-badge">' + platSvg + '</div>' : '') +
                '</div>' +
                '<div class="msg-avatar-info">' +
                    '<div class="msg-sender-name">' + escHtml(displayName) +
                        '&nbsp;<span class="msg-type-badge ' + typeCls + '">' + typeLabel + '</span>' +
                        repliedTag + doneTag +
                    '</div>' +
                    '<div class="msg-sender-sub">' + subLine + '</div>' +
                '</div>' +
                '<div class="msg-header-right"><span class="msg-time">' + timeAgo + '</span></div>' +
            '</div>' +
            '<div class="msg-body">' + bodyHtml + '</div>' +
            '<div class="msg-actions">' +
                '<div class="msg-action-left">' +
                    '<button class="ma-btn" onclick="openReply(' + item.id + ')">Reply</button>' +
                    '<a class="ma-btn" href="#" onclick="return false">View Thread</a>' +
                '</div>' +
                '<div class="msg-action-right">' +
                    '<div class="ma-icon" title="Like" onclick="toggleLike(this)">' +
                        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' +
                    '</div>' +
                    '<div class="ma-icon" title="Add label">' +
                        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>' +
                    '</div>' +
                    '<div class="ma-icon ' + (isDone ? 'done' : '') + '" title="Mark complete" onclick="markDone(' + item.id + ',this)">' +
                        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>' +
                    '</div>' +
                    '<div class="ma-icon ' + (isSaved ? 'done' : '') + '" title="Save message" onclick="toggleSave(' + item.id + ',this)">' +
                        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>' +
                    '</div>' +
                    '<div class="ma-icon" title="Assign">' +
                        '<svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    /* ── Card actions ─────────────────────────── */
    function markDone(id, el) {
        if (COMPLETED.has(id)) { COMPLETED.delete(id); el.classList.remove('done'); }
        else                   { COMPLETED.add(id);    el.classList.add('done'); }
        renderFeed();
    }
    function toggleSave(id, el) {
        if (SAVED.has(id)) { SAVED.delete(id); el.classList.remove('done'); }
        else               { SAVED.add(id);    el.classList.add('done'); }
    }
    function toggleLike(el) { el.classList.toggle('liked'); }

    /* ── Reply modal ──────────────────────────── */
    function openReply(id) {
        replyItem = ALL_ITEMS.find(function(x){ return x.id === id; });
        if (!replyItem) return;
        document.getElementById('replyTitle').textContent    = 'Reply to ' + (replyItem.senderName || '');
        document.getElementById('replyToName').textContent   = replyItem.senderName || '';
        document.getElementById('replyOriginal').textContent = '"' + (replyItem.message || '').slice(0, 120) + (replyItem.message && replyItem.message.length > 120 ? '…' : '') + '"';
        document.getElementById('replyText').value           = '';
        document.getElementById('replySendBtn').disabled     = true;
        document.getElementById('replyBackdrop').classList.add('open');
        setTimeout(function(){ document.getElementById('replyText').focus(); }, 100);
    }
    function closeReply() {
        document.getElementById('replyBackdrop').classList.remove('open');
        replyItem = null;
    }
    function sendReply() {
        var text = document.getElementById('replyText').value.trim();
        if (!text || !replyItem) return;
        /* TODO: wire to your API */
        alert('Reply sent to ' + replyItem.senderName + ': ' + text);
        closeReply();
    }

    /* ── Reload ───────────────────────────────── */
    function reloadInbox() {
        var btn = document.getElementById('reloadBtn');
        btn.classList.add('spinning'); btn.disabled = true;
        fetch('/Inbox/GetAll', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r){ return r.json(); })
            .then(function(data){ ALL_ITEMS = data; updateNavBadges(); renderFeed(); })
            .catch(function(){ alert('Reload failed.'); })
            .finally(function(){ btn.classList.remove('spinning'); btn.disabled = false; });
    }

    /* ══ FILTER POPUP ══════════════════════════ */
    function toggleFilterPopup() {
        var popup    = document.getElementById('filterPopup');
        var backdrop = document.getElementById('filterBackdrop');
        var isOpen   = popup.style.display === 'block';
        if (isOpen) {
            closeFilterPopup();
        } else {
            /* Position anchored to button */
            var btn  = document.getElementById('filterBtn');
            var rect = btn.getBoundingClientRect();
            popup.style.top   = (rect.bottom + 8) + 'px';
            popup.style.right = (window.innerWidth - rect.right) + 'px';
            popup.style.left  = 'auto';
            popup.style.display = 'block';
            backdrop.classList.add('open');
        }
    }

    function closeFilterPopup() {
        document.getElementById('filterPopup').style.display = 'none';
        document.getElementById('filterBackdrop').classList.remove('open');
    }

    function toggleTypePill(el) {
        el.classList.toggle('selected');
    }

    function applyFilters() {
        /* Read platforms */
        activeFilters.platforms = [];
        document.querySelectorAll('#filterPopup .fp-check-item input[type=checkbox]').forEach(function(cb){
            if (cb.checked) activeFilters.platforms.push(cb.value);
        });

        /* Read dates */
        activeFilters.dateFrom = document.getElementById('fp-date-from').value;
        activeFilters.dateTo   = document.getElementById('fp-date-to').value;

        /* Read types */
        activeFilters.types = [];
        document.querySelectorAll('#filterPopup .fp-type-pill.selected').forEach(function(p){
            activeFilters.types.push(p.dataset.type);
        });

        updateFilterBadge();
        closeFilterPopup();
        renderFeed();   /* <-- triggers getFiltered() which now includes all filter logic */
    }

    function clearFilters() {
        document.querySelectorAll('#filterPopup .fp-check-item input[type=checkbox]').forEach(function(cb){ cb.checked = false; });
        document.getElementById('fp-date-from').value = '';
        document.getElementById('fp-date-to').value   = '';
        document.querySelectorAll('#filterPopup .fp-type-pill').forEach(function(p){ p.classList.remove('selected'); });

        activeFilters = { platforms: [], dateFrom: '', dateTo: '', types: [] };
        updateFilterBadge();
        closeFilterPopup();
        renderFeed();
    }

    function updateFilterBadge() {
        var count = activeFilters.platforms.length
                  + (activeFilters.dateFrom || activeFilters.dateTo ? 1 : 0)
                  + activeFilters.types.length;
        var dot = document.getElementById('filterDot');
        dot.textContent = count;
        if (count > 0) dot.classList.add('show');
        else           dot.classList.remove('show');
    }

    /* ── Helpers ──────────────────────────────── */
    var AVATAR_COLORS = ['#6c5ce7','#e17055','#00b894','#0984e3','#e84393','#fdcb6e','#d63031'];
    function avatarColor(name) {
        var h = 0;
        for (var i = 0; i < (name || '').length; i++) h = (h * 31 + (name || '').charCodeAt(i)) & 0xffffffff;
        return AVATAR_COLORS[Math.abs(h) % AVATAR_COLORS.length];
    }
    function formatTime(t) {
        if (!t) return '';
        var d    = new Date(t);
        var now  = new Date();
        var diff = Math.floor((now - d) / 1000);
        if (diff < 60)    return diff + 's ago';
        if (diff < 3600)  return Math.floor(diff / 60) + 'm ago';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    }
    function escHtml(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>