@using SocialMediaPanel.Models
@model List<LinkedInLead>
@{
    ViewData["Title"] = "LinkedIn Leads";
    ViewData["PageTitle"] = "LinkedIn Leads";
    var integration = ViewBag.Integration as LinkedInIntegration;
    var allIntegrations = ViewBag.AllIntegrations as List<LinkedInIntegration> ?? new();
    var organizations = ViewBag.Organizations as List<(string Urn, string Name, string? LogoUrl)> ?? new();
    var subscriptions = ViewBag.Subscriptions as List<LinkedInLeadSubscription> ?? new();
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;
}

<style>
    .li-page-wrap2 { max-width: 1000px; margin: 0 auto; }
    .li-alert { padding: 12px 18px; border-radius: 10px; font-size: 13px; margin-bottom: 18px; }
    .li-alert.success { background: rgba(10,102,194,.08); border: 1px solid rgba(10,102,194,.3); color: #0a66c2; }
    .li-alert.error { background: #fff0f0; border: 1px solid #ffcdd2; color: #c62828; }
    .li-panel { background: #fff; border: 1px solid #e2e8e4; border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,.04); margin-bottom: 20px; }
    .li-panel h3 { font-family:'Sora',sans-serif; font-size: 15px; margin: 0 0 14px; }
    .li-form-row { margin-bottom: 12px; }
    .li-form-row label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 5px; }
    .li-form-row select, .li-form-row input { width: 100%; padding: 9px 12px; border: 1.5px solid #e2e8e4; border-radius: 8px; font-size: 13px; box-sizing: border-box; }
    .btn-li-primary { padding: 10px 20px; background: #0a66c2; color: #fff; border: none; border-radius: 9px; font-size: 13px; font-weight: 700; cursor: pointer; }
    .li-sub-row { font-size: 12px; padding: 8px 0; border-bottom: 1px solid #f0f2f0; }
    .li-sub-status { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px; text-transform: uppercase; }
    .li-sub-status.registered { background: rgba(37,211,102,.12); color: #1a8a45; }
    .li-sub-status.failed { background: #fff0f0; color: #c62828; }
    .li-lead-row { padding: 12px 0; border-bottom: 1px solid #f0f2f0; font-size: 12.5px; }
    .li-lead-id { font-family: monospace; font-size: 11px; color: #6b7d74; }
    .li-empty { text-align: center; padding: 40px 20px; color: #6b7d74; font-size: 12.5px; }
    details.li-raw summary { cursor: pointer; color: #0a66c2; font-size: 11.5px; font-weight: 600; margin-top: 6px; }
    details.li-raw pre { font-size: 10.5px; background: #f6f8f7; padding: 10px; border-radius: 8px; overflow-x: auto; max-height: 200px; }
</style>

<div class="li-page-wrap2">
    @await Html.PartialAsync("_SubNav")

    @if (success != null) { <div class="li-alert success">✅ @success</div> }
    @if (error != null) { <div class="li-alert error">⚠️ @error</div> }

    @if (integration == null)
    {
        <div class="li-panel"><div class="li-empty">Connect LinkedIn first from the <a href="/LinkedIn/Index">Dashboard</a>.</div></div>
    }
    else
    {
        <div class="li-panel">
            <h3>📡 Lead Notification Webhook</h3>
            <p style="font-size:12px;color:#6b7d74;margin-top:-8px;">Registers <code>https://social.go2market.in:8080/linkedin/webhook</code> to receive real-time leads for the selected organization.</p>
            @if (!organizations.Any())
            {
                <div class="li-empty">No organization pages found on this LinkedIn account (needs Page Admin role).</div>
            }
            else
            {
                <form asp-action="RegisterLeadWebhook" asp-controller="LinkedIn" method="post">
                    <input type="hidden" name="id" value="@integration.Id" />
                    <div class="li-form-row">
                        <label>Organization</label>
                        <select name="organizationUrn">
                            @foreach (var org in organizations)
                            {
                                <option value="@org.Urn">@org.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn-li-primary">Register Webhook</button>
                </form>
            }

            @if (subscriptions.Any())
            {
                <div style="margin-top:16px;">
                    <strong style="font-size:12px;">Registered Subscriptions</strong>
                    @foreach (var s in subscriptions)
                    {
                        <div class="li-sub-row">@s.OwnerUrn — <span class="li-sub-status @s.Status">@s.Status</span> @(s.Status == "failed" ? " — " + s.ErrorMessage : "")</div>
                    }
                </div>
            }
        </div>
    }

    <div class="li-panel">
        <h3>👥 Leads (@Model.Count)</h3>
        @if (!Model.Any())
        {
            <div class="li-empty">No leads received yet. Once someone submits a Lead Gen Form on a connected page, it'll show up here.</div>
        }
        else
        {
            @foreach (var lead in Model)
            {
                <div class="li-lead-row">
                    <div class="li-lead-id">@lead.LeadId</div>
                    <div>@(lead.Name ?? "—") @(lead.Email != null ? " · " + lead.Email : "") @(lead.Phone != null ? " · " + lead.Phone : "")</div>
                    <div style="color:#6b7d74;font-size:11px;">@lead.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                    @if (!string.IsNullOrEmpty(lead.RawJson))
                    {
                        <details class="li-raw">
                            <summary>View raw answers</summary>
                            <pre>@lead.RawJson</pre>
                        </details>
                    }
                </div>
            }
        }
    </div>
</div>
