                    Connect with LinkedIn
                </a>

                <div class="li-hero-benefits">
                    <div class="li-hero-benefit">
                        <div class="li-hero-benefit-icon">
                            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><line x1="12" y1="20" x2="12" y2="10" /><line x1="18" y1="20" x2="18" y2="4" /><line x1="6" y1="20" x2="6" y2="16" /></svg>
