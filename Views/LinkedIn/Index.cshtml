@using SocialMediaPanel.Models
@using System.Text.Json
@{
    ViewData["Title"] = "LinkedIn";
    ViewData["PageTitle"] = "LinkedIn";

    var integration = ViewBag.Integration as LinkedInIntegration;
    var posts = ViewBag.Posts as List<LinkedinPosts> ?? new();
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;

    bool connected = integration != null;
    bool hasProfile = ViewBag.HasProfile ?? false;
    bool hasPosting = ViewBag.HasPosting ?? false;
    bool hasOrgAccess = ViewBag.HasOrgAccess ?? false;
    bool hasLeadsAccess = ViewBag.HasLeadsAccess ?? false;
    bool hasEventsAccess = ViewBag.HasEventsAccess ?? false;
    bool hasAdsAccess = ViewBag.HasAdsAccess ?? false;

    var organizations = ViewBag.Organizations as List<(string Urn, string Name, string? LogoUrl)> ?? new();
    var leads = ViewBag.Leads as List<Dictionary<string, JsonElement>> ?? new();
}
<style>
    body.li-page .page-content {
        overflow-y: auto;
        background: #fafbfc;
    }

    .li-page-wrap {
        display: flex;
        flex-direction: column;
        gap: 18px;
        max-width: 960px;
        margin: 0 auto;
    }

    /* ── Profile header — simple, no action buttons ─────────── */
    .li-profile-bar {
        display: flex;
        align-items: center;
        gap: 16px;
        background: linear-gradient(135deg,#0A66C2 0%,#0d7fe8 100%);
        border-radius: 18px;
        padding: 22px 26px;
        color: #fff;
        box-shadow: 0 8px 24px rgba(10,102,194,.18);
    }

    .li-pb-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        flex-shrink: 0;
        background: rgba(255,255,255,.18);
        border: 2px solid rgba(255,255,255,.35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        overflow: hidden;
    }

        .li-pb-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .li-pb-info {
        flex: 1;
        min-width: 0;
    }

    .li-pb-name {
        font-size: 16px;
        font-weight: 700;
        line-height: 1.3;
    }

    .li-pb-email {
        font-size: 12.5px;
        opacity: .85;
        margin-top: 1px;
    }

    .li-pb-badges {
        display: flex;
        gap: 6px;
        margin-top: 8px;
        flex-wrap: wrap;
    }

    .li-pb-badge {
        font-size: 10.5px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
        background: rgba(255,255,255,.18);
        color: #fff;
    }

    .li-pb-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        flex-shrink: 0;
        background: rgba(255,255,255,.15);
        padding: 5px 12px;
        border-radius: 20px;
    }

    .li-pb-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        flex-shrink: 0;
    }

    /* Not-connected bar variant */
    .li-profile-bar.disc {
        background: var(--surface, #fff);
        border: 1px dashed var(--border);
        color: var(--text);
        box-shadow: none;
    }

        .li-profile-bar.disc .li-pb-avatar {
            background: #f4f5f7;
            border-color: var(--border);
        }

            .li-profile-bar.disc .li-pb-avatar svg {
                fill: #0A66C2;
                opacity: .5;
            }

        .li-profile-bar.disc .li-pb-name {
            color: var(--text);
        }

        .li-profile-bar.disc .li-pb-email {
            color: var(--muted);
            opacity: 1;
        }

            .li-profile-bar.disc .li-pb-email a {
                color: #0A66C2;
                font-weight: 600;
                text-decoration: none;
            }

                .li-profile-bar.disc .li-pb-email a:hover {
                    text-decoration: underline;
                }

        .li-profile-bar.disc .li-pb-status {
            background: rgba(220,53,69,.08);
            color: #dc3545;
        }

            .li-profile-bar.disc .li-pb-status .li-pb-status-dot {
                background: #dc3545;
            }

    /* ── Disconnected hero — replaces the plain "connect from the
       Dashboard" bar with a proper in-page connect flow, matching the
       Twitter page's pattern (own Connect button, benefit highlights). ── */
    .li-hero {
        max-width: 780px;
        margin: 24px auto 0;
    }

    .li-hero-card {
        background: linear-gradient(180deg, #fff 0%, #fafbfd 100%);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 52px 40px 44px;
        text-align: center;
        box-shadow: 0 8px 28px rgba(15,23,42,.06);
        position: relative;
        overflow: hidden;
    }

        .li-hero-card::before {
            content: '';
            position: absolute;
            top: -60px;
            left: 50%;
            transform: translateX(-50%);
            width: 340px;
            height: 200px;
            background: radial-gradient(circle, rgba(10,102,194,.14) 0%, rgba(10,102,194,0) 70%);
            pointer-events: none;
        }

    .li-hero-icon {
        width: 76px;
        height: 76px;
        background: linear-gradient(135deg, #0A66C2, #0d7fe8);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        box-shadow: 0 10px 24px rgba(10,102,194,.30);
        position: relative;
    }

        .li-hero-icon svg {
            width: 36px;
            height: 36px;
            fill: white;
        }

    .li-hero-card h2 {
        font-family: 'Sora', sans-serif;
        font-size: 25px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 10px;
        position: relative;
    }

    .li-hero-card > p {
        font-size: 14.5px;
        color: var(--muted);
        line-height: 1.6;
        margin: 0 auto 30px;
        max-width: 420px;
        position: relative;
    }

    .btn-connect-linkedin {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 30px;
        background: #0A66C2;
        border: none;
        border-radius: 11px;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        text-decoration: none;
        transition: transform .15s, box-shadow .15s;
        box-shadow: 0 6px 16px rgba(10,102,194,.32);
        position: relative;
    }

        .btn-connect-linkedin:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(10,102,194,.4);
        }

        .btn-connect-linkedin svg {
            width: 18px;
            height: 18px;
            fill: white;
        }

    .li-hero-benefits {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 36px;
        padding-top: 32px;
        border-top: 1px solid var(--border);
        position: relative;
    }

    .li-hero-benefit {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 4px 8px;
    }

    .li-hero-benefit-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(10,102,194,.10);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .li-hero-benefit-icon svg {
            width: 20px;
            height: 20px;
            stroke: #0A66C2;
            fill: none;
        }

    .li-hero-benefit strong {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--text);
        font-family: 'Sora', sans-serif;
    }

    .li-hero-benefit span {
        font-size: 11.5px;
        color: var(--muted);
        line-height: 1.5;
    }

    /* ── Dashboard-style stats bar ──────────────── */
    .li-stats-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .li-stat-card {
        background: var(--surface, #fff);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        transition: transform .15s, box-shadow .15s;
    }

        .li-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

    .li-stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .li-stat-icon svg {
            width: 22px;
            height: 22px;
        }

        .li-stat-icon.blue { background: rgba(10,102,194,.12); }
        .li-stat-icon.blue svg { fill: #0A66C2; }

        .li-stat-icon.green { background: rgba(75,181,67,.12); }
        .li-stat-icon.green svg { stroke: var(--accent, var(--green)); fill: none; }

        .li-stat-icon.red { background: rgba(239,68,68,.12); }
        .li-stat-icon.red svg { stroke: #ef4444; fill: none; }

        .li-stat-icon.purple { background: rgba(108,92,231,.12); }
        .li-stat-icon.purple svg { stroke: #6c5ce7; fill: none; }

    .li-stat-info {
        min-width: 0;
    }

    .li-stat-value {
        font-family: 'Sora', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .li-stat-label {
        font-size: 11.5px;
        color: var(--muted);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── 3-column dashboard layout (LinkedIn-style) ──────────── */
    .li-3col {
        display: grid;
        grid-template-columns: 225px 1fr 280px;
        gap: 20px;
        align-items: start;
    }
    @@media (max-width: 980px) { .li-3col { grid-template-columns: 1fr; } }
    .li-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

    .li-profile-card2 { background: var(--surface, #fff); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    .li-profile-cover { height: 44px; background: linear-gradient(120deg,#0a66c2,#78b5e8); }
    .li-profile-card2-body { padding: 0 14px 14px; margin-top: -22px; }
    .li-profile-card2-avatar {
        width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--surface, #fff);
        background: #cfe0f2; display: flex; align-items: center; justify-content: center;
        font-weight: 800; color: #0a66c2; font-size: 20px; overflow: hidden;
    }
        .li-profile-card2-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .li-profile-card2-body h3 { font-size: 14.5px; margin: 8px 0 2px; color: var(--text); }
    .li-profile-card2-body p { font-size: 11.5px; color: var(--muted); margin: 0 0 10px; }
    .li-profile-card2-badges { display: flex; gap: 5px; flex-wrap: wrap; }
    .li-pc-badge { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: rgba(10,102,194,.1); color: #0a66c2; }

    .li-quick-card { background: var(--surface, #fff); border: 1px solid var(--border); border-radius: 10px; padding: 6px; }
    .li-quick-link {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 10px 10px; border-radius: 7px; text-decoration: none; color: var(--text);
        font-size: 12.5px; font-weight: 600;
    }
    .li-quick-link:hover { background: rgba(10,102,194,.06); color: #0a66c2; }
    .li-quick-link .cnt { font-size: 11px; color: var(--muted); font-weight: 600; }

    .li-insight-card { background: var(--surface, #fff); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }
    .li-insight-card h4 { font-size: 13px; margin: 0 0 10px; color: var(--text); }
    .li-insight-row { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--muted); padding: 5px 0; }
    .li-insight-row b { color: var(--text); font-weight: 700; }

    .li-mini-notice { background: var(--surface, #fff); border: 1px solid var(--border); border-radius: 10px; padding: 14px; }
    .li-mini-notice h4 { font-size: 12.5px; margin: 0 0 4px; color: var(--text); }
    .li-mini-notice p { font-size: 11.5px; color: var(--muted); line-height: 1.5; margin: 0 0 8px; }
    .li-mini-notice a { font-size: 11.5px; color: #0a66c2; font-weight: 700; text-decoration: none; }
    .li-mini-notice.ready { border-color: rgba(10,102,194,.25); background: rgba(10,102,194,.04); }

    /* ── Cards ──────────────────────────────────── */
    .li-card {
        background: var(--surface, #fff);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
    }

    .li-card-head {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .li-card-head h3 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }

    .li-card-body {
        padding: 20px;
    }

    /* ── Compose box ─────────────────────────────── */
    .li-compose {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .li-textarea {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 13px;
        font-family: 'DM Sans',sans-serif;
        color: var(--text);
        resize: none;
        outline: none;
        min-height: 100px;
        transition: border-color .15s;
        line-height: 1.5;
    }

        .li-textarea:focus {
            border-color: #0A66C2;
            box-shadow: 0 0 0 3px rgba(10,102,194,.1);
        }

    .li-input {
        width: 100%;
        padding: 9px 14px;
        border: 1px solid var(--border);
        border-radius: 9px;
        font-size: 13px;
        font-family: 'DM Sans',sans-serif;
        color: var(--text);
        outline: none;
        background: var(--surface, #fff);
        transition: border-color .15s;
    }

        .li-input:focus {
            border-color: #0A66C2;
        }

        .li-input::placeholder {
            color: var(--muted);
        }

    .li-file-label {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        background: #f4f5f7;
        border: 1px dashed var(--border);
        border-radius: 9px;
        font-size: 12px;
        color: var(--muted);
        cursor: pointer;
        transition: border-color .15s,background .15s;
    }

        .li-file-label:hover {
            border-color: #0A66C2;
            color: #0A66C2;
            background: #f0f6ff;
        }

        .li-file-label svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
        }

    .li-file-name {
        font-size: 11px;
        color: var(--muted);
        margin-top: 2px;
        padding-left: 2px;
    }

    .li-char-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .li-char-count {
        font-size: 11px;
        color: var(--muted);
    }

        .li-char-count.warn {
            color: #e6a817;
        }

        .li-char-count.over {
            color: #dc3545;
            font-weight: 700;
        }

    .li-post-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 12px;
        background: #0A66C2;
        border: none;
        border-radius: 9px;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(10,102,194,.28);
        transition: transform .15s, box-shadow .15s;
    }

        .li-post-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(10,102,194,.36);
        }

        .li-post-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .li-post-btn svg {
            width: 14px;
            height: 14px;
            stroke: #fff;
            fill: none;
        }

    .li-toast {
        display: none;
        align-items: center;
        gap: 10px;
        padding: 11px 16px;
        border-radius: 9px;
        font-size: 13px;
    }

        .li-toast.success {
            display: flex;
            background: rgba(75,181,67,.1);
            border: 1px solid rgba(75,181,67,.3);
            color: #2d7a27;
        }

        .li-toast.error {
            display: flex;
            background: #fff0f0;
            border: 1px solid #ffcdd2;
            color: #c62828;
        }

    /* ── Post history — individually elevated cards, not one boxed
       list with divider lines, to match Reports/Inbox's card language ── */
    .li-history-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .li-history-wrap .li-card-head {
            padding: 4px 4px 2px;
            border-bottom: none;
        }

    .li-post-row {
        padding: 16px 18px;
        background: var(--surface, #fff);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: 0 1px 4px rgba(0,0,0,.03);
        display: flex;
        gap: 12px;
        align-items: flex-start;
        transition: transform .12s, box-shadow .12s, border-color .12s;
    }

        .li-post-row:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0,0,0,.08);
            border-color: rgba(10,102,194,.3);
        }

    .li-post-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .li-post-icon.posted {
            background: rgba(10,102,194,.10);
        }

            .li-post-icon.posted svg {
                fill: #0A66C2;
            }

        .li-post-icon.failed {
            background: #fff0f0;
        }

            .li-post-icon.failed svg {
                stroke: #c62828;
                fill: none;
            }

        .li-post-icon svg {
            width: 16px;
            height: 16px;
        }

    .li-post-body {
        flex: 1;
        min-width: 0;
    }

    .li-post-text {
        font-size: 13px;
        color: var(--text);
        line-height: 1.5;
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .li-post-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .li-post-status {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 20px;
    }

        .li-post-status.posted {
            background: rgba(75,181,67,.1);
            color: var(--accent, var(--green));
        }

        .li-post-status.failed {
            background: #fff0f0;
            color: #c62828;
        }

    .li-post-date {
        font-size: 11px;
        color: var(--muted);
    }

    .li-post-link {
        font-size: 11px;
        color: #0A66C2;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 3px;
    }

        .li-post-link svg {
            width: 10px;
            height: 10px;
            stroke: currentColor;
            fill: none;
        }

    /* ── Org pages ────────────────────────────────── */
    .li-org-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        border-bottom: 1px solid var(--border);
    }

        .li-org-row:last-child {
            border-bottom: none;
        }

    .li-org-logo {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        flex-shrink: 0;
        background: rgba(10,102,194,.08);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .li-org-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .li-org-logo svg {
            width: 18px;
            height: 18px;
            fill: #0A66C2;
        }

    .li-org-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
    }

    .li-org-urn {
        font-size: 11px;
        color: var(--muted);
        font-family: monospace;
    }

    /* ── Leads list ─────────────────────────────────── */
    .li-leads-list {
        display: flex;
        flex-direction: column;
    }

    .li-lead-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        transition: background .12s;
    }

        .li-lead-row:last-child {
            border-bottom: none;
        }

        .li-lead-row:hover {
            background: #fafbfc;
        }

    .li-lead-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        flex-shrink: 0;
        background: linear-gradient(135deg,#0A66C2,#0a8fd6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
    }

    .li-lead-main {
        flex: 1;
        min-width: 0;
    }

    .li-lead-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 6px;
    }

    .li-lead-tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .li-lead-tag {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 20px;
        background: #f4f5f7;
        color: var(--muted);
    }

        .li-lead-tag.form {
            background: rgba(10,102,194,.08);
            color: #0A66C2;
        }

    .li-lead-date {
        font-size: 11px;
        color: var(--muted);
        flex-shrink: 0;
        white-space: nowrap;
    }

    /* ── Empty / gated states ──────────────────────── */
    .li-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 44px 24px;
        text-align: center;
    }

        .li-empty svg {
            width: 44px;
            height: 44px;
            stroke: var(--muted);
            fill: none;
            opacity: .3;
            margin-bottom: 12px;
        }

        .li-empty h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }

        .li-empty p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.6;
            max-width: 340px;
        }

        .li-empty.no-permission svg {
            opacity: .35;
            stroke: #e6a817;
        }

        .li-empty.no-permission h4 {
            color: #7a6000;
        }
</style>

@* ── Banners ─────────────────────────────────── *@
@if (success != null)
{
    <div style="background:rgba(75,181,67,.1);border:1px solid rgba(75,181,67,.3);color:#2d7a27;
                        border-radius:10px;padding:12px 18px;margin-bottom:18px;font-size:13px;max-width:760px;margin-left:auto;margin-right:auto;
                        display:flex;align-items:center;justify-content:space-between;">
        <span>✓ @success</span>
        <button onclick="this.parentElement.remove()"
                style="background:none;border:none;cursor:pointer;color:inherit;font-size:16px;">
            ✕
        </button>
    </div>
}
@if (error != null)
{
    <div style="background:#fff0f0;border:1px solid #ffcdd2;color:#c62828;
                        border-radius:10px;padding:12px 18px;margin-bottom:18px;font-size:13px;max-width:760px;margin-left:auto;margin-right:auto;
                        display:flex;align-items:center;justify-content:space-between;">
        <span>⚠️ @error</span>
        <button onclick="this.parentElement.remove()"
                style="background:none;border:none;cursor:pointer;color:inherit;font-size:16px;">
            ✕
        </button>
    </div>
}

<div class="li-page-wrap">
    @await Html.PartialAsync("_SubNav")

    @* ── Simple profile header — name, email, status. No connect/disconnect buttons. ── *@
    @if (connected)
    {
        <div class="li-3col">
        <div class="li-col">
            <div class="li-profile-card2">
                <div class="li-profile-cover"></div>
                <div class="li-profile-card2-body">
                    <div class="li-profile-card2-avatar">
                        @if (hasProfile && !string.IsNullOrEmpty(integration!.ProfilePicture))
                        {
                            <img src="@integration.ProfilePicture" alt="@integration.DisplayName" />
                        }
                        else
                        {
                            @((hasProfile ? integration!.DisplayName : "?").Substring(0, 1).ToUpper())
                        }
                    </div>
                    <h3>@(hasProfile ? integration!.DisplayName : "LinkedIn Account")</h3>
                    <p>@(hasProfile ? (integration!.Email ?? "") : "Profile permission not granted")</p>
                    <div class="li-profile-card2-badges">
                        <span class="li-pc-badge" style="background:rgba(37,211,102,.12);color:#1a8a45;">● Connected</span>
                        @if (hasProfile) { <span class="li-pc-badge">Profile</span> }
                        @if (hasPosting) { <span class="li-pc-badge">Posting</span> }
                        @if (hasOrgAccess) { <span class="li-pc-badge">Org Pages</span> }
                        @if (hasLeadsAccess) { <span class="li-pc-badge">Leads</span> }
                    </div>
                </div>
            </div>

            <div class="li-quick-card">
                <a href="/LinkedIn/Leads" class="li-quick-link">📋 Leads <span class="cnt">@leads.Count</span></a>
                <a href="/LinkedIn/Events" class="li-quick-link">📅 Events</a>
                <a href="/LinkedIn/Conversions" class="li-quick-link">🎯 Conversions</a>
                <a href="/LinkedIn/Settings" class="li-quick-link">⚙️ Settings</a>
            </div>

            @if (hasOrgAccess && organizations.Any())
            {
                <div class="li-quick-card" style="padding:10px;">
                    <div style="font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;padding:2px 6px 8px;">Organization Pages</div>
                    @foreach (var org in organizations)
                    {
                        <div class="li-org-row">
                            <div class="li-org-logo">
                                @if (!string.IsNullOrEmpty(org.LogoUrl))
                                {
                                    <img src="@org.LogoUrl" alt="@org.Name" />
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="14" rx="2" /></svg>
                                }
                            </div>
                            <div>
                                <div class="li-org-name">@org.Name</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="li-col">
        @* ── Create Post — or a no-permission notice if posting isn't granted ── *@
        <div class="li-card">
            <div class="li-card-head"><h3>Create Post</h3></div>

            @if (hasPosting)
            {
                <div class="li-card-body">
                    <div class="li-compose">
                        <div>
                            <textarea class="li-textarea" id="liPostText"
                              placeholder="What do you want to talk about?"
                              oninput="liUpdateChar()"></textarea>
                            <div class="li-char-row">
                                <span></span>
                                <span class="li-char-count" id="liCharCount">0 / 3000</span>
                            </div>
                        </div>

                        <input type="text" class="li-input" id="liArticleUrl"
                               placeholder="Article / link URL (optional)">

                        <div>
                            <label class="li-file-label" for="liImageFile">
                                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                                    <rect x="3" y="3" width="18" height="18" rx="2" />
                                    <circle cx="8.5" cy="8.5" r="1.5" />
                                    <polyline points="21 15 16 10 5 21" />
                                </svg>
                                Attach image (optional)
                            </label>
