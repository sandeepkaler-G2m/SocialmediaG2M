@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Welcome, " + (ViewBag.UserName as string ?? "User") + "! 👋";

    var integrationSuccess = TempData["IntegrationSuccess"] as string;
    var integrationError = TempData["IntegrationError"] as string;
    var fbPageName = TempData["FacebookPageName"] as string;
}

@if (integrationError != null)
{
    <div id="intErrBanner" style="background:#fff0f0;border:1px solid #ffcdd2;border-radius:10px;
             padding:12px 18px;margin-bottom:16px;font-size:13px;color:#c62828;
             display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <span>❌ @integrationError</span>
        <button onclick="this.parentElement.remove()"
                style="background:none;border:none;cursor:pointer;color:#c62828;font-size:16px;">
            ✕
        </button>
    </div>
}
@if (integrationSuccess != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.PlatformAuth) {
                    PlatformAuth.openSuccess('@integrationSuccess', '@Html.Raw(fbPageName ?? integrationSuccess)');
                }
            }, 400);
        });
    </script>
}

<style>
    /* ── Shared ─────────────────────────────────────── */
    .sec-title {
        font-family: 'Sora',sans-serif;
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .sec-subtitle {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 18px;
    }

    /* ── Integrations strip ─────────────────────────── */
    .integ-section {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 22px 24px;
        margin-bottom: 20px;
    }

    .integ-strip {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .integ-icon-btn {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: border-color .15s,box-shadow .15s;
        padding: 6px;
        flex-shrink: 0;
    }

        .integ-icon-btn img {
            width: 26px;
            height: 26px;
            object-fit: contain;
        }

        .integ-icon-btn svg {
            width: 24px;
            height: 24px;
        }

        .integ-icon-btn:hover {
            border-color: var(--green);
            box-shadow: 0 2px 8px rgba(75,181,67,.15);
        }

    .browse-btn {
        padding: 8px 18px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
        transition: border-color .15s,background .15s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .browse-btn:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .browse-btn svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
        }

    /* ── Browse modal overlay ───────────────────────── */
    .browse-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 400;
        align-items: flex-start;
        justify-content: center;
        padding-top: 60px;
    }

        .browse-backdrop.open {
            display: flex;
        }

    .browse-modal {
        background: #f4f5f7;
        border-radius: 18px;
        width: 860px;
        max-width: calc(100vw - 32px);
        max-height: calc(100vh - 100px);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,.22);
        animation: bsIn .18s ease;
    }


    .browse-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px 16px;
        background: #fff;
        border-bottom: 1px solid var(--border);
        flex-shrink: 0;
    }

        .browse-modal-head h2 {
            font-family: 'Sora',sans-serif;
            font-size: 18px;
            font-weight: 700;
            color: var(--text);
        }

    .browse-close {
        width: 32px;
        height: 32px;
        background: #f4f5f7;
        border: none;
        border-radius: 8px;
        font-size: 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
    }

        .browse-close:hover {
            background: #e3e6ea;
            color: var(--text);
        }

    .browse-body {
        overflow-y: auto;
        padding: 24px 28px;
        flex: 1;
    }

    .browse-sub {
        font-family: 'Sora',sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .browse-desc {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 20px;
    }

    /* ── Platform cards grid ────────────────────────── */
    .plat-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 14px;
        margin-bottom: 28px;
    }

    .plat-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        transition: box-shadow .15s,border-color .15s;
        display: flex;
        flex-direction: column;
    }

        .plat-card:hover {
            box-shadow: 0 4px 18px rgba(0,0,0,.1);
            border-color: #ccc;
        }

    .plat-card-logo {
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fafafa;
        border-bottom: 1px solid var(--border);
    }

        .plat-card-logo svg {
            width: 52px;
            height: 52px;
        }

        .plat-card-logo .logo-wrap {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .plat-card-body {
        padding: 16px 18px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

        .plat-card-body h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }

        .plat-card-body p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.6;
            flex: 1;
            margin-bottom: 14px;
        }

    .plat-conn-btn {
        width: 100%;
        padding: 9px;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
        transition: opacity .15s;
        color: #fff;
        margin-bottom: 8px;
    }

        .plat-conn-btn:hover {
            opacity: .88;
        }

        .plat-conn-btn.connected {
            background: #4BB543;
        }

    .plat-learn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        font-size: 12px;
        color: var(--muted);
        text-decoration: none;
        transition: color .15s;
    }

        .plat-learn:hover {
            color: var(--text);
        }

        .plat-learn svg {
            width: 11px;
            height: 11px;
            stroke: currentColor;
            fill: none;
        }

    /* ── Dashboard two-column ───────────────────────── */
    .act-label {
        font-family: 'Sora',sans-serif;
        font-size: 16px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 14px;
    }

    .db-grid {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 18px;
        align-items: start;
    }

    .db-left {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Publishing card */
    .pub-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .pub-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px 14px;
        border-bottom: 1px solid var(--border);
    }

        .pub-card-header h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

        .pub-card-header a {
            font-size: 12px;
            color: var(--green);
            font-weight: 600;
            text-decoration: none;
        }

            .pub-card-header a:hover {
                text-decoration: underline;
            }

    .pub-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 32px 24px;
        text-align: center;
    }

    .pub-empty-icon {
        width: 56px;
        height: 56px;
        margin-bottom: 14px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pub-empty-icon .icon-bg {
            width: 44px;
            height: 44px;
            background: #f0f0f0;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pub-empty-icon .icon-badge {
            position: absolute;
            top: 0;
            right: 0;
            width: 22px;
            height: 22px;
            background: var(--green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

            .pub-empty-icon .icon-badge svg {
                width: 10px;
                height: 10px;
                stroke: white;
                fill: none;
            }

    .pub-empty h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
    }

    .pub-empty p {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .compose-btn {
        padding: 9px 20px;
        background: var(--text);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
    }

        .compose-btn:hover {
            background: #2d3a4a;
        }

    /* To Do */
    .todo-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .todo-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    .todo-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 18px;
        border-bottom: 1px solid var(--border);
    }

        .todo-item:last-child {
            border-bottom: none;
        }

    .todo-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .todo-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .todo-icon svg {
            width: 14px;
            height: 14px;
            stroke: var(--muted);
            fill: none;
        }

    .todo-count {
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
        min-width: 28px;
    }

    .todo-link {
        font-size: 12px;
        color: var(--green);
        font-weight: 600;
        text-decoration: none;
    }

        .todo-link:hover {
            text-decoration: underline;
        }

    /* Recent posts */
    .db-right {
        display: flex;
        flex-direction: column;
    }

    .recent-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .recent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px 14px;
        border-bottom: 1px solid var(--border);
    }

        .recent-header h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

    .sort-select {
        padding: 6px 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 12px;
        color: var(--text);
        font-family: 'DM Sans',sans-serif;
        cursor: pointer;
    }

    .recent-empty {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .recent-empty-left {
        border-right: 1px solid var(--border);
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 260px;
    }

    .post-preview-card {
        background: #f8f9fb;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        position: relative;
    }

    .post-preview-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e0e0e0;
        margin-bottom: 10px;
    }

    .post-preview-line {
        height: 8px;
        border-radius: 4px;
        background: #e0e0e0;
        margin-bottom: 6px;
    }

        .post-preview-line.short {
            width: 60%;
        }

        .post-preview-line.medium {
            width: 80%;
        }

    .post-preview-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 22px;
        height: 22px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
    }

    .post-preview-stats {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--muted);
    }

        .post-preview-stats svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    .recent-empty-right {
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .recent-empty-right h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .recent-empty-right p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.6;
        }

        .recent-empty-right a {
            color: var(--green);
            font-weight: 600;
            text-decoration: none;
        }

            .recent-empty-right a:hover {
                text-decoration: underline;
            }

    .recent-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        border-top: 1px solid var(--border);
        background: #fafbfc;
    }

        .recent-footer span {
            font-size: 11px;
            color: var(--muted);
        }

    .report-btn {
        padding: 7px 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        font-family: 'DM Sans',sans-serif;
    }

        .report-btn:hover {
            background: #f4f5f7;
        }


    .tb-btn-filter-wrap {
        position: relative;
        display: inline-flex;
    }

    .tb-btn-filter {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: border-color .15s;
    }

        .tb-btn-filter:hover {
            border-color: var(--green);
            color: var(--green);
        }

        .tb-btn-filter svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
        }

    .filter-active-dot {
        display: none;
        position: absolute;
        top: -5px;
        right: -5px;
        width: 16px;
        height: 16px;
        background: var(--green);
        color: #fff;
        border-radius: 50%;
        font-size: 9px;
        font-weight: 700;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
    }

        .filter-active-dot.show {
            display: flex;
        }


    /* ══ FILTER POPUP ══ */
    .fp-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 400;
    }

        .fp-backdrop.open {
            display: block;
        }

    .fp-popup {
        position: fixed;
        width: 290px;
        background: #fff;
        border: 1px solid #e2e4e9;
        border-radius: 14px;
        box-shadow: 0 8px 32px rgba(0,0,0,.13);
        z-index: 401;
        display: none;
        overflow: hidden;
    }

    .fp-head2 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid #eee;
    }

        .fp-head2 h4 {
            font-size: 13px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

    .fp-close2 {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 14px;
        color: #aaa;
        padding: 0;
    }

    .fp-sec {
        padding: 10px 16px;
        border-bottom: 1px solid #eee;
    }

    .fp-sec-lbl {
        font-size: 10px;
        font-weight: 700;
        color: #aaa;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .fp-chk-grp {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .fp-chk-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #333;
        cursor: pointer;
        user-select: none;
    }

        .fp-chk-item input {
            width: 13px;
            height: 13px;
            accent-color: var(--green);
            cursor: pointer;
            flex-shrink: 0;
        }

    .fp-plat-ico {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .fp-date-row {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .fp-date-row label {
            font-size: 11px;
            color: #aaa;
            min-width: 26px;
        }

    .fp-date-in {
        flex: 1;
        padding: 5px 7px;
        border: 1px solid #e2e4e9;
        border-radius: 7px;
        font-size: 11px;
        font-family: 'DM Sans', sans-serif;
        color: #333;
        outline: none;
    }

        .fp-date-in:focus {
            border-color: var(--green);
        }

    .fp-type-grp {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .fp-type-pill {
        padding: 4px 10px;
        border: 1.5px solid #e2e4e9;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        color: #aaa;
        cursor: pointer;
        transition: all .14s;
        user-select: none;
    }

        .fp-type-pill.sel {
            border-color: var(--green);
            color: var(--green);
            background: rgba(75,181,67,.07);
        }

    .fp-footer2 {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
    }

    .fp-clear2 {
        background: none;
        border: none;
        font-size: 12px;
        font-weight: 600;
        color: #aaa;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        padding: 0;
    }

        .fp-clear2:hover {
            color: #333;
        }

    .fp-apply2 {
        padding: 6px 16px;
        background: var(--green);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
    }

</style>

<!-- ══ INTEGRATIONS SECTION ══════════════════════════════════════════ -->
<div class="integ-section">
    <div class="sec-title">SocialMediaPanel Integrations</div>
    <div class="sec-subtitle">Unify your workflow by connecting your social platforms. Select a platform to get started.</div>

    <div class="integ-strip">
        <!-- Social platforms as icon buttons — click opens connect modal -->
        <button class="integ-icon-btn" title="Facebook" onclick="toggleConnect(this);event.stopPropagation()" data-platform="facebook">
            <svg viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
        </button>
        <button class="integ-icon-btn" title="LinkedIn" onclick="toggleConnect(this);event.stopPropagation()" data-platform="linkedin">
