                        </div>
                    </div>
                }
            }
        </div>

        </div><!-- /.li-col (center) -->

        <div class="li-col">
            <div class="li-insight-card">
                <h4>This account's stats</h4>
                <div class="li-insight-row"><span>Total Posts</span><b>@posts.Count</b></div>
                <div class="li-insight-row"><span>Posted</span><b>@posts.Count(p => p.Status == "posted")</b></div>
                <div class="li-insight-row"><span>Failed</span><b>@posts.Count(p => p.Status == "failed")</b></div>
                <div class="li-insight-row"><span>Org Pages</span><b>@organizations.Count</b></div>
            </div>

            <div class="li-mini-notice @(hasOrgAccess ? "ready" : "")">
                <h4>@(hasOrgAccess ? "✅ Organization Pages" : "🔒 Organization Pages")</h4>
                <p>@(hasOrgAccess ? (organizations.Any() ? $"{organizations.Count} page(s) linked — see the list on the left." : "No pages found — you need to be an admin on a LinkedIn Page.") : "The r_organization_admin permission wasn't granted.")</p>
            </div>

            <div class="li-mini-notice @(hasLeadsAccess ? "ready" : "")">
                <h4>@(hasLeadsAccess ? "✅ Leads access is ready" : "🔒 Leads")</h4>
                <p>@(hasLeadsAccess ? $"{leads.Count} total lead(s) received." : "The r_marketing_leadgen_automation permission wasn't granted.")</p>
                <a href="/LinkedIn/Leads">Manage webhook & stored leads →</a>
            </div>

            <div class="li-mini-notice @(hasEventsAccess ? "ready" : "")">
                <h4>@(hasEventsAccess ? "✅ Events access is ready" : "🔒 Events")</h4>
                <p>@(hasEventsAccess ? "Create live-video, external, or in-person LinkedIn Events." : "The r_events / rw_events permissions weren't granted.")</p>
