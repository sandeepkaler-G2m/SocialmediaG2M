@model dynamic
@{
    string userName = Model.userName;
    string userEmail = Model.userEmail;
    string theme = Model.theme;
    string returnUrl = Model.returnUrl;
}
<div class="th-ud-head">
    <div class="th-ud-name">@userName</div>
    <div class="th-ud-email" title="@userEmail">@userEmail</div>
</div>
<a href="/Integrations/ConnectedAccounts" class="th-ud-item">
    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><circle cx="9" cy="7" r="4" /><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="16" y1="11" x2="22" y2="11" /></svg>
    Connected Accounts
</a>
<a href="/Account/AuditLog" class="th-ud-item">
    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
    Audit Log
</a>
<div class="th-ud-sep"></div>
<div class="th-ud-head" style="padding:10px 16px 4px;border:none;"><span class="th-ud-label">Appearance</span></div>
<a class="th-ud-item @(theme == "linkedin" ? "theme-current" : "")" href="/Account/SetTheme?theme=linkedin&returnUrl=@returnUrl">LinkedIn Style @(theme == "linkedin" ? "✓" : "")</a>
<a class="th-ud-item @(theme == "x-dark" ? "theme-current" : "")" href="/Account/SetTheme?theme=x-dark&returnUrl=@returnUrl">X Style (Dark) @(theme == "x-dark" ? "✓" : "")</a>
<a class="th-ud-item @(theme == "x-light" ? "theme-current" : "")" href="/Account/SetTheme?theme=x-light&returnUrl=@returnUrl">X Style (Light) @(theme == "x-light" ? "✓" : "")</a>
<div class="th-ud-sep"></div>
<a href="/Account/Logout" class="th-ud-item danger">
    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
    Logout
</a>
