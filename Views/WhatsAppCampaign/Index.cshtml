@using SocialMediaPanel.Models
@using SocialMediaPanel.Controllers
@model List<CampaignListRow>
@{
    ViewData["Title"] = "WhatsApp Campaigns";
    ViewData["PageTitle"] = "WhatsApp Campaigns";
    var success = TempData["WhatsAppCampaignSuccess"] as string;
    var error = TempData["WhatsAppCampaignError"] as string;
    var connected = ViewBag.Connected as bool? ?? false;
}

<style>
    .wac-page-wrap { max-width: 100%; }

    .wac-alert { padding: 12px 18px; border-radius: 10px; font-size: 13px; margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .wac-alert.success { background: rgba(37,211,102,.08); border: 1px solid rgba(37,211,102,.3); color: #1a8a45; }
    .wac-alert.error { background: #fff0f0; border: 1px solid #ffcdd2; color: #c62828; }
    .wac-alert button { background: none; border: none; cursor: pointer; color: inherit; font-size: 16px; }

    .wac-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
    .wac-toolbar-left { font-size: 13px; color: var(--muted); }
    .wac-toolbar-left strong { color: var(--text); font-family:'Sora',sans-serif; font-size: 16px; }
    .wac-toolbar-right { display: flex; gap: 10px; align-items: center; }
    .wac-search { padding: 8px 12px; border: 1.5px solid var(--border); border-radius: 9px; font-size: 12.5px; width: 220px; outline: none; }
    .wac-search:focus { border-color: #25D366; }
    .btn-wac-download { padding: 9px 16px; background: var(--surface, #fff); border: 1.5px solid var(--border); border-radius: 9px; font-size: 12.5px; font-weight: 600; color: var(--text); cursor: pointer; display: flex; align-items: center; gap: 6px; }
    .btn-wac-download:hover { border-color: #25D366; color: #128C7E; }
    .btn-wac-create { padding: 9px 18px; background: #25D366; border: none; border-radius: 9px; font-size: 12.5px; font-weight: 700; color: #fff; cursor: pointer; display: flex; align-items: center; gap: 7px; text-decoration: none; box-shadow: 0 4px 12px rgba(37,211,102,.28); }
    .btn-wac-create:hover { transform: translateY(-1px); }

    .wac-table-wrap { background: var(--surface, #fff); border: 1px solid var(--border); border-radius: 14px; overflow: auto; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
    .wac-table { border-collapse: collapse; font-size: 12px; table-layout: fixed; }
    .wac-table th { position: relative; text-align: left; padding: 11px 12px; background: #f6f8f7; color: #4a5a52; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; border-bottom: 1.5px solid var(--border); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; user-select: none; }
    .wac-table td { padding: 10px 12px; border-bottom: 1px solid #f4f5f7; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wac-table tbody tr:hover { background: #fafbfa; }
    .wac-resize-handle { position: absolute; top: 0; right: 0; width: 6px; height: 100%; cursor: col-resize; z-index: 2; }
    .wac-resize-handle:hover { background: rgba(37,211,102,.3); }

    .wac-delivered { color: #1a8a45; font-weight: 700; }
    .wac-undelivered { color: #c62828; font-weight: 700; }
    .wac-status-badge { font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 20px; text-transform: uppercase; letter-spacing: .3px; }
    .wac-status-badge.running { background: rgba(255,180,0,.14); color: #a06800; }
    .wac-status-badge.scheduled { background: rgba(29,155,240,.14); color: #106ba3; }
    .wac-status-badge.completed { background: rgba(37,211,102,.14); color: #1a8a45; }
    .wac-status-badge.pending { background: rgba(150,150,150,.14); color: #666; }
    .wac-type-tag { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 6px; background: #eef1ff; color: #4c5fd5; }

    .wac-empty { text-align: center; padding: 60px 20px; color: var(--muted); font-size: 13px; }
    .wac-view-recipients { font-size: 11.5px; color: #25D366; font-weight: 700; cursor: pointer; background: none; border: none; padding: 0; }

    .wac-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 999; align-items: center; justify-content: center; }
    .wac-modal-overlay.open { display: flex; }
    .wac-modal { background: var(--surface, #fff); border-radius: 14px; padding: 20px; width: 92%; max-width: 480px; max-height: 80vh; overflow-y: auto; }
    .wac-modal h4 { font-family:'Sora',sans-serif; margin: 0 0 12px; }
    .wac-recipient-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #f4f5f7; font-size: 12.5px; }
    .wac-recipient-status { font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 20px; }
    .wac-recipient-status.sent { background: rgba(37,211,102,.12); color: #1a8a45; }
    .wac-recipient-status.failed { background: #fff0f0; color: #c62828; }
    .wac-recipient-status.pending { background: rgba(150,150,150,.12); color: #666; }
    .wac-modal-close { float: right; background: none; border: none; cursor: pointer; font-size: 18px; color: var(--muted); }
</style>

<div class="wac-page-wrap">
    @await Html.PartialAsync("~/Views/WhatsApp/_SubNav.cshtml")

    @if (success != null)
    {
        <div class="wac-alert success"><span>✅ @success</span><button onclick="this.parentElement.remove()">✕</button></div>
    }
    @if (error != null)
    {
        <div class="wac-alert error"><span>⚠️ @error</span><button onclick="this.parentElement.remove()">✕</button></div>
    }

    <div class="wac-toolbar">
        <div class="wac-toolbar-left"><strong>Campaign List</strong> (@Model.Count total)</div>
        <div class="wac-toolbar-right">
            <input type="text" class="wac-search" id="wacSearchBox" placeholder="Search campaigns..." oninput="wacFilterTable()" />
            <button type="button" class="btn-wac-download" onclick="wacDownloadCsv()">⬇ Download</button>
            @if (connected)
            {
                <a href="/WhatsApp/Campaigns/Create" class="btn-wac-create">+ Create Campaign</a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="wac-table-wrap">
            <div class="wac-empty">
                No campaigns yet.
                <br />
                @if (connected)
                {
                    <a href="/WhatsApp/Campaigns/Create" style="color:#25D366;font-weight:700;text-decoration:none;">Create your first campaign →</a>
                }
                else
                {
                    <text>Connect WhatsApp first from the <a href="/WhatsApp/Index" style="color:#25D366;font-weight:700;">Dashboard</a>.</text>
                }
            </div>
        </div>
    }
    else
    {
        <div class="wac-table-wrap">
            <table class="wac-table" id="wacTable">
                <thead>
                    <tr>
                        <th style="width:160px;">Campaign Name<span class="wac-resize-handle"></span></th>
                        <th style="width:140px;">Template Name<span class="wac-resize-handle"></span></th>
                        <th style="width:110px;">Template Type<span class="wac-resize-handle"></span></th>
                        <th style="width:150px;">Phone Number<span class="wac-resize-handle"></span></th>
                        <th style="width:90px;">Delivered<span class="wac-resize-handle"></span></th>
                        <th style="width:100px;">Undelivered<span class="wac-resize-handle"></span></th>
                        <th style="width:90px;">Delivery %<span class="wac-resize-handle"></span></th>
                        <th style="width:90px;">Submitted<span class="wac-resize-handle"></span></th>
                        <th style="width:70px;">Type<span class="wac-resize-handle"></span></th>
                        <th style="width:150px;">Creation Date &amp; Time<span class="wac-resize-handle"></span></th>
                        <th style="width:150px;">Scheduled Date &amp; Time<span class="wac-resize-handle"></span></th>
                        <th style="width:150px;">Completion Date &amp; Time<span class="wac-resize-handle"></span></th>
                        <th style="width:100px;">Status<span class="wac-resize-handle"></span></th>
                        <th style="width:120px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        var c = row.Campaign;
                        var pct = c.TotalRecipients > 0 ? Math.Round(100.0 * row.Delivered / c.TotalRecipients, 1) : 0;
                        <tr>
                            <td title="@c.Name">@c.Name</td>
                            <td title="@c.TemplateName">@c.TemplateName</td>
                            <td>@if (!string.IsNullOrEmpty(c.TemplateType)) { <span class="wac-type-tag">@c.TemplateType</span> }</td>
                            <td>@c.PhoneNumberId</td>
                            <td class="wac-delivered">@row.Delivered</td>
                            <td class="wac-undelivered">@row.Undelivered</td>
                            <td>@pct%</td>
                            <td>@c.TotalRecipients</td>
                            <td>API</td>
                            <td>@c.CreatedAt.ToString("dd-MM-yy HH:mm:ss")</td>
                            <td>@(c.ScheduledAt?.ToString("dd-MM-yy HH:mm:ss") ?? "—")</td>
                            <td>@(c.CompletedAt?.ToString("dd-MM-yy HH:mm:ss") ?? "—")</td>
                            <td><span class="wac-status-badge @c.Status">@c.Status</span></td>
                            <td><button class="wac-view-recipients" onclick="wacViewRecipients(@c.Id)">View →</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="wac-modal-overlay" id="wacModal">
    <div class="wac-modal">
        <button class="wac-modal-close" onclick="document.getElementById('wacModal').classList.remove('open')">✕</button>
        <h4 id="wacModalTitle">Recipients</h4>
        <div id="wacModalBody">Loading…</div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        function esc(s) { return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

        // ── Excel-like column resizing ──
        (function initColumnResize() {
            var table = document.getElementById('wacTable');
            if (!table) return;
            table.querySelectorAll('.wac-resize-handle').forEach(function (handle) {
                handle.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    var th = handle.parentElement;
                    var startX = e.pageX;
                    var startWidth = th.offsetWidth;

                    function onMove(e2) {
                        var newWidth = Math.max(50, startWidth + (e2.pageX - startX));
                        th.style.width = newWidth + 'px';
                    }
                    function onUp() {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                    }
                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                });
            });
        })();

        function wacFilterTable() {
            var q = document.getElementById('wacSearchBox').value.toLowerCase();
            document.querySelectorAll('#wacTable tbody tr').forEach(function (tr) {
                tr.style.display = tr.textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
            });
        }

        function wacDownloadCsv() {
            var table = document.getElementById('wacTable');
            if (!table) return;
            var rows = [].slice.call(table.querySelectorAll('tr'));
            var csv = rows.map(function (tr) {
                return [].slice.call(tr.children).slice(0, -1).map(function (cell) {
                    return '"' + cell.textContent.trim().replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\n');

            var blob = new Blob([csv], { type: 'text/csv' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = 'whatsapp-campaigns.csv';
            document.body.appendChild(a); a.click(); document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function wacViewRecipients(id) {
            var modal = document.getElementById('wacModal');
            var body = document.getElementById('wacModalBody');
            body.innerHTML = 'Loading…';
            modal.classList.add('open');

            fetch('/WhatsApp/Campaigns/GetRecipients/' + id)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.success) { body.innerHTML = 'Could not load.'; return; }
                    document.getElementById('wacModalTitle').textContent = data.campaignName;
                    if (!data.recipients.length) { body.innerHTML = 'No recipients.'; return; }
                    body.innerHTML = data.recipients.map(function (r) {
                        var err = r.status === 'failed' && r.errorMessage ? '<div style="font-size:10.5px;color:#c62828;margin-top:2px;">' + esc(r.errorMessage) + '</div>' : '';
                        return '<div class="wac-recipient-row"><div><div>' + esc(r.phoneNumber) + '</div>' + err + '</div><span class="wac-recipient-status ' + r.status + '">' + r.status + '</span></div>';
                    }).join('');
                })
                .catch(function () { body.innerHTML = 'Could not load.'; });
        }

        (function initWacRealtime() {
            if (typeof signalR === 'undefined') return;
            var conn = new signalR.HubConnectionBuilder().withUrl('/hubs/inbox').withAutomaticReconnect().build();
            conn.on('waCampaignProgress', function (data) {
                // Only reload when a campaign actually finishes — reloading
                // on every single per-recipient tick (every ~400ms while a
                // campaign is running) would be jarring.
                if (data.completed && document.visibilityState === 'visible') location.reload();
            });
            conn.start().catch(function () {});
        })();
    </script>
}
