@{
    ViewData["Title"] = "Compose Post";
    var userName = ViewBag.UserName as string ?? "User";
    var companyName = ViewBag.CompanyName as string ?? "My Workspace";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "U";
    var compInitial = companyName.Length > 0 ? companyName[0].ToString().ToUpper() : "G";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"] — SocialMediaPanel</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --green: #4BB543;
            --green-d: #3a9e34;
            --blue: #1877F2;
            --ig: linear-gradient(135deg,#f09433,#dc2743,#bc1888);
            --li: #0A66C2;
            --bg: #f4f5f7;
            --card: #fff;
            --border: #e3e6ea;
            --text: #1a2332;
            --muted: #8a97a8;
            --teal: #1DA1A1;
        }

        body {
            font-family: 'DM Sans',sans-serif;
            background: var(--bg);
            color: var(--text);
            height: 100vh;
            display: flex;
            overflow: hidden;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: 220px;
            background: #fff;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            height: 100vh;
            flex-shrink: 0;
        }

        .sidebar-logo {
            padding: 22px 20px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg,var(--green),var(--teal));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .logo-icon svg {
                width: 18px;
                height: 18px;
                fill: white;
            }

        .logo-text {
            font-family: 'Sora',sans-serif;
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
        }

        .nav {
            flex: 1;
            padding: 8px 0;
            overflow-y: auto;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: color .15s,background .15s;
        }

            .nav-item svg {
                width: 16px;
                height: 16px;
                stroke: currentColor;
                flex-shrink: 0;
            }

            .nav-item:hover {
                color: var(--text);
                background: #f4f5f7;
            }

            .nav-item.active {
                color: var(--green);
                background: rgba(75,181,67,.07);
                border-left-color: var(--green);
            }

        .sidebar-bottom {
            padding: 14px 12px;
            border-top: 1px solid var(--border);
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            background: #f4f5f7;
            border-radius: 9px;
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg,var(--green),var(--teal));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: white;
            flex-shrink: 0;
        }

        .user-name {
            font-size: 12px;
            font-weight: 500;
            color: var(--text);
        }

        .logout-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            margin-top: 8px;
            background: rgba(220,53,69,.07);
            border: 1px solid rgba(220,53,69,.18);
            border-radius: 7px;
            color: #dc3545;
            font-size: 12px;
            font-weight: 500;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
            text-decoration: none;
            width: 100%;
            justify-content: center;
        }

            .logout-btn svg {
                width: 14px;
                height: 14px;
                stroke: currentColor;
            }

        /* ── MAIN ── */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .topbar {
            height: 52px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            flex-shrink: 0;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .topbar-left h1 {
                font-family: 'Sora',sans-serif;
                font-size: 15px;
                font-weight: 700;
                color: var(--text);
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-outline {
            padding: 7px 14px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text);
            font-size: 12px;
            font-weight: 500;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
        }

            .btn-outline:hover {
                background: #f4f5f7;
            }

        /* ── CONTENT ── */
        .content-area {
            flex: 1;
            display: flex;
            overflow: hidden;
        }

        /* ── COMPOSE PANEL ── */
        .compose-panel {
            width: 520px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-right: 1px solid var(--border);
            background: #fff;
            flex-shrink: 0;
        }

        .compose-scroll {
            flex: 1;
            overflow-y: auto;
        }

        /* NETWORK TABS */
        .network-bar {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
        }

        .network-bar-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 10px;
        }

        .network-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .net-tab {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all .15s;
            background: #fff;
            color: var(--muted);
            user-select: none;
        }

            .net-tab .net-icon {
                width: 18px;
                height: 18px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
                color: #fff;
                flex-shrink: 0;
            }

            .net-tab.fb .net-icon {
                background: var(--blue);
            }

            .net-tab.ig .net-icon {
                background: linear-gradient(135deg,#f09433,#dc2743,#bc1888);
            }

            .net-tab.li .net-icon {
                background: var(--li);
            }

            .net-tab.active.fb {
                border-color: var(--blue);
                background: rgba(24,119,242,.06);
                color: var(--blue);
            }

            .net-tab.active.ig {
                border-color: #E1306C;
                background: rgba(225,48,108,.06);
                color: #E1306C;
            }

            .net-tab.active.li {
                border-color: var(--li);
                background: rgba(10,102,194,.06);
                color: var(--li);
            }

            .net-tab svg {
                width: 12px;
                height: 12px;
            }

        .tick {
            display: none;
        }

        .net-tab.active .tick {
            display: block;
        }

        /* TEXT AREA */
        .compose-body {
            padding: 16px 20px 0;
        }

        .compose-textarea {
            width: 100%;
            min-height: 120px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 14px;
            font-family: 'DM Sans',sans-serif;
            color: var(--text);
            resize: vertical;
            outline: none;
            transition: border-color .2s;
            line-height: 1.6;
        }

            .compose-textarea:focus {
                border-color: #93c5fd;
            }

            .compose-textarea::placeholder {
                color: #c4cdd6;
            }

        .char-count {
            font-size: 12px;
            color: var(--muted);
            padding: 6px 20px 0;
            text-align: right;
        }

        /* MEDIA UPLOAD */
        .media-section {
            padding: 12px 20px;
        }

        .media-upload {
            border: 1.5px dashed #d0d7de;
            border-radius: 10px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: border-color .2s,background .2s;
        }

            .media-upload:hover {
                border-color: var(--green);
                background: rgba(75,181,67,.03);
            }

            .media-upload svg {
                width: 24px;
                height: 24px;
                stroke: #c4cdd6;
            }

            .media-upload span {
                font-size: 12px;
                color: var(--muted);
            }

            .media-upload strong {
                font-size: 12px;
                color: var(--green);
                font-weight: 600;
            }

        /* IMAGE STRIP */
        .img-strip {
            display: flex;
            gap: 8px;
            padding: 0 20px 12px;
            flex-wrap: wrap;
        }

        .img-thumb {
            position: relative;
            width: 72px;
            height: 72px;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }

            .img-thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .img-thumb .remove-img {
                position: absolute;
                top: 3px;
                right: 3px;
                width: 18px;
                height: 18px;
                background: rgba(0,0,0,.6);
                border: none;
                border-radius: 50%;
                color: #fff;
                font-size: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .img-add-btn {
            width: 72px;
            height: 72px;
            border-radius: 8px;
            border: 1.5px dashed #d0d7de;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--muted);
            font-size: 22px;
            transition: border-color .15s;
        }

            .img-add-btn:hover {
                border-color: var(--green);
                color: var(--green);
            }

        /* PUBLISHING OPTIONS */
        .pub-options {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
        }

        .pub-options-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 10px;
        }

        .pub-option {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 12px;
            border: 1.5px solid var(--border);
            border-radius: 9px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: border-color .15s;
        }

            .pub-option:hover {
                border-color: var(--green);
            }

            .pub-option.selected {
                border-color: var(--blue);
                background: rgba(24,119,242,.04);
            }

            .pub-option input[type=radio] {
                margin-top: 2px;
                accent-color: var(--blue);
                flex-shrink: 0;
            }

        .pub-option-text {
            flex: 1;
        }

        .pub-option-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
        }

        .pub-option-sub {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

        .schedule-inputs {
            display: none;
            margin-top: 10px;
            display: none;
            gap: 8px;
        }

            .schedule-inputs.open {
                display: flex;
            }

            .schedule-inputs input, .schedule-inputs select {
                padding: 8px 10px;
                border: 1.5px solid var(--border);
                border-radius: 8px;
                font-size: 12px;
                font-family: 'DM Sans',sans-serif;
                color: var(--text);
                outline: none;
                background: #fff;
            }

                .schedule-inputs input:focus, .schedule-inputs select:focus {
                    border-color: #93c5fd;
                }

        /* CAMPAIGN */
        .campaign-section {
            padding: 0 20px 14px;
        }

        .campaign-section-label {
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 8px;
        }

        .campaign-input {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            font-family: 'DM Sans',sans-serif;
            color: var(--text);
            outline: none;
        }

            .campaign-input:focus {
                border-color: #93c5fd;
            }

        /* PUBLISH BUTTON AREA */
        .compose-footer {
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: #fff;
            flex-shrink: 0;
        }

        .publish-btn {
            width: 100%;
            padding: 12px;
            background: var(--blue);
            border: none;
            border-radius: 9px;
            color: #fff;
            font-size: 14px;
            font-weight: 700;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
            transition: opacity .15s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .publish-btn:hover {
                opacity: .88;
            }

            .publish-btn:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

            .publish-btn svg {
                width: 16px;
                height: 16px;
                stroke: #fff;
                fill: none;
            }

        .save-draft-btn {
            width: 100%;
            margin-top: 8px;
            padding: 9px;
            background: #fff;
            border: 1.5px solid var(--border);
            border-radius: 9px;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            font-family: 'DM Sans',sans-serif;
            cursor: pointer;
        }

            .save-draft-btn:hover {
                background: #f4f5f7;
            }

        /* ── PREVIEW PANEL ── */
        .preview-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: #f4f5f7;
        }

        @@media (max-width: 900px) {
            body { height: auto; overflow: auto; }
            .content-area { flex-direction: column; overflow: visible; }
            .compose-panel { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
            .preview-panel { min-height: 320px; }
        }

        .preview-tab-bar {
            display: flex;
            border-bottom: 1px solid var(--border);
            background: #fff;
        }

        .preview-tab-item {
            padding: 14px 24px;
            font-size: 13px;
            font-weight: 500;
            color: var(--muted);
            cursor: pointer;
            border-bottom: 2px solid transparent;
        }

            .preview-tab-item.active {
                color: var(--blue);
                border-bottom-color: var(--blue);
                font-weight: 600;
            }

        .preview-content {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        /* PREVIEW CARD */
        .preview-card {
            background: #fff;
            border-radius: 12px;
            border: 1px solid var(--border);
            width: 100%;
            max-width: 440px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.07);
        }

        .preview-card-header {
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-bottom: 1px solid var(--border);
        }

        .preview-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: white;
            flex-shrink: 0;
        }

        .preview-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
        }

        .preview-meta {
            font-size: 11px;
            color: var(--muted);
        }

        .preview-platform-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: 6px;
        }

        .preview-body {
            padding: 12px 14px;
        }

        .preview-text {
            font-size: 13px;
            color: var(--text);
            line-height: 1.6;
            min-height: 30px;
            word-break: break-word;
            white-space: pre-wrap;
        }

        .preview-placeholder {
            color: #c4cdd6;
            font-size: 13px;
            font-style: italic;
        }

        .preview-images {
            display: flex;
            gap: 4px;
            padding: 0 14px 12px;
            flex-wrap: wrap;
        }

            .preview-images img {
                height: 140px;
                border-radius: 8px;
                object-fit: cover;
                flex: 1;
                min-width: 120px;
                max-width: 200px;
            }

        .preview-no-img {
            height: 80px;
            background: #f4f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 14px 12px;
            border-radius: 8px;
        }

            .preview-no-img svg {
                width: 32px;
                height: 32px;
                stroke: #d0d7de;
            }

        .preview-actions {
            padding: 10px 14px;
            display: flex;
            gap: 16px;
            border-top: 1px solid var(--border);
        }

        .preview-action {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: var(--muted);
            cursor: pointer;
        }

            .preview-action svg {
                width: 15px;
                height: 15px;
                stroke: currentColor;
            }

        /* TOAST */
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .toast {
            min-width: 260px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            font-family: 'DM Sans',sans-serif;
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
            animation: slideIn .3s ease;
        }

        .toast-success {
            background: #28a745;
        }

        .toast-error {
            background: #dc3545;
        }

        .toast-info {
            background: #1877F2;
        }

        @@keyframes slideIn {
            from {
                transform: translateX(100px);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* PROGRESS */
        .progress-bar-wrap {
            width: 100%;
            height: 4px;
            background: #e3e6ea;
            border-radius: 2px;
            margin-top: 8px;
            display: none;
        }

        .progress-bar-fill {
            height: 100%;
            background: var(--green);
            border-radius: 2px;
            width: 0%;
            transition: width .3s;
        }

        ::-webkit-scrollbar {
            width: 5px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #d0d7de;
            border-radius: 3px;
        }
    </style>
</head>
<body>


    <!-- MAIN -->
    <main class="main">
        <div class="topbar">
            <div class="topbar-left">
                <h1>New Post</h1>
            </div>
            <div class="topbar-right">
                @await Html.PartialAsync("_PageSwitcher")
                <button class="btn-outline" onclick="window.location.href='/Dashboard/Compose'">
                    ✕ Discard
                </button>
            </div>
        </div>

        <div class="content-area">

            <!-- ══ LEFT COMPOSE PANEL ══ -->
            <div class="compose-panel">
                <div class="compose-scroll">

                    <!-- NETWORK SELECTION -->
                    <div class="network-bar">
                        <div class="network-bar-label">Post to networks</div>
                        <div class="network-tabs">
                            <div class="net-tab fb active" onclick="toggleNet(this,'fb')" id="tab-fb">
                                <span class="net-icon">f</span>
                                Facebook
                                <svg class="tick" viewBox="0 0 24 24" fill="none" stroke="#1877F2" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                            </div>
                            <div class="net-tab ig" onclick="toggleNet(this,'ig')" id="tab-ig">
                                <span class="net-icon">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="white" stroke="none" /></svg>
                                </span>
                                Instagram
                                <svg class="tick" viewBox="0 0 24 24" fill="none" stroke="#E1306C" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                            </div>
                            <div class="net-tab li" onclick="toggleNet(this,'li')" id="tab-li">
                                <span class="net-icon">in</span>
                                LinkedIn
                                <svg class="tick" viewBox="0 0 24 24" fill="none" stroke="#0A66C2" stroke-width="2.5" stroke-linecap="round"><polyline points="20 6 9 17 4 12" /></svg>
                            </div>
                        </div>
                    </div>

                    <!-- TEXT -->
                    <div class="compose-body">
                        <textarea class="compose-textarea" id="postText" placeholder="Start writing your post..." oninput="onTextInput()" maxlength="5000"></textarea>
                    </div>
                    <div class="char-count"><span id="charCount">0</span> / 5000</div>

                    <!-- MEDIA -->
                    <div class="media-section">
                        <div class="media-upload" onclick="document.getElementById('mediaInput').click()">
                            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>
                            <span>Drag &amp; drop or <strong>browse files</strong></span>
                            <span style="font-size:11px;color:#c4cdd6">JPG, PNG, GIF (multiple images supported)</span>
                            <input type="file" id="mediaInput" style="display:none" accept="image/*" multiple onchange="handleMedia(this)" />
                        </div>
                    </div>

                    <!-- IMAGE STRIP -->
                    <div class="img-strip" id="imgStrip"></div>

                    <!-- CAMPAIGN -->
                    <div class="campaign-section">
                        <div class="campaign-section-label">Campaign (optional)</div>
                        <input type="text" class="campaign-input" id="campaignInput" placeholder="⊕ Add a campaign name" />
                        <a href="/Media/Index" target="_blank" style="display:inline-block;margin-top:8px;font-size:12px;color:var(--green);text-decoration:none;font-weight:600">🖼️ Browse Media Library (previously uploaded images)</a>
                    </div>

                    <!-- PUBLISHING OPTIONS -->
                    <div class="pub-options">
                        <div class="pub-options-label">Publishing Options</div>

                        <div class="pub-option selected" onclick="selectPubOption(this,'now')">
                            <input type="radio" name="pubOpt" value="now" checked />
                            <div class="pub-option-text">
                                <div class="pub-option-title">Publish Now</div>
                                <div class="pub-option-sub">Post immediately to selected networks</div>
                            </div>
                        </div>

                        <div class="pub-option" onclick="selectPubOption(this,'schedule')">
                            <input type="radio" name="pubOpt" value="schedule" />
                            <div class="pub-option-text">
                                <div class="pub-option-title">Schedule for a Specific Date</div>
                                <div class="pub-option-sub">Choose date and time to publish</div>
                                <div class="schedule-inputs" id="scheduleInputs">
                                    <input type="date" id="schedDate" style="flex:1" />
                                    <select id="schedTime">
                                        <option>09:00 AM</option>
                                        <option>10:00 AM</option>
                                        <option>11:00 AM</option>
                                        <option>12:00 PM</option>
                                        <option>01:00 PM</option>
                                        <option>02:00 PM</option>
                                        <option>03:00 PM</option>
                                        <option>04:00 PM</option>
                                        <option>05:00 PM</option>
                                        <option>06:00 PM</option>
                                        <option>07:00 PM</option>
                                        <option>08:00 PM</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="pub-option" onclick="selectPubOption(this,'draft')">
                            <input type="radio" name="pubOpt" value="draft" />
                            <div class="pub-option-text">
                                <div class="pub-option-title">Save as Draft</div>
                                <div class="pub-option-sub">Save without publishing</div>
                            </div>
                        </div>

                    </div>

                </div><!-- /compose-scroll -->
                <!-- FOOTER — PUBLISH BUTTON -->
                <div class="compose-footer">
                    <div class="progress-bar-wrap" id="progressWrap">
                        <div class="progress-bar-fill" id="progressFill"></div>
                    </div>
                    <button class="publish-btn" id="publishBtn" onclick="handlePublish()">
                        <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                        <span id="publishBtnText">Publish Now</span>
                    </button>
                </div>
            </div><!-- /compose-panel -->
            <!-- ══ RIGHT PREVIEW PANEL ══ -->
            <div class="preview-panel">
                <div class="preview-tab-bar">
                    <div class="preview-tab-item active">Network Preview</div>
                </div>
                <div class="preview-content" id="previewContent">
                    <!-- Preview cards injected by JS -->
                </div>
            </div>

        </div><!-- /content-area -->
    </main>

    <div id="toast-container"></div>

    <script>
        // ── State ─────────────────────────────────────────────────────────────
        var activeNets   = new Set(['fb']);
        var selectedFiles = [];      // File objects
        var previewURLs  = [];       // Object URLs

        // ── Network toggle ────────────────────────────────────────────────────
        function toggleNet(tab, net) {
          if (activeNets.has(net)) {
            if (activeNets.size === 1) return; // at least 1
            activeNets.delete(net);
            tab.classList.remove('active');
          } else {
            activeNets.add(net);
            tab.classList.add('active');
          }
          renderPreview();
          updatePublishBtn();
        }

        // ── Text input ────────────────────────────────────────────────────────
        function onTextInput() {
          var t = document.getElementById('postText').value;
          document.getElementById('charCount').textContent = t.length;
          renderPreviewText();
        }

        // ── Media handling ────────────────────────────────────────────────────
        function handleMedia(input) {
          Array.from(input.files).forEach(function(file) {
            selectedFiles.push(file);
            var url = URL.createObjectURL(file);
            previewURLs.push(url);
          });
          input.value = ''; // reset so same file can be added again
          renderStrip();
          renderPreview();
        }

        function removeImage(idx) {
          URL.revokeObjectURL(previewURLs[idx]);
          selectedFiles.splice(idx, 1);
          previewURLs.splice(idx, 1);
          renderStrip();
          renderPreview();
        }

        function renderStrip() {
          var strip = document.getElementById('imgStrip');
          strip.innerHTML = '';
          previewURLs.forEach(function(url, i) {
            var div = document.createElement('div');
            div.className = 'img-thumb';
            div.innerHTML = '<img src="' + url + '" alt="img"/>'
              + '<button class="remove-img" onclick="removeImage(' + i + ')">✕</button>';
            strip.appendChild(div);
          });
          if (previewURLs.length < 10) {
            var add = document.createElement('div');
            add.className = 'img-add-btn';
            add.title = 'Add more images';
            add.innerHTML = '+';
            add.onclick = function() { document.getElementById('mediaInput').click(); };
            strip.appendChild(add);
          }
        }

        // ── Publishing option ─────────────────────────────────────────────────
        function selectPubOption(el, val) {
          document.querySelectorAll('.pub-option').forEach(function(o){ o.classList.remove('selected'); });
          el.classList.add('selected');
          el.querySelector('input[type=radio]').checked = true;

          // schedule inputs
          var si = document.getElementById('scheduleInputs');
          si.classList.toggle('open', val === 'schedule');

          // button text
          var btn = document.getElementById('publishBtnText');
          if (val === 'now')       btn.textContent = 'Publish Now';
          else if (val === 'schedule') btn.textContent = 'Schedule Post';
          else                     btn.textContent = 'Save Draft';
        }

        function getPubOption() {
          var checked = document.querySelector('input[name=pubOpt]:checked');
          return checked ? checked.value : 'now';
        }

        // ── PUBLISH ───────────────────────────────────────────────────────────
        async function handlePublish() {
          var text = document.getElementById('postText').value.trim();
          if (!text && selectedFiles.length === 0) {
            showToast('Add text or image before publishing', 'error'); return;
          }
          if (activeNets.size === 0) {
            showToast('Select at least one network', 'error'); return;
          }

          var opt = getPubOption();

          // if (opt === 'draft') {
          //   showToast('Saved as draft!', 'info'); return;
          // }
                  if (opt === 'draft') {

          var fd = new FormData();
          fd.append('message', text);
          fd.append('platform', Array.from(activeNets)[0]); // first selected
          fd.append('campaign', document.getElementById('campaignInput').value);
          fd.append('isDraft', true); // 👈 IMPORTANT

          selectedFiles.forEach(function(f) {
            fd.append('images', f);
          });

          var resp = await fetch('/Dashboard/PublishPost', {
            method: 'POST',
            body: fd
          });

          var data = await resp.json();

          showToast('Saved as draft!', 'success');

          setTimeout(() => {
        window.location.href = '/Posts/index?platform=facebook&tab=draft';
                  }, 1000);

          return;
        }

          if (opt === 'schedule') {
            var d = document.getElementById('schedDate').value;
            var t = document.getElementById('schedTime').value;
            if (!d) { showToast('Select a date to schedule', 'error'); return; }

            var scheduledIso = parseScheduleDateTime(d, t);
            if (!scheduledIso) { showToast('Invalid date/time', 'error'); return; }

            setLoading(true);
            var nets = Array.from(activeNets);
            var schedResults = [];

            for (var si = 0; si < nets.length; si++) {
              try {
                var sfd = new FormData();
                sfd.append('message', text);
                sfd.append('platform', nets[si]);
                sfd.append('campaign', document.getElementById('campaignInput').value);
                sfd.append('scheduledAt', scheduledIso);
                selectedFiles.forEach(function (f) { sfd.append('images', f); });

                var sresp = await fetch('/Dashboard/PublishPost', { method: 'POST', body: sfd, credentials: 'same-origin' });
                var sdata = await sresp.json();
                schedResults.push({ net: nets[si], ok: sdata.success, msg: sdata.message });
              } catch (e) {
                schedResults.push({ net: nets[si], ok: false, msg: 'Network error' });
              }
            }
            setLoading(false);

            var sok = schedResults.filter(function (r) { return r.ok; });
            var serr = schedResults.filter(function (r) { return !r.ok; });
            if (sok.length > 0) showToast('Scheduled for ' + d + ' ' + t + ' — ' + sok.map(function (r) { return r.net.toUpperCase(); }).join(', '), 'success');
            if (serr.length > 0) showToast('Failed to schedule: ' + serr.map(function (r) { return r.net.toUpperCase() + ' — ' + r.msg; }).join(', '), 'error');
            return;
          }

          // PUBLISH NOW
          setLoading(true);
          var nets = Array.from(activeNets);
          var results = [];

          for (var i = 0; i < nets.length; i++) {
            var net = nets[i];
            var pct = Math.round((i / nets.length) * 80);
            setProgress(pct);

            try {
              var fd = new FormData();
              fd.append('message', text);
              fd.append('platform', net);
              fd.append('campaign', document.getElementById('campaignInput').value);

              selectedFiles.forEach(function(f, fi) {
                fd.append('images', f);
              });

              var resp = await fetch('/Dashboard/PublishPost', {
                method: 'POST',
                body: fd,
                credentials: 'same-origin'
              });
              var data = await resp.json();

              results.push({ net: net, ok: data.success, msg: data.message });
            } catch(e) {
              results.push({ net: net, ok: false, msg: 'Network error' });
            }
          }

          setProgress(100);
          setTimeout(function() { setLoading(false); setProgress(0); }, 600);

          var ok  = results.filter(function(r){ return r.ok;  });
          var err = results.filter(function(r){ return !r.ok; });

          if (ok.length > 0)  showToast('Posted to: ' + ok.map(function(r){ return r.net.toUpperCase(); }).join(', '), 'success');
          if (err.length > 0) showToast('Failed: '   + err.map(function(r){ return r.net.toUpperCase() + ' — ' + r.msg; }).join(', '), 'error');

          if (ok.length > 0) {
            setTimeout(function(){ window.location.href = '/Posts/index'; }, 1500);
          }
        }

        // Combines the date input + "HH:MM AM/PM" select into an ISO UTC
        // string, treating the picked values as the user's local time — this
        // was previously never wired up at all (see handlePublish's old
        // 'schedule' branch, which just showed a fake toast and returned).
        function parseScheduleDateTime(dateStr, timeStr) {
          var m = /^(\d{1,2}):(\d{2})\s*(AM|PM)$/i.exec((timeStr || '').trim());
          if (!m || !dateStr) return null;

          var hours = parseInt(m[1], 10) % 12;
          if (m[3].toUpperCase() === 'PM') hours += 12;
          var minutes = parseInt(m[2], 10);

          var parts = dateStr.split('-'); // yyyy-mm-dd from <input type="date">
          var local = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10), hours, minutes, 0);
          if (isNaN(local.getTime())) return null;

          return local.toISOString();
        }

        function setLoading(on) {
          var btn = document.getElementById('publishBtn');
          btn.disabled = on;
          if (on) {
            document.getElementById('progressWrap').style.display = 'block';
            document.getElementById('publishBtnText').textContent = 'Publishing...';
          } else {
            document.getElementById('progressWrap').style.display = 'none';
            document.getElementById('publishBtnText').textContent = 'Publish Now';
          }
        }

        function setProgress(pct) {
          document.getElementById('progressFill').style.width = pct + '%';
        }

        function updatePublishBtn() {
          var btn = document.getElementById('publishBtn');
          btn.disabled = activeNets.size === 0;
        }

        // ── PREVIEW ───────────────────────────────────────────────────────────
        var NET_CONFIG = {
          fb: { label: 'Facebook Page', meta: 'Facebook · Just now', avatarBg: 'linear-gradient(135deg,#1877F2,#42a5f5)', avatarText: 'f', badgeColor:'#1877F2', badgeLabel:'Facebook' },
          ig: { label: '@companyName', meta: 'Instagram · Just now',  avatarBg: 'linear-gradient(135deg,#f09433,#dc2743,#bc1888)', avatarText: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/></svg>', badgeColor:'#E1306C', badgeLabel:'Instagram' },
          li: { label: '@companyName', meta: 'LinkedIn · Just now',  avatarBg: '#0A66C2', avatarText: 'in', badgeColor:'#0A66C2', badgeLabel:'LinkedIn' }
        };
        NET_CONFIG.fb.label  = '@companyName';
        NET_CONFIG.ig.label  = '@companyName';
        NET_CONFIG.li.label  = '@companyName';

        function renderPreview() {
          renderPreviewText();
        }

        function renderPreviewText() {
          var text = document.getElementById('postText').value;
          var html = '';

          activeNets.forEach(function(net) {
            var c = NET_CONFIG[net];
            var imgHtml = '';
            if (previewURLs.length > 0) {
              imgHtml = '<div class="preview-images">';
              previewURLs.slice(0,4).forEach(function(url) {
                imgHtml += '<img src="' + url + '" alt=""/>';
              });
              imgHtml += '</div>';
            } else {
              imgHtml = '<div class="preview-no-img"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
            }

            var previewText = text
              ? text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>')
              : '<span class="preview-placeholder">Start typing to see preview...</span>';

            var actions = '';
            if (net === 'fb') {
              actions = '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/><path d="M7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>Like</span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Comment</span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>Share</span>';
            } else if (net === 'ig') {
              actions = '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></span>';
            } else {
              actions = '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3H14z"/></svg>Like</span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Comment</span>'
                     + '<span class="preview-action"><svg viewBox="0 0 24 24" stroke-width="1.8"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>Repost</span>';
            }

            html += '<div class="preview-card">'
                  + '<div class="preview-card-header">'
                  + '<div class="preview-avatar" style="background:' + c.avatarBg + '">' + c.avatarText + '</div>'
                  + '<div><div class="preview-name">' + c.label + ' <span class="preview-platform-badge" style="background:' + c.badgeColor + ';color:#fff">' + c.badgeLabel + '</span></div>'
                  + '<div class="preview-meta">' + c.meta + '</div></div>'
                  + '</div>'
                  + '<div class="preview-body"><div class="preview-text">' + previewText + '</div></div>'
                  + imgHtml
                  + '<div class="preview-actions">' + actions + '</div>'
                  + '</div>';
          });

          if (!html) {
            html = '<div style="color:var(--muted);font-size:13px;text-align:center;padding:40px">Select a network to see preview</div>';
          }

          document.getElementById('previewContent').innerHTML = html;
        }

        // ── TOAST ─────────────────────────────────────────────────────────────
        function showToast(msg, type) {
          var c = document.getElementById('toast-container');
          var t = document.createElement('div');
          t.className = 'toast toast-' + (type || 'info');
          t.textContent = msg;
          c.appendChild(t);
          setTimeout(function(){ t.remove(); }, 4000);
        }

        // ── Draft prefill — URL se draftId uthao → DB se data lo ──────────
        (async function loadDraftIfAny() {
            var params  = new URLSearchParams(window.location.search);
            var draftId = params.get('draftId');
            if (!draftId) return;

            try {
                var resp = await fetch('/Posts/GetDraft?draftId=' + encodeURIComponent(draftId), {
                    credentials: 'same-origin'
                });
                if (!resp.ok) return;
                var draft = await resp.json();

                // Text prefill
                if (draft.message) {
                    document.getElementById('postText').value = draft.message;
                    document.getElementById('charCount').textContent = draft.message.length;
                }

                // Platform prefill
                if (draft.platform) {
                    var net  = draft.platform.toLowerCase();  // 'facebook' → 'fb', 'instagram' → 'ig'
                    var map  = { facebook: 'fb', instagram: 'ig', linkedin: 'li' };
                    var code = map[net] || net;
                    var tab  = document.getElementById('tab-' + code);
                    if (tab && !tab.classList.contains('active')) {
                        activeNets.clear();
                        activeNets.add(code);
                        document.querySelectorAll('.net-tab').forEach(function(t){ t.classList.remove('active'); });
                        tab.classList.add('active');
                    }
                }

                renderPreview();
            } catch(e) {
                console.log('Draft load error:', e);
            }
        })();

        // ── INIT ──────────────────────────────────────────────────────────────
        renderPreview();
    </script>
</body>
</html>