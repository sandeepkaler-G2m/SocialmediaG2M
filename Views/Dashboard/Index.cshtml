@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Welcome, " + (ViewBag.UserName as string ?? "User") + "! 👋";

    var integrationSuccess = TempData["IntegrationSuccess"] as string;
    var integrationError = TempData["IntegrationError"] as string;
    var fbPageName = TempData["FacebookPageName"] as string;
}

@if (integrationError != null)
{
    <div id="intErrBanner" style="background:#fff0f0;border:1px solid #ffcdd2;border-radius:10px;
             padding:12px 18px;margin-bottom:16px;font-size:13px;color:#c62828;
             display:flex;align-items:center;justify-content:space-between;gap:12px;">
        <span>❌ @integrationError</span>
        <button onclick="this.parentElement.remove()"
                style="background:none;border:none;cursor:pointer;color:#c62828;font-size:16px;">
            ✕
        </button>
    </div>
}

@if (integrationSuccess != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                if (window.PlatformAuth) {
                    PlatformAuth.openSuccess('@integrationSuccess', '@Html.Raw(fbPageName ?? integrationSuccess)');
                }
            }, 400);
        });
    </script>
}

<style>
    /* ── Dashboard two-column layout ─── */
    .db-grid {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 18px;
        align-items: start;
    }

    /* ── Left column ─── */
    .db-left {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Publishing card */
    .pub-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .pub-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 18px 14px;
        border-bottom: 1px solid var(--border);
    }

        .pub-card-header h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

        .pub-card-header a {
            font-size: 12px;
            color: var(--green);
            font-weight: 600;
            text-decoration: none;
        }

            .pub-card-header a:hover {
                text-decoration: underline;
            }

    /* Empty publish state */
    .pub-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 32px 24px;
        text-align: center;
    }

    .pub-empty-icon {
        width: 56px;
        height: 56px;
        margin-bottom: 14px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pub-empty-icon .icon-bg {
            width: 44px;
            height: 44px;
            background: #f0f0f0;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .pub-empty-icon .icon-badge {
            position: absolute;
            top: 0;
            right: 0;
            width: 22px;
            height: 22px;
            background: var(--green);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #fff;
        }

            .pub-empty-icon .icon-badge svg {
                width: 10px;
                height: 10px;
                stroke: white;
                fill: none;
            }

    .pub-empty h4 {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 8px;
    }

    .pub-empty p {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.6;
        margin-bottom: 18px;
    }

    .compose-btn {
        padding: 9px 20px;
        background: var(--text);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
        transition: background .15s;
    }

        .compose-btn:hover {
            background: #2d3a4a;
        }

    /* Scheduled post items */
    .pub-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 18px;
        border-bottom: 1px solid var(--border);
    }

        .pub-item:last-child {
            border-bottom: none;
        }

    .pub-plat {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
    }

    .pub-info {
        flex: 1;
        min-width: 0;
    }

        .pub-info p {
            font-size: 12px;
            color: var(--text);
            line-height: 1.4;
            margin-bottom: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pub-info span {
            font-size: 11px;
            color: var(--muted);
        }

    .pub-status {
        font-size: 10px;
        padding: 3px 8px;
        border-radius: 4px;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
        align-self: center;
    }

    .ps-sched {
        background: rgba(75,181,67,.10);
        color: var(--green);
    }

    .ps-draft {
        background: #f4f5f7;
        color: var(--muted);
        border: 1px solid var(--border);
    }

    /* To Do card */
    .todo-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .todo-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
    }

    .todo-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 18px;
        border-bottom: 1px solid var(--border);
    }

        .todo-item:last-child {
            border-bottom: none;
        }

    .todo-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .todo-icon {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .todo-icon svg {
            width: 14px;
            height: 14px;
            stroke: var(--muted);
            fill: none;
        }

    .todo-count {
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
        min-width: 28px;
    }

    .todo-link {
        font-size: 12px;
        color: var(--green);
        font-weight: 600;
        text-decoration: none;
    }

        .todo-link:hover {
            text-decoration: underline;
        }

    /* ── Right column ─── */
    .db-right {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .recent-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .recent-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px 14px;
        border-bottom: 1px solid var(--border);
    }

        .recent-header h3 {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
        }

    .sort-select {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 12px;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        cursor: pointer;
    }

        .sort-select svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    /* Empty recent posts state */
    .recent-empty {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
    }

    .recent-empty-left {
        border-right: 1px solid var(--border);
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 260px;
    }

    .post-preview-card {
        background: #f8f9fb;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        position: relative;
    }

    .post-preview-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #e0e0e0;
        margin-bottom: 10px;
    }

    .post-preview-line {
        height: 8px;
        border-radius: 4px;
        background: #e0e0e0;
        margin-bottom: 6px;
    }

        .post-preview-line.short {
            width: 60%;
        }

        .post-preview-line.medium {
            width: 80%;
        }

        .post-preview-line.tall {
            height: 60px;
            margin-bottom: 10px;
        }

    .post-preview-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 22px;
        height: 22px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
    }

    .post-preview-stats {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--muted);
    }

        .post-preview-stats svg {
            width: 12px;
            height: 12px;
            stroke: var(--muted);
            fill: none;
        }

    .recent-empty-right {
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .recent-empty-right h4 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .recent-empty-right p {
            font-size: 12px;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 0;
        }

        .recent-empty-right a {
            color: var(--green);
            font-weight: 600;
            text-decoration: none;
        }

            .recent-empty-right a:hover {
                text-decoration: underline;
            }

    /* Date range footer */
    .recent-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        border-top: 1px solid var(--border);
        background: #fafbfc;
    }

        .recent-footer span {
            font-size: 11px;
            color: var(--muted);
        }

    .report-btn {
        padding: 7px 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        color: var(--text);
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background .15s;
    }

        .report-btn:hover {
            background: #f4f5f7;
        }

    /* Real post items for recent posts */
    .recent-post-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
    }

        .recent-post-item:last-child {
            border-bottom: none;
        }

    .recent-post-thumb {
        width: 52px;
        height: 52px;
        border-radius: 8px;
        background: #f4f5f7;
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .recent-post-info {
        flex: 1;
        min-width: 0;
    }

        .recent-post-info p {
            font-size: 13px;
            color: var(--text);
            line-height: 1.4;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .recent-post-meta {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .recent-post-meta span {
            font-size: 11px;
            color: var(--muted);
        }

    .recent-post-stat {
        display: flex;
        align-items: center;
        gap: 3px;
        font-size: 11px;
        color: var(--muted);
    }

        .recent-post-stat svg {
            width: 11px;
            height: 11px;
            stroke: var(--muted);
            fill: none;
        }
</style>

<div class="db-grid">

    <!-- ═══ LEFT COLUMN ═══ -->
    <div class="db-left">

        <!-- Today's Publishing -->
        <div class="pub-card">
            <div class="pub-card-header">
                <h3>Today's Publishing</h3>
                <a href="#">View calendar →</a>
            </div>

            <!-- Empty state (show when no posts scheduled) -->
            <div class="pub-empty">
                <div class="pub-empty-icon">
                    <div class="icon-bg">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8a97a8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <line x1="16" y1="2" x2="16" y2="6" />
                            <line x1="8" y1="2" x2="8" y2="6" />
                            <line x1="3" y1="10" x2="21" y2="10" />
                        </svg>
                    </div>
                    <div class="icon-badge">
                        <svg viewBox="0 0 24 24" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    </div>
                </div>
                <h4>Publish your first post.</h4>
                <p>Publish, schedule or queue to reach<br>your audience at the perfect time.</p>
                <button class="compose-btn"
                        onclick="window.location.href='@Url.Action("Compose", "Dashboard")'">
                    Compose Post
                </button>
            </div>

            <!-- Uncomment below and remove pub-empty above when posts exist:
            <div class="pub-item">
                <div class="pub-plat">📸</div>
                <div class="pub-info"><p>New product launch — Q2 Campaign</p><span>Instagram · 2:30 PM</span></div>
                <span class="pub-status ps-sched">Scheduled</span>
            </div>
            <div class="pub-item">
                <div class="pub-plat">🐦</div>
                <div class="pub-info"><p>Weekly tips thread — Best Practices</p><span>Twitter · 5:00 PM</span></div>
                <span class="pub-status ps-draft">Draft</span>
            </div>
            <div class="pub-item">
                <div class="pub-plat">💼</div>
                <div class="pub-info"><p>Company culture spotlight</p><span>LinkedIn · 6:30 PM</span></div>
                <span class="pub-status ps-sched">Scheduled</span>
            </div>
            -->
        </div>

        <!-- To Do -->
        <div class="todo-card">
            <div class="todo-header">To Do</div>

            <div class="todo-item">
                <div class="todo-left">
                    <div class="todo-icon">
                        <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />
                        </svg>
                    </div>
                    <div class="todo-count">0</div>
                </div>
                <a class="todo-link" href="#">Go to Cases</a>
            </div>

            <div class="todo-item">
                <div class="todo-left">
                    <div class="todo-icon">
                        <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                    </div>
                    <div class="todo-count">0</div>
                </div>
                <a class="todo-link" href="#">Open Approvals</a>
            </div>

            <div class="todo-item">
                <div class="todo-left">
                    <div class="todo-icon">
                        <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                    </div>
                    <div class="todo-count">0</div>
                </div>
                <a class="todo-link" href="#">Open Inbox Tasks</a>
            </div>
        </div>

    </div><!-- /.db-left -->
    <!-- ═══ RIGHT COLUMN ═══ -->
    <div class="db-right">
        <div class="recent-card">
            <div class="recent-header">
                <h3>Your Recent Posts</h3>
                <select class="sort-select">
                    <option>Highest Performing</option>
                    <option>Most Recent</option>
                    <option>Most Engaged</option>
                </select>
            </div>

            <!-- Empty state (show when no posts yet) -->
            <div class="recent-empty">
                <div class="recent-empty-left">
                    <!-- Post preview card mockup -->
                    <div class="post-preview-card">
                        <div class="post-preview-badge">1</div>
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
                            <div class="post-preview-avatar"></div>
                            <div style="flex:1">
                                <div class="post-preview-line medium"></div>
                                <div class="post-preview-line short" style="margin-top:4px;height:6px;"></div>
                            </div>
                        </div>
                        <div class="post-preview-line tall" style="border-radius:8px;"></div>
                        <div class="post-preview-stats">
                            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                            100
                        </div>
                    </div>
                </div>

                <div class="recent-empty-right">
                    <h4>Easily compare your top performing posts once you have at least 3 posts per week.</h4>
                    <p>
                        Discover more ways to
                        <a href="#">level-up your content strategy</a>.
                    </p>
                </div>
            </div>

            <!-- Uncomment below and remove recent-empty above when posts exist:
            <div class="recent-post-item">
                <div class="recent-post-thumb">📸</div>
                <div class="recent-post-info">
                    <p>Behind-the-scenes product development reel</p>
                    <div class="recent-post-meta">
                        <span>2 days ago</span>
                        <div class="recent-post-stat">
                            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            1.2K
                        </div>
                        <div class="recent-post-stat">
                            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                            342
                        </div>
                    </div>
                </div>
            </div>
            -->

            <div class="recent-footer">
                <span>Published from @DateTime.Now.AddDays(-7).ToString("MM/dd/yy") - @DateTime.Now.ToString("MM/dd/yy")</span>
                <button class="report-btn">Post Performance Report</button>
            </div>
        </div>
    </div><!-- /.db-right -->

</div><!-- /.db-grid -->
