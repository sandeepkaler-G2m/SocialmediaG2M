@using SocialMediaPanel.Models
@model List<LinkedInIntegration>
@{
    ViewData["Title"] = "LinkedIn Settings";
    ViewData["PageTitle"] = "LinkedIn Settings";
}

<style>
    .li-page-wrap2 { max-width: 900px; margin: 0 auto; }
    .li-panel { background: #fff; border: 1px solid #e2e8e4; border-radius: 16px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,.04); margin-bottom: 20px; }
    .li-num-card { border: 1px solid #e2e8e4; border-radius: 14px; padding: 16px 18px; margin-bottom: 14px; }
    .li-num-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .li-num-name { font-size: 14.5px; font-weight: 700; color: #1a2620; font-family: 'Sora',sans-serif; }
    .li-num-actions { display: flex; gap: 8px; }
    .li-num-actions button { padding: 6px 12px; border-radius: 8px; font-size: 11.5px; font-weight: 600; cursor: pointer; font-family: 'DM Sans',sans-serif; }
    .btn-li-default { background: #fff; border: 1.5px solid #0a66c2; color: #0a66c2; }
    .btn-li-disconnect { background: #fff5f5; border: 1px solid #f5c2c2; color: #d33; }
    .li-default-badge { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 20px; background: rgba(10,102,194,.12); color: #0a66c2; margin-left: 8px; }
    .li-num-meta { font-size: 11.5px; color: #6b7d74; margin-top: 2px; }
</style>

<div class="li-page-wrap2">
    @await Html.PartialAsync("_SubNav")

    <div class="li-panel">
        <h3 style="font-family:'Sora',sans-serif;">Connected LinkedIn Accounts (@Model.Count)</h3>
        @if (!Model.Any())
        {
            <div style="color:#6b7d74;font-size:12.5px;">No accounts connected yet. <a href="/LinkedIn/Connect" style="color:#0a66c2;font-weight:700;">Connect one →</a></div>
        }
        else
        {
            @foreach (var i in Model)
            {
                <div class="li-num-card">
                    <div class="li-num-head">
                        <div class="li-num-name">@i.DisplayName @(i.IsDefault ? Html.Raw("<span class='li-default-badge'>Default</span>") : null)</div>
                        <div class="li-num-actions">
                            @if (!i.IsDefault)
                            {
                                <form asp-action="SetDefault" asp-controller="LinkedIn" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <button type="submit" class="btn-li-default">Set Default</button>
                                </form>
                            }
                            <form asp-action="Disconnect" asp-controller="LinkedIn" method="post" style="display:inline;" onsubmit="return confirm('Disconnect @i.DisplayName?');">
                                <input type="hidden" name="id" value="@i.Id" />
                                <button type="submit" class="btn-li-disconnect">Disconnect</button>
                            </form>
                        </div>
                    </div>
                    <div class="li-num-meta">@i.Email · granted: @i.GrantedScopes</div>
                    <div class="li-num-meta">Connected @i.ConnectedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                </div>
            }
        }
        <a href="/LinkedIn/Connect" style="display:inline-block;margin-top:10px;padding:10px 20px;background:#0a66c2;color:#fff;border-radius:9px;font-size:13px;font-weight:700;text-decoration:none;">+ Connect Another Account</a>
    </div>
</div>
