@{
    Layout = null;
    ViewData["Title"] = "Reset Password – Go2MarketSocialMediaPanel";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="https://go2market.in/assets/images/favicon.jpg" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --green: #4BB543; --green-d: #3a9e34; --teal: #1DA1A1;
            --dark: #f5f7fb; --card: #ffffff; --border: rgba(0,0,0,0.08);
            --text: #1f2d3d; --muted: #6b7c93; --accent: #2bbf9b;
        }
        body {
            font-family: 'DM Sans', sans-serif; background: var(--dark); color: var(--text);
            min-height: 100vh; display: flex; align-items: center; justify-content: center;
        }
        .card {
            width: 420px; background: var(--card); border: 1px solid var(--border);
            border-radius: 16px; padding: 40px 36px; box-shadow: 0 10px 40px rgba(0,0,0,0.06);
        }
        h2 { font-family: 'Sora', sans-serif; font-size: 24px; font-weight: 700; margin-bottom: 8px; }
        .sub { font-size: 13.5px; color: var(--muted); margin-bottom: 28px; }
        .form-group { margin-bottom: 18px; }
        label { display: block; font-size: 13px; font-weight: 500; color: #475569; margin-bottom: 8px; }
        .form-control {
            width: 100%; padding: 13px 14px; background: #fff; border: 1px solid var(--border);
            border-radius: 10px; color: var(--text); font-size: 14px; font-family: 'DM Sans', sans-serif; outline: none;
        }
        .form-control:focus { border-color: var(--green); background: #f0fff4; }
        .btn-submit {
            width: 100%; padding: 13px; background: linear-gradient(135deg, var(--green), var(--green-d));
            border: none; border-radius: 10px; color: #fff; font-size: 15px; font-weight: 600;
            font-family: 'DM Sans', sans-serif; cursor: pointer; box-shadow: 0 4px 20px rgba(75,181,67,0.3);
        }
        .alert-error {
            background: rgba(255,107,107,0.1); border: 1px solid rgba(255,107,107,0.3); border-radius: 8px;
            padding: 12px 16px; color: #c0392b; font-size: 13px; margin-bottom: 20px;
        }
        .alert-success {
            background: rgba(75,181,67,0.1); border: 1px solid rgba(75,181,67,0.3); border-radius: 8px;
            padding: 14px 16px; color: var(--green-d); font-size: 13.5px; margin-bottom: 20px;
        }
        .back { display: block; text-align: center; margin-top: 20px; font-size: 13px; color: var(--accent); text-decoration: none; }
        .back:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="card">
        @if (ViewBag.Success == true)
        {
            <h2>Password updated ✅</h2>
            <div class="alert-success">Your password has been changed. You can now sign in with your new password.</div>
            <a asp-action="Login" class="back">← Go to Sign In</a>
        }
        else
        {
            <h2>Reset password</h2>
            <div class="sub">Choose a new password for your account.</div>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">@ViewBag.Error</div>
            }

            @if (ViewBag.Token != null)
            {
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="token" value="@ViewBag.Token" />
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="password" class="form-control" placeholder="At least 6 characters" required minlength="6" />
                    </div>
                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input type="password" name="confirmPassword" class="form-control" placeholder="Re-enter password" required minlength="6" />
                    </div>
                    <button type="submit" class="btn-submit">Reset Password</button>
                </form>
            }
            else
            {
                <a asp-action="ForgotPassword" class="back">← Request a new reset link</a>
            }
        }
    </div>
</body>
</html>
